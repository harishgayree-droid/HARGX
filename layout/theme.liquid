<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    <style>
      /* ========================================
        HARGX — Theme Settings Variables
        ======================================== */

      :root {

        /* Typography */

        --font-primary--family:
          {{ settings.type_primary_font.family }};

        --font-primary--style:
          {{ settings.type_primary_font.style }};

        --font-primary--weight:
          {{ settings.type_primary_font.weight }};

        --font-heading--family:
          {{ settings.type_heading_font.family }};

        --font-heading--style:
          {{ settings.type_heading_font.style }};

        --font-heading--weight:
          {{ settings.type_heading_font.weight }};

        /* Layout */

        --page-width:
          {{ settings.max_page_width }};

        --page-margin:
          {{ settings.min_page_margin }}px;

        --page-margin-mobile:
          {{ settings.mobile_page_margin }}px;

        --section-spacing:
          {{ settings.section_spacing }}px;

        --grid-gap:
          {{ settings.grid_gap }}px;

        --border-radius:
          {{ settings.border_radius }}px;


        /* Colors */

        --color-primary:
          {{ settings.color_primary }};

        --color-black:
          {{ settings.color_black }};

        --color-white:
          {{ settings.color_white }};

        --color-warm-background:
          {{ settings.color_warm_background }};

        --color-text:
          {{ settings.color_text }};

        --color-muted-text:
          {{ settings.color_muted_text }};

        --color-border:
          {{ settings.color_border }};


        /* Shopify / HARGX aliases */

        --color-background:
          {{ settings.color_white }};

        --color-foreground:
          {{ settings.color_text }};


        /* Buttons */

        --button-radius:
          {{ settings.button_radius }}px;

        --button-vertical-padding:
          {{ settings.button_vertical_padding }}px;

        --button-horizontal-padding:
          {{ settings.button_horizontal_padding }}px;

      }
    </style>
    {% # Inlined CSS Variables %}
    {% render 'css-variables' %}

    {% comment %}
      Font preloading:
      1. Preconnect to font CDN for faster connection
      2. Preload only the critical font variant (base weight)
      3. Additional variants load on-demand via @font-face
    {% endcomment %}
    {% unless settings.type_primary_font.system? %}
      <link rel="preconnect" href="https://fonts.shopifycdn.com" crossorigin>

      {% comment %} Preload the base font variant for initial page render {% endcomment %}
      {{ settings.type_primary_font | font_url | preload_tag: as: 'font', crossorigin: 'anonymous' }}
    {% endunless %}

    {% # Load and preload the critical CSS %}
    {{ 'critical.css' | asset_url | stylesheet_tag: preload: true }}
    {{ 'hargx-product.css' | asset_url | stylesheet_tag }}
    {{ 'hargx-cart.css' | asset_url | stylesheet_tag }}
    {{ 'hargx-cart-drawer.css' | asset_url | stylesheet_tag }}

    {% # Social, title, etc. %}
    {% render 'meta-tags' %}

    {{ content_for_header }}

    <script
      src="{{ 'hargx-collection.js' | asset_url }}"
      defer="defer"
    ></script>
    <script
      src="{{ 'hargx-product.js' | asset_url }}"
      defer="defer"
    ></script>
    <script
      src="{{ 'hargx-recommended-products.js' | asset_url }}"
      defer="defer"
    ></script>
    <script
      src="{{ 'hargx-cart.js' | asset_url }}"
      defer="defer"
    ></script>

    <script
      src="{{ 'hargx-cart-drawer.js' | asset_url }}"
      defer
    ></script>
  </head>

  <body>
    {% sections 'header-group' %}

    {{ content_for_layout }}

    {% section 'cart-drawer' %}

    {% sections 'footer-group' %}
  </body>
</html>
