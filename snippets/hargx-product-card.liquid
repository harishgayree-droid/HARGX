<article class="hargx-product-card">
  {%- assign selected_variant = product.selected_or_first_available_variant -%}
  {%- assign variant_display = variant_display | default: 'name' -%}
  <script type="application/json" data-hargx-card-variants>[
    {%- for variant in product.variants -%}
      {
        "id": {{ variant.id | json }},
        "available": {{ variant.available | json }},
        "price": {{ variant.price | money | json }},
        "compare_at_price": {{ variant.compare_at_price | money | json }},
        "on_sale": {% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %},
        "options": [
          {{ variant.option1 | default: '' | json }},
          {{ variant.option2 | default: '' | json }},
          {{ variant.option3 | default: '' | json }}
        ]{%- if variant.featured_image != blank -%},
        "image": {{ variant.featured_image | image_url: width: 900 | json }}
        {%- endif -%}
      }{% unless forloop.last %},{% endunless %}
    {%- endfor -%}
  ]</script>

  <div class="hargx-product-card__media">
    <a
      href="{{ product.url }}"
      class="hargx-product-card__link"
      aria-label="{{ product.title | escape }}"
    >

      {%- comment -%}
        Product Badges
      {%- endcomment -%}

      {%- if product.available == false -%}

        <span class="hargx-product-card__badge hargx-product-card__badge--sold-out">
          Sold out
        </span>

      {%- elsif product.compare_at_price > product.price -%}

        <span class="hargx-product-card__badge hargx-product-card__badge--sale">
          Sale
        </span>

      {%- endif -%}


      {%- comment -%}
        Product Images
      {%- endcomment -%}

      {%- if product.featured_image != blank -%}

        {{
          product.featured_image
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 900',
            sizes: '(min-width: 990px) calc((100vw - 120px) / var(--hargx-desktop-columns)), 50vw',
            class: 'hargx-product-card__image hargx-product-card__image--primary',
            alt: product.featured_image.alt | default: product.title
        }}

      {%- else -%}

        {{ 'product-1' | placeholder_svg_tag: 'hargx-product-card__placeholder' }}

      {%- endif -%}


      {%- comment -%}
        Second Image / Hover Image
      {%- endcomment -%}

      {%- if product.images.size > 1 -%}

        {{
          product.images[1]
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 900',
            sizes: '(min-width: 990px) calc((100vw - 120px) / var(--hargx-desktop-columns)), 50vw',
            class: 'hargx-product-card__image hargx-product-card__image--secondary',
            alt: product.images[1].alt | default: product.title
        }}

      {%- endif -%}

    </a>

    {%- if show_add_to_cart -%}
      <form
        id="HargxQuickAdd-{{ section.id }}-{{ product.id }}"
        method="post"
        action="{{ routes.cart_add_url }}"
        class="hargx-product-card__quick-add-form"
        enctype="multipart/form-data"
        data-hargx-quick-add-form
      >
        <input
          type="hidden"
          name="id"
          value="{{ selected_variant.id }}"
          data-hargx-card-variant-id
        >

        <button
          type="submit"
          class="hargx-product-card__quick-add"
          aria-label="Add {{ product.title | escape }} to cart"
          {% unless product.available %}disabled{% endunless %}
        >
          <span>
            {%- if product.available -%}
              {{ add_to_cart_text | default: 'Add to cart' | escape }}
            {%- else -%}
              Sold out
            {%- endif -%}
          </span>
          <svg
            class="hargx-product-card__quick-add-arrow"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 8H13M8.5 3.5L13 8L8.5 12.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <svg
            class="hargx-product-card__quick-add-cart-icon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 1.9-1.4L22 8H6"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <circle cx="10" cy="20" r="1" fill="currentColor" />
            <circle cx="18" cy="20" r="1" fill="currentColor" />
          </svg>
        </button>
        <span
          class="hargx-product-card__quick-add-error"
          data-hargx-quick-add-error
          role="alert"
          hidden
        ></span>
      </form>
    {%- endif -%}
  </div>

  <div class="hargx-product-card__content">

    <h2 class="hargx-product-card__title">
      <a href="{{ product.url }}" class="hargx-product-card__link">
        {{ product.title | escape }}
      </a>
    </h2>


    <div class="hargx-product-card__price">

        {%- if selected_variant.compare_at_price > selected_variant.price -%}

          <span class="hargx-product-card__price-current" data-hargx-card-current-price>
            {{ selected_variant.price | money }}
          </span>

          <s class="hargx-product-card__price-compare" data-hargx-card-compare-price>
            {{ selected_variant.compare_at_price | money }}
          </s>

        {%- else -%}

          <span class="hargx-product-card__price-current" data-hargx-card-current-price>
            {{ selected_variant.price | money }}
          </span>
          <s class="hargx-product-card__price-compare" data-hargx-card-compare-price hidden></s>

        {%- endif -%}

    </div>

    {%- if variant_display != 'none' and product.variants.size > 1 -%}
      <fieldset class="hargx-product-card__variants hargx-product-card__variants--{{ variant_display }}">
        {%- for option in product.options_with_values -%}
          {%- assign option_index = forloop.index0 -%}
          <div
            class="hargx-product-card__option"
            data-hargx-card-option
          >
            <span class="hargx-product-card__variants-label">
              {{ option.name | escape }}
            </span>

            <div class="hargx-product-card__variant-swatches">
              {%- for option_value in option.values -%}
                {%- assign selected_option_value = blank -%}
                {%- case option_index -%}
                  {%- when 0 -%}
                    {%- assign selected_option_value = selected_variant.option1 -%}
                  {%- when 1 -%}
                    {%- assign selected_option_value = selected_variant.option2 -%}
                  {%- when 2 -%}
                    {%- assign selected_option_value = selected_variant.option3 -%}
                {%- endcase -%}

                {%- assign matching_variant = blank -%}
                {%- assign swatch_color = blank -%}
                {%- assign swatch_image = blank -%}
                {%- assign variant_option_image = blank -%}

                {%- for variant in product.variants -%}
                  {%- assign variant_option_value = blank -%}
                  {%- case option_index -%}
                    {%- when 0 -%}
                      {%- assign variant_option_value = variant.option1 -%}
                    {%- when 1 -%}
                      {%- assign variant_option_value = variant.option2 -%}
                    {%- when 2 -%}
                      {%- assign variant_option_value = variant.option3 -%}
                  {%- endcase -%}

                  {%- if variant_option_value == option_value -%}
                    {%- if matching_variant == blank -%}
                      {%- assign matching_variant = variant -%}
                    {%- endif -%}
                    {%- if variant.featured_image != blank and variant_option_image == blank -%}
                      {%- assign variant_option_image = variant.featured_image -%}
                    {%- endif -%}
                  {%- endif -%}
                {%- endfor -%}

                {%- if matching_variant == blank -%}
                  {%- assign matching_variant = selected_variant -%}
                {%- endif -%}

                {%- assign option_name_down = option.name | downcase | strip -%}
                {%- if option_name_down == 'color' or option_name_down == 'colour' -%}
                  {%- assign swatch_color = option_value.swatch.color -%}
                  {%- assign swatch_image = option_value.swatch.image -%}
                {%- endif -%}

                {%- if variant_option_image == blank -%}
                  {%- assign variant_option_image = swatch_image -%}
                {%- endif -%}
                {%- if variant_option_image == blank -%}
                  {%- assign variant_option_image = product.featured_image -%}
                {%- endif -%}

                <button
                  type="button"
                  class="hargx-product-card__variant-swatch"
                  data-hargx-card-variant
                  data-hargx-card-option-position="{{ option.position }}"
                  data-hargx-card-option-value="{{ option_value | escape }}"
                  data-variant-id="{{ matching_variant.id }}"
                  data-variant-price="{{ matching_variant.price | money | escape }}"
                  data-variant-compare-price="{{ matching_variant.compare_at_price | money | escape }}"
                  data-variant-on-sale="{% if matching_variant.compare_at_price > matching_variant.price %}true{% else %}false{% endif %}"
                  {% if variant_option_image != blank %}
                    data-variant-image="{{ variant_option_image | image_url: width: 900 | escape }}"
                  {% endif %}
                  aria-pressed="{% if selected_option_value == option_value %}true{% else %}false{% endif %}"
                  aria-label="{{ option.name | escape }}: {{ option_value | escape }}{% unless matching_variant.available %} - Sold out{% endunless %}"
                  {% if selected_option_value == option_value %}data-selected{% endif %}
                  {% unless matching_variant.available %}disabled{% endunless %}
                >
                  {%- if variant_display == 'color' -%}
                    <span
                      class="hargx-product-card__variant-swatch-color"
                      {% if swatch_color != blank %}
                        style="--hargx-swatch-color: {{ swatch_color | escape }};"
                      {% elsif swatch_image != blank %}
                        style="--hargx-swatch-image: url('{{ swatch_image | image_url: width: 80 | escape }}');"
                      {% elsif option_value != blank %}
                        style="--hargx-swatch-color: {{ option_value | downcase | escape }};"
                      {% endif %}
                      aria-hidden="true"
                    ></span>
                    <span class="hargx-product-card__variant-swatch-name">{{ option_value | escape }}</span>
                  {%- elsif variant_display == 'image' -%}
                    {%- if variant_option_image != blank -%}
                      {{
                        variant_option_image
                        | image_url: width: 160
                        | image_tag:
                          loading: 'lazy',
                          class: 'hargx-product-card__variant-swatch-image',
                          alt: option_value
                      }}
                    {%- else -%}
                      <span class="hargx-product-card__variant-swatch-placeholder" aria-hidden="true"></span>
                    {%- endif -%}
                    <span class="hargx-product-card__variant-swatch-name">{{ option_value | escape }}</span>
                  {%- else -%}
                    {{ option_value | escape }}
                  {%- endif -%}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endfor -%}
      </fieldset>
    {%- endif -%}

  </div>
</article>
