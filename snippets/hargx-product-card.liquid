<article class="hargx-product-card">

  <div class="hargx-product-card__media">
    <a
      href="{{ product.url }}"
      class="hargx-product-card__link"
      aria-label="{{ product.title | escape }}"
    >

      {%- comment -%}
        Product Badges
      {%- endcomment -%}

      {%- if product.available == false -%}

        <span class="hargx-product-card__badge hargx-product-card__badge--sold-out">
          Sold out
        </span>

      {%- elsif product.compare_at_price > product.price -%}

        <span class="hargx-product-card__badge hargx-product-card__badge--sale">
          Sale
        </span>

      {%- endif -%}


      {%- comment -%}
        Product Images
      {%- endcomment -%}

      {%- if product.featured_image != blank -%}

        {{
          product.featured_image
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 900',
            sizes: '(min-width: 990px) calc((100vw - 120px) / var(--hargx-desktop-columns)), 50vw',
            class: 'hargx-product-card__image hargx-product-card__image--primary',
            alt: product.featured_image.alt | default: product.title
        }}

      {%- else -%}

        {{ 'product-1' | placeholder_svg_tag: 'hargx-product-card__placeholder' }}

      {%- endif -%}


      {%- comment -%}
        Second Image / Hover Image
      {%- endcomment -%}

      {%- if product.images.size > 1 -%}

        {{
          product.images[1]
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 900',
            sizes: '(min-width: 990px) calc((100vw - 120px) / var(--hargx-desktop-columns)), 50vw',
            class: 'hargx-product-card__image hargx-product-card__image--secondary',
            alt: product.images[1].alt | default: product.title
        }}

      {%- endif -%}

    </a>

    {%- if show_add_to_cart -%}
      <form
        method="post"
        action="{{ routes.cart_add_url }}"
        class="hargx-product-card__quick-add-form"
        enctype="multipart/form-data"
        data-hargx-quick-add-form
      >
        {%- if product.variants.size > 1 -%}
          <label class="hargx-product-card__variant-label" for="HargxProductVariant-{{ section.id }}-{{ product.id }}">
            Options
          </label>
          <select
            id="HargxProductVariant-{{ section.id }}-{{ product.id }}"
            class="hargx-product-card__variant-select"
            name="id"
            aria-label="Choose an option for {{ product.title | escape }}"
            {% unless product.available %}disabled{% endunless %}
          >
            {%- for variant in product.variants -%}
              <option
                value="{{ variant.id }}"
                {% if variant.id == product.selected_or_first_available_variant.id %}selected{% endif %}
                {% unless variant.available %}disabled{% endunless %}
              >
                {{ variant.title | escape }}{% unless variant.available %} - Sold out{% endunless %}
              </option>
            {%- endfor -%}
          </select>
        {%- else -%}
          <input
            type="hidden"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
          >
        {%- endif -%}

        <button
          type="submit"
          class="hargx-product-card__quick-add"
          aria-label="Add {{ product.title | escape }} to cart"
          {% unless product.available %}disabled{% endunless %}
        >
          <span>
            {%- if product.available -%}
              {{ add_to_cart_text | default: 'Add to cart' | escape }}
            {%- else -%}
              Sold out
            {%- endif -%}
          </span>
          <svg
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 8H13M8.5 3.5L13 8L8.5 12.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        </button>
        <span
          class="hargx-product-card__quick-add-error"
          data-hargx-quick-add-error
          role="alert"
          hidden
        ></span>
      </form>
    {%- endif -%}
  </div>

  <div class="hargx-product-card__content">

    <h2 class="hargx-product-card__title">
      <a href="{{ product.url }}" class="hargx-product-card__link">
        {{ product.title | escape }}
      </a>
    </h2>


    <div class="hargx-product-card__price">

        {%- if product.compare_at_price > product.price -%}

          <span class="hargx-product-card__price-current">
            {{ product.price | money }}
          </span>

          <s class="hargx-product-card__price-compare">
            {{ product.compare_at_price | money }}
          </s>

        {%- else -%}

          <span class="hargx-product-card__price-current">
            {{ product.price | money }}
          </span>

        {%- endif -%}

    </div>

  </div>
</article>
