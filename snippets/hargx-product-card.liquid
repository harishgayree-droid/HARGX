<article class="hargx-product-card">
  {%- assign selected_variant = product.selected_or_first_available_variant -%}

  <div class="hargx-product-card__media">
    <a
      href="{{ product.url }}"
      class="hargx-product-card__link"
      aria-label="{{ product.title | escape }}"
    >

      {%- comment -%}
        Product Badges
      {%- endcomment -%}

      {%- if product.available == false -%}

        <span class="hargx-product-card__badge hargx-product-card__badge--sold-out">
          Sold out
        </span>

      {%- elsif product.compare_at_price > product.price -%}

        <span class="hargx-product-card__badge hargx-product-card__badge--sale">
          Sale
        </span>

      {%- endif -%}


      {%- comment -%}
        Product Images
      {%- endcomment -%}

      {%- if product.featured_image != blank -%}

        {{
          product.featured_image
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 900',
            sizes: '(min-width: 990px) calc((100vw - 120px) / var(--hargx-desktop-columns)), 50vw',
            class: 'hargx-product-card__image hargx-product-card__image--primary',
            alt: product.featured_image.alt | default: product.title
        }}

      {%- else -%}

        {{ 'product-1' | placeholder_svg_tag: 'hargx-product-card__placeholder' }}

      {%- endif -%}


      {%- comment -%}
        Second Image / Hover Image
      {%- endcomment -%}

      {%- if product.images.size > 1 -%}

        {{
          product.images[1]
          | image_url: width: 900
          | image_tag:
            loading: 'lazy',
            widths: '360, 540, 720, 900',
            sizes: '(min-width: 990px) calc((100vw - 120px) / var(--hargx-desktop-columns)), 50vw',
            class: 'hargx-product-card__image hargx-product-card__image--secondary',
            alt: product.images[1].alt | default: product.title
        }}

      {%- endif -%}

    </a>

    {%- if show_add_to_cart -%}
      <form
        id="HargxQuickAdd-{{ section.id }}-{{ product.id }}"
        method="post"
        action="{{ routes.cart_add_url }}"
        class="hargx-product-card__quick-add-form"
        enctype="multipart/form-data"
        data-hargx-quick-add-form
      >
        <input
          type="hidden"
          name="id"
          value="{{ selected_variant.id }}"
          data-hargx-card-variant-id
        >

        <button
          type="submit"
          class="hargx-product-card__quick-add"
          aria-label="Add {{ product.title | escape }} to cart"
          {% unless product.available %}disabled{% endunless %}
        >
          <span>
            {%- if product.available -%}
              {{ add_to_cart_text | default: 'Add to cart' | escape }}
            {%- else -%}
              Sold out
            {%- endif -%}
          </span>
          <svg
            class="hargx-product-card__quick-add-arrow"
            width="16"
            height="16"
            viewBox="0 0 16 16"
            fill="none"
            aria-hidden="true"
          >
            <path
              d="M3 8H13M8.5 3.5L13 8L8.5 12.5"
              stroke="currentColor"
              stroke-width="1.5"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
          <svg
            class="hargx-product-card__quick-add-cart-icon"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
            focusable="false"
          >
            <path
              d="M3 4h2l2.2 11.2a2 2 0 0 0 2 1.6h8.9a2 2 0 0 0 1.9-1.4L22 8H6"
              stroke="currentColor"
              stroke-width="1.7"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
            <circle cx="10" cy="20" r="1" fill="currentColor" />
            <circle cx="18" cy="20" r="1" fill="currentColor" />
          </svg>
        </button>
        <span
          class="hargx-product-card__quick-add-error"
          data-hargx-quick-add-error
          role="alert"
          hidden
        ></span>
      </form>
    {%- endif -%}
  </div>

  <div class="hargx-product-card__content">

    <h2 class="hargx-product-card__title">
      <a href="{{ product.url }}" class="hargx-product-card__link">
        {{ product.title | escape }}
      </a>
    </h2>


    <div class="hargx-product-card__price">

        {%- if selected_variant.compare_at_price > selected_variant.price -%}

          <span class="hargx-product-card__price-current" data-hargx-card-current-price>
            {{ selected_variant.price | money }}
          </span>

          <s class="hargx-product-card__price-compare" data-hargx-card-compare-price>
            {{ selected_variant.compare_at_price | money }}
          </s>

        {%- else -%}

          <span class="hargx-product-card__price-current" data-hargx-card-current-price>
            {{ selected_variant.price | money }}
          </span>
          <s class="hargx-product-card__price-compare" data-hargx-card-compare-price hidden></s>

        {%- endif -%}

    </div>

    {%- if show_add_to_cart and product.variants.size > 1 -%}
      <fieldset class="hargx-product-card__variants">
        <legend class="hargx-product-card__variants-label">Options</legend>
        <div class="hargx-product-card__variant-swatches">
          {%- for variant in product.variants -%}
            <button
              type="button"
              class="hargx-product-card__variant-swatch"
              data-hargx-card-variant
              data-variant-id="{{ variant.id }}"
              data-variant-price="{{ variant.price | money | escape }}"
              data-variant-compare-price="{{ variant.compare_at_price | money | escape }}"
              data-variant-on-sale="{% if variant.compare_at_price > variant.price %}true{% else %}false{% endif %}"
              aria-pressed="{% if variant.id == selected_variant.id %}true{% else %}false{% endif %}"
              aria-label="{{ variant.title | escape }}{% unless variant.available %} - Sold out{% endunless %}"
              {% if variant.id == selected_variant.id %}data-selected{% endif %}
              {% unless variant.available %}disabled{% endunless %}
            >
              {{ variant.title | escape }}
            </button>
          {%- endfor -%}
        </div>
      </fieldset>
    {%- endif -%}

  </div>
</article>
