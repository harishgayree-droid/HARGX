<header
  class="hargx-header hargx-header--{{ section.settings.header_layout }}"
  {% if section.settings.sticky_header %}
    data-sticky-header
  {% endif %}
>
  <div class="hargx-header__inner">

    <!-- Mobile Menu Button -->
    <button
      type="button"
      class="hargx-header__mobile-toggle"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- Logo -->
    <a
      href="{{ routes.root_url }}"
      class="hargx-header__logo"
      aria-label="{{ shop.name }}"
    >
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: section.settings.logo_width
          | image_tag:
            widths: '100,150,200,250,300',
            loading: 'eager',
            alt: shop.name
        }}
      {% else %}
        <span>{{ shop.name }}</span>
      {% endif %}
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hargx-header__nav"
      aria-label="Main navigation"
    >
      {% for link in section.settings.menu.links %}
        <a
          href="{{ link.url }}"
          class="hargx-header__nav-link"
          {% if link.current %}
            aria-current="page"
          {% endif %}
        >
          {{ link.title }}

          {% if link.links != blank %}
            <span class="hargx-header__chevron">⌄</span>
          {% endif %}
        </a>
      {% endfor %}
    </nav>

    <!-- Header Actions -->
    <div class="hargx-header__actions">

      <!-- Search -->
      <a
        href="{{ routes.search_url }}"
        class="hargx-header__action"
        aria-label="Search"
      >
        {{ 'icon-search.svg' | inline_asset_content }}
      </a>

      <!-- Account -->
      {% if shop.customer_accounts_enabled %}
        <a
          href="{{ routes.account_url }}"
          class="hargx-header__action"
          aria-label="Account"
        >
          {{ 'icon-account.svg' | inline_asset_content }}
        </a>
      {% endif %}

      <!-- Cart -->
      <a
        href="{{ routes.cart_url }}"
        class="hargx-header__action hargx-header__cart"
        aria-label="Cart"
      >
        {{ 'icon-cart.svg' | inline_asset_content }}

        {% if cart.item_count > 0 %}
          <span class="hargx-header__cart-count">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>

    </div>

  </div>
</header>

{% stylesheet %}

/* ========================================
   HARGX HEADER
   ======================================== */

.hargx-header {
  width: 100%;
  background: var(--color-white);
  color: var(--color-black);
  border-bottom: 1px solid var(--color-border);
  z-index: 50;
}

.hargx-header[data-sticky-header] {
  position: sticky;
  top: 0;
}

.hargx-header__inner {
  width: min(
    calc(var(--page-width) - var(--page-margin) * 2),
    calc(100% - var(--page-margin) * 2)
  );

  min-height: 76px;
  margin-inline: auto;

  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 32px;
}

/* ========================================
   LOGO
   ======================================== */

.hargx-header__logo {
  flex: 0 0 auto;
  display: flex;
  align-items: center;

  color: inherit;
  text-decoration: none;

  font-family: var(--font-heading--family);
  font-weight: 700;
  font-size: 22px;
}

.hargx-header__logo img {
  display: block;
  width: auto;
  max-width: 100%;
}

/* ========================================
   NAVIGATION
   ======================================== */

.hargx-header__nav {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 28px;
}

.hargx-header__nav-link {
  display: inline-flex;
  align-items: center;
  gap: 5px;

  color: inherit;
  text-decoration: none;

  font-size: 14px;
  line-height: 1.2;
  font-weight: 500;
}

.hargx-header__nav-link:hover {
  color: var(--color-primary);
}

.hargx-header__chevron {
  font-size: 14px;
  line-height: 1;
}

/* ========================================
   ACTIONS
   ======================================== */

.hargx-header__actions {
  flex: 0 0 auto;

  display: flex;
  align-items: center;
  gap: 18px;
}

.hargx-header__action {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;

  color: inherit;
  text-decoration: none;
}

.hargx-header__action svg {
  width: 21px;
  height: 21px;
}

.hargx-header__action:hover {
  color: var(--color-primary);
}

/* ========================================
   CART COUNT
   ======================================== */

.hargx-header__cart-count {
  position: absolute;
  top: -9px;
  right: -10px;

  min-width: 17px;
  height: 17px;
  padding: 0 4px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: var(--color-primary);
  color: var(--color-white);

  border-radius: 50%;

  font-size: 9px;
  line-height: 1;
  font-weight: 700;
}

/* ========================================
   MOBILE MENU BUTTON
   ======================================== */

.hargx-header__mobile-toggle {
  display: none;

  width: 24px;
  height: 24px;
  padding: 0;

  border: 0;
  background: transparent;

  flex-direction: column;
  justify-content: center;
  gap: 5px;

  cursor: pointer;
}

.hargx-header__mobile-toggle span {
  display: block;
  width: 20px;
  height: 1.5px;
  background: currentColor;
}

/* ========================================
   CLASSIC LAYOUT
   ======================================== */

.hargx-header--classic .hargx-header__logo {
  order: 1;
}

.hargx-header--classic .hargx-header__nav {
  order: 2;
}

.hargx-header--classic .hargx-header__actions {
  order: 3;
}

/* ========================================
   CENTER LOGO LAYOUT
   ======================================== */

.hargx-header--center-logo .hargx-header__inner {
  position: relative;
}

.hargx-header--center-logo .hargx-header__logo {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.hargx-header--center-logo .hargx-header__nav {
  justify-content: flex-start;
}

.hargx-header--center-logo .hargx-header__actions {
  margin-left: auto;
}

/* ========================================
   MINIMAL LAYOUT
   ======================================== */

.hargx-header--minimal .hargx-header__nav {
  display: none;
}

.hargx-header--minimal .hargx-header__inner {
  justify-content: space-between;
}

.hargx-header--minimal .hargx-header__logo {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

/* ========================================
   MEGA MENU FOUNDATION
   ======================================== */

.hargx-header--mega-menu .hargx-header__nav {
  gap: 30px;
}

/* ========================================
   MOBILE
   ======================================== */

@media screen and (max-width: 749px) {

  .hargx-header__inner {
    min-height: 64px;
    gap: 16px;
  }

  .hargx-header__mobile-toggle {
    display: flex;
    flex: 0 0 auto;
  }

  .hargx-header__nav {
    display: none;
  }

  .hargx-header__logo {
    position: absolute;
    left: 50%;
    transform: translateX(-50%);
  }

  .hargx-header__actions {
    margin-left: auto;
    gap: 14px;
  }

  .hargx-header__action svg {
    width: 20px;
    height: 20px;
  }

  .hargx-header__action:nth-child(2) {
    display: none;
  }

}

{% endstylesheet %}

{% schema %}
{
  "name": "HARGX Header",
  "settings": [
    {
      "type": "select",
      "id": "header_layout",
      "label": "Header layout",
      "options": [
        {
          "value": "classic",
          "label": "Classic"
        },
        {
          "value": "center-logo",
          "label": "Center Logo"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "mega-menu",
          "label": "Mega Menu"
        }
      ],
      "default": "classic"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 150
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Sticky header",
      "default": true
    },
    {
      "type": "link_list",
      "id": "customer_account_menu",
      "label": "Customer account menu",
      "default": "customer-account-main-menu"
    }
  ]
}
{% endschema %}