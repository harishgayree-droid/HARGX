{% comment %}
  HARGX Collection Hero
  Collection page hero with:
  - Breadcrumbs
  - Eyebrow
  - Collection title
  - Collection description
  - Optional collection image
  - Image position
  - Overlay
  - Responsive layout
{% endcomment %}

<section
  class="hargx-collection-hero hargx-collection-hero--{{ section.settings.layout }}"
  style="
    --hargx-collection-bg: {{ section.settings.background_color }};
    --hargx-collection-text: {{ section.settings.text_color }};
    --hargx-collection-accent: {{ section.settings.accent_color }};
    --hargx-collection-overlay: {{ section.settings.overlay_color }};
    --hargx-collection-overlay-opacity: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hargx-collection-radius: {{ section.settings.image_radius }}px;
    --hargx-collection-gap: {{ section.settings.column_gap }}px;
    --hargx-collection-top: {{ section.settings.padding_top }}px;
    --hargx-collection-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="hargx-collection-hero__container page-width">

    {% if section.settings.show_breadcrumbs %}
      <nav
        class="hargx-collection-hero__breadcrumbs"
        aria-label="Breadcrumb"
      >
        <a href="{{ routes.root_url }}">Home</a>

        <span class="hargx-collection-hero__breadcrumb-separator">
          /
        </span>

        <span aria-current="page">
          {{ collection.title | escape }}
        </span>
      </nav>
    {% endif %}

    <div class="hargx-collection-hero__content">

      <div class="hargx-collection-hero__text">

        {% if section.settings.eyebrow != blank %}
          <p class="hargx-collection-hero__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {% endif %}

        <h1 class="hargx-collection-hero__title">
          {{ collection.title | escape }}
        </h1>

        {% if collection.description != blank and section.settings.show_description %}
          <div class="hargx-collection-hero__description rte">
            {{ collection.description }}
          </div>
        {% endif %}

      </div>

      {% if section.settings.show_image and collection.image != blank %}
        <div class="hargx-collection-hero__media">

          <div class="hargx-collection-hero__image-wrapper">
            {{
              collection.image
              | image_url: width: 1800
              | image_tag:
                loading: 'eager',
                widths: '600, 900, 1200, 1500, 1800',
                sizes: '(min-width: 990px) 50vw, 100vw',
                class: 'hargx-collection-hero__image',
                alt: collection.image.alt | default: collection.title | escape
            }}

            {% if section.settings.show_overlay %}
              <div class="hargx-collection-hero__overlay"></div>
            {% endif %}
          </div>

        </div>
      {% endif %}

    </div>
  </div>
</section>

<style>
  .hargx-collection-hero {
    background: var(--hargx-collection-bg);
    color: var(--hargx-collection-text);
    padding-top: var(--hargx-collection-top);
    padding-bottom: var(--hargx-collection-bottom);
    overflow: hidden;
  }

  .hargx-collection-hero__container {
    position: relative;
  }

  /* Breadcrumbs */

  .hargx-collection-hero__breadcrumbs {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
    margin-bottom: 34px;
    font-size: 13px;
    line-height: 1.4;
    letter-spacing: 0.01em;
    color: rgba(0, 0, 0, 0.55);
  }

  .hargx-collection-hero__breadcrumbs a {
    color: inherit;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  .hargx-collection-hero__breadcrumbs a:hover {
    color: var(--hargx-collection-accent);
  }

  .hargx-collection-hero__breadcrumb-separator {
    opacity: 0.4;
  }

  /* Main Layout */

  .hargx-collection-hero__content {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-items: center;
    gap: var(--hargx-collection-gap);
  }

  .hargx-collection-hero--with_image .hargx-collection-hero__content {
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
  }

  .hargx-collection-hero--image_left .hargx-collection-hero__content {
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
  }

  .hargx-collection-hero--image_left .hargx-collection-hero__text {
    order: 2;
  }

  .hargx-collection-hero--image_left .hargx-collection-hero__media {
    order: 1;
  }

  /* Text */

  .hargx-collection-hero__text {
    max-width: 720px;
  }

  .hargx-collection-hero__eyebrow {
    margin: 0 0 14px;
    color: var(--hargx-collection-accent);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hargx-collection-hero__title {
    margin: 0;
    color: var(--hargx-collection-text);
    font-size: clamp(38px, 5vw, 72px);
    font-weight: 700;
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .hargx-collection-hero__description {
    max-width: 650px;
    margin-top: 24px;
    color: rgba(0, 0, 0, 0.68);
    font-size: 16px;
    line-height: 1.7;
  }

  .hargx-collection-hero__description p {
    margin: 0 0 12px;
  }

  .hargx-collection-hero__description p:last-child {
    margin-bottom: 0;
  }

  /* Image */

  .hargx-collection-hero__media {
    min-width: 0;
  }

  .hargx-collection-hero__image-wrapper {
    position: relative;
    overflow: hidden;
    border-radius: var(--hargx-collection-radius);
    aspect-ratio: 1.35 / 1;
    background: #f1efeb;
  }

  .hargx-collection-hero__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s cubic-bezier(0.2, 0.65, 0.25, 1);
  }

  .hargx-collection-hero__image-wrapper:hover
  .hargx-collection-hero__image {
    transform: scale(1.035);
  }

  .hargx-collection-hero__overlay {
    position: absolute;
    inset: 0;
    background: var(--hargx-collection-overlay);
    opacity: var(--hargx-collection-overlay-opacity);
    pointer-events: none;
  }

  /* No Image */

  .hargx-collection-hero--no_image .hargx-collection-hero__text {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .hargx-collection-hero--no_image
  .hargx-collection-hero__description {
    margin-left: auto;
    margin-right: auto;
  }

  /* Tablet */

  @media screen and (max-width: 989px) {
    .hargx-collection-hero__content,
    .hargx-collection-hero--with_image .hargx-collection-hero__content,
    .hargx-collection-hero--image_left .hargx-collection-hero__content {
      grid-template-columns: minmax(0, 1fr);
    }

    .hargx-collection-hero--image_left .hargx-collection-hero__text,
    .hargx-collection-hero--image_left .hargx-collection-hero__media {
      order: initial;
    }

    .hargx-collection-hero__text {
      max-width: 760px;
    }

    .hargx-collection-hero__media {
      max-width: 760px;
    }
  }

  /* Mobile */

  @media screen and (max-width: 749px) {
    .hargx-collection-hero {
      padding-top: 28px;
      padding-bottom: 44px;
    }

    .hargx-collection-hero__breadcrumbs {
      margin-bottom: 26px;
      font-size: 12px;
      gap: 8px;
    }

    .hargx-collection-hero__eyebrow {
      margin-bottom: 10px;
      font-size: 10px;
      letter-spacing: 0.14em;
    }

    .hargx-collection-hero__title {
      font-size: clamp(36px, 12vw, 52px);
      line-height: 1;
    }

    .hargx-collection-hero__description {
      margin-top: 18px;
      font-size: 14px;
      line-height: 1.65;
    }

    .hargx-collection-hero__image-wrapper {
      aspect-ratio: 1.15 / 1;
      border-radius: max(12px, calc(var(--hargx-collection-radius) * 0.75));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hargx-collection-hero__image {
      transition: none;
    }
  }
</style>

{% schema %}
{
  "name": "HARGX Collection Hero",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "no_image",
          "label": "Text only"
        },
        {
          "value": "with_image",
          "label": "Text left / Image right"
        },
        {
          "value": "image_left",
          "label": "Image left / Text right"
        }
      ],
      "default": "with_image"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumbs",
      "label": "Show breadcrumbs",
      "default": true
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Explore the collection"
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show collection image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show image overlay",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 20
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay color",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF8F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#FE7442"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "HARGX Collection Hero"
    }
  ]
}
{% endschema %}