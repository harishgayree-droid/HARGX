{{ 'hargx-contact.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = 'HargxContact-' | append: section.id
-%}

<section
  id="{{ section_id }}"
  class="hargx-contact"
  data-section-id="{{ section.id }}"
>
  <div class="hargx-contact__container">

    {%- comment -%}
      Contact Hero
    {%- endcomment -%}

    <div class="hargx-contact__hero">

      {%- if section.settings.eyebrow != blank -%}
        <span class="hargx-contact__eyebrow">
          {{ section.settings.eyebrow }}
        </span>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hargx-contact__heading">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}

      {%- if section.settings.intro != blank -%}
        <div class="hargx-contact__intro rte">
          {{ section.settings.intro }}
        </div>
      {%- endif -%}

    </div>


    {%- comment -%}
      Main Contact Layout
    {%- endcomment -%}

    <div class="hargx-contact__layout">

      {%- comment -%}
        Contact Information
      {%- endcomment -%}

      <div class="hargx-contact__information">

        {%- if section.settings.info_heading != blank -%}
          <h2 class="hargx-contact__info-heading">
            {{ section.settings.info_heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.info_text != blank -%}
          <div class="hargx-contact__info-text rte">
            {{ section.settings.info_text }}
          </div>
        {%- endif -%}


        <div class="hargx-contact__details">

          {%- for block in section.blocks -%}

            {%- case block.type -%}

              {%- when 'contact_detail' -%}

                <div
                  class="hargx-contact__detail"
                  {{ block.shopify_attributes }}
                >

                  <div
                    class="hargx-contact__detail-icon"
                    aria-hidden="true"
                  >
                    {%- case block.settings.icon -%}

                      {%- when 'email' -%}
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <rect
                            x="3"
                            y="5"
                            width="18"
                            height="14"
                            rx="2"
                            stroke="currentColor"
                            stroke-width="1.5"
                          />
                          <path
                            d="M3 7L12 13L21 7"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>

                      {%- when 'phone' -%}
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            d="M6.5 3.5L9 3L11 8L8.5 9.5C9.6 12 12 14.4 14.5 15.5L16 13L21 15L20.5 17.5C20.2 19.1 18.8 20.2 17.2 20C9.7 19.1 4.9 14.3 4 6.8C3.8 5.2 4.9 3.8 6.5 3.5Z"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>

                      {%- when 'location' -%}
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            d="M20 10C20 15.5 12 21 12 21S4 15.5 4 10C4 5.6 7.6 2 12 2C16.4 2 20 5.6 20 10Z"
                            stroke="currentColor"
                            stroke-width="1.5"
                          />
                          <circle
                            cx="12"
                            cy="10"
                            r="2.5"
                            stroke="currentColor"
                            stroke-width="1.5"
                          />
                        </svg>

                      {%- when 'clock' -%}
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <circle
                            cx="12"
                            cy="12"
                            r="9"
                            stroke="currentColor"
                            stroke-width="1.5"
                          />
                          <path
                            d="M12 7V12L15.5 14"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>

                      {%- when 'chat' -%}
                        <svg
                          viewBox="0 0 24 24"
                          fill="none"
                          xmlns="http://www.w3.org/2000/svg"
                        >
                          <path
                            d="M20 11.5C20 15.6 16.4 19 12 19C10.8 19 9.7 18.8 8.7 18.3L4 20L5.4 16.1C4.5 14.8 4 13.2 4 11.5C4 7.4 7.6 4 12 4C16.4 4 20 7.4 20 11.5Z"
                            stroke="currentColor"
                            stroke-width="1.5"
                            stroke-linejoin="round"
                          />
                        </svg>

                    {%- endcase -%}
                  </div>

                  <div class="hargx-contact__detail-content">

                    {%- if block.settings.heading != blank -%}
                      <h3 class="hargx-contact__detail-heading">
                        {{ block.settings.heading }}
                      </h3>
                    {%- endif -%}

                    {%- if block.settings.text != blank -%}
                      <div class="hargx-contact__detail-text rte">
                        {{ block.settings.text }}
                      </div>
                    {%- endif -%}

                    {%- if block.settings.link_text != blank and block.settings.link != blank -%}
                      <a
                        href="{{ block.settings.link }}"
                        class="hargx-contact__detail-link"
                        {% if block.settings.open_new_tab %}
                          target="_blank"
                          rel="noopener noreferrer"
                        {% endif %}
                      >
                        {{ block.settings.link_text }}
                        <span aria-hidden="true">→</span>
                      </a>
                    {%- endif -%}

                  </div>

                </div>

            {%- endcase -%}

          {%- endfor -%}

        </div>

      </div>


      {%- comment -%}
        Contact Form
      {%- endcomment -%}

      <div class="hargx-contact__form-wrapper">

        {%- if section.settings.form_heading != blank -%}
          <h2 class="hargx-contact__form-heading">
            {{ section.settings.form_heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.form_text != blank -%}
          <div class="hargx-contact__form-text rte">
            {{ section.settings.form_text }}
          </div>
        {%- endif -%}


        {%- form 'contact', id: 'HargxContactForm', class: 'hargx-contact__form' -%}

          {%- if form.posted_successfully? -%}

            <div
              class="hargx-contact__form-message hargx-contact__form-message--success"
              role="status"
              tabindex="-1"
            >
              <strong>
                {{ section.settings.success_heading }}
              </strong>

              <span>
                {{ section.settings.success_text }}
              </span>
            </div>

          {%- endif -%}


          {%- if form.errors -%}

            <div
              class="hargx-contact__form-message hargx-contact__form-message--error"
              role="alert"
              tabindex="-1"
            >
              <strong>
                {{ section.settings.error_heading }}
              </strong>

              {{ form.errors | default_errors }}

            </div>

          {%- endif -%}


          <div class="hargx-contact__form-grid">

            <div class="hargx-contact__field">

              <label
                for="HargxContactFirstName-{{ section.id }}"
                class="hargx-contact__label"
              >
                First name
              </label>

              <input
                id="HargxContactFirstName-{{ section.id }}"
                type="text"
                name="contact[first_name]"
                autocomplete="given-name"
                class="hargx-contact__input"
                placeholder="First name"
              >

            </div>


            <div class="hargx-contact__field">

              <label
                for="HargxContactLastName-{{ section.id }}"
                class="hargx-contact__label"
              >
                Last name
              </label>

              <input
                id="HargxContactLastName-{{ section.id }}"
                type="text"
                name="contact[last_name]"
                autocomplete="family-name"
                class="hargx-contact__input"
                placeholder="Last name"
              >

            </div>


            <div class="hargx-contact__field hargx-contact__field--full">

              <label
                for="HargxContactEmail-{{ section.id }}"
                class="hargx-contact__label"
              >
                Email
                <span aria-hidden="true">*</span>
              </label>

              <input
                id="HargxContactEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                spellcheck="false"
                class="hargx-contact__input"
                placeholder="you@example.com"
                required
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                  aria-describedby="HargxContactEmailError-{{ section.id }}"
                {% endif %}
              >

              {%- if form.errors contains 'email' -%}
                <span
                  id="HargxContactEmailError-{{ section.id }}"
                  class="hargx-contact__field-error"
                >
                  Please enter a valid email address.
                </span>
              {%- endif -%}

            </div>


            <div class="hargx-contact__field">

              <label
                for="HargxContactPhone-{{ section.id }}"
                class="hargx-contact__label"
              >
                Phone
              </label>

              <input
                id="HargxContactPhone-{{ section.id }}"
                type="tel"
                name="contact[phone]"
                autocomplete="tel"
                class="hargx-contact__input"
                placeholder="Phone number"
              >

            </div>


            <div class="hargx-contact__field">

              <label
                for="HargxContactSubject-{{ section.id }}"
                class="hargx-contact__label"
              >
                Subject
              </label>

              <input
                id="HargxContactSubject-{{ section.id }}"
                type="text"
                name="contact[subject]"
                class="hargx-contact__input"
                placeholder="How can we help?"
              >

            </div>


            <div class="hargx-contact__field hargx-contact__field--full">

              <label
                for="HargxContactMessage-{{ section.id }}"
                class="hargx-contact__label"
              >
                Message
                <span aria-hidden="true">*</span>
              </label>

              <textarea
                id="HargxContactMessage-{{ section.id }}"
                name="contact[body]"
                rows="7"
                class="hargx-contact__textarea"
                placeholder="Tell us how we can help..."
                required
              ></textarea>

            </div>

          </div>


          <button
            type="submit"
            class="hargx-contact__submit"
          >
            <span>
              {{ section.settings.submit_text }}
            </span>

            <span
              class="hargx-contact__submit-arrow"
              aria-hidden="true"
            >
              →
            </span>
          </button>

        {%- endform -%}

      </div>

    </div>

  </div>
</section>


{% schema %}
{
  "name": "HARGX Contact",
  "tag": "section",
  "class": "hargx-contact-section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WE'D LOVE TO HEAR FROM YOU"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "How can we help?"
    },
    {
      "type": "richtext",
      "id": "intro",
      "label": "Intro",
      "default": "<p>Have a question about an order, product, or anything else? Send us a message and our team will get back to you.</p>"
    },
    {
      "type": "text",
      "id": "info_heading",
      "label": "Information heading",
      "default": "Let's talk"
    },
    {
      "type": "richtext",
      "id": "info_text",
      "label": "Information text",
      "default": "<p>We're here to help with questions, product information, orders, and anything else you need.</p>"
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Send us a message"
    },
    {
      "type": "richtext",
      "id": "form_text",
      "label": "Form text",
      "default": "<p>Fill out the form below and we'll get back to you as soon as possible.</p>"
    },
    {
      "type": "text",
      "id": "submit_text",
      "label": "Submit button text",
      "default": "Send message"
    },
    {
      "type": "text",
      "id": "success_heading",
      "label": "Success heading",
      "default": "Message sent"
    },
    {
      "type": "text",
      "id": "success_text",
      "label": "Success text",
      "default": "Thanks for reaching out. We'll get back to you soon."
    },
    {
      "type": "text",
      "id": "error_heading",
      "label": "Error heading",
      "default": "Something went wrong"
    }
  ],
  "blocks": [
    {
      "type": "contact_detail",
      "name": "Contact detail",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "email",
              "label": "Email"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "location",
              "label": "Location"
            },
            {
              "value": "clock",
              "label": "Business hours"
            },
            {
              "value": "chat",
              "label": "Chat"
            }
          ],
          "default": "email"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Email us"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>hello@example.com</p>"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Send an email"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in new tab",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HARGX Contact",
      "blocks": [
        {
          "type": "contact_detail",
          "settings": {
            "icon": "email",
            "heading": "Email us",
            "text": "<p>hello@example.com</p>",
            "link_text": "Send an email"
          }
        },
        {
          "type": "contact_detail",
          "settings": {
            "icon": "phone",
            "heading": "Call us",
            "text": "<p>+1 (000) 000-0000</p>",
            "link_text": "Give us a call"
          }
        },
        {
          "type": "contact_detail",
          "settings": {
            "icon": "clock",
            "heading": "Business hours",
            "text": "<p>Monday – Friday<br>9:00 AM – 6:00 PM</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}