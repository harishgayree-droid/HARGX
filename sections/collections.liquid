{{ 'hargx-collection-list.css' | asset_url | stylesheet_tag }}

<section
  id="HargxCollectionList-{{ section.id }}"
  class="hargx-collection-list hargx-collection-list--{{ section.settings.card_style }}"
  style="
    --hargx-collection-list-columns: {{ section.settings.columns_desktop }};
    --hargx-collection-list-columns-tablet: {{ section.settings.columns_tablet }};
    --hargx-collection-list-columns-mobile: {{ section.settings.columns_mobile }};
    --hargx-collection-list-image-ratio: {{ section.settings.image_ratio }};
    --hargx-collection-list-image-fit: {{ section.settings.image_fit }};
    --hargx-collection-list-card-text-alignment: {{ section.settings.card_text_alignment }};
    --hargx-collection-list-gap: {{ section.settings.gap }}px;
    --hargx-collection-list-gap-mobile: {{ section.settings.gap_mobile }}px;
    --hargx-collection-list-radius: {{ section.settings.card_radius }}px;
    --hargx-collection-list-background: {{ section.settings.background_color }};
    --hargx-collection-list-text: {{ section.settings.text_color }};
    --hargx-collection-list-card-background: {{ section.settings.card_background_color }};
    --hargx-collection-list-accent: {{ section.settings.accent_color }};
    --hargx-collection-list-padding-top: {{ section.settings.padding_top }}px;
    --hargx-collection-list-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hargx-collection-list-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --hargx-collection-list-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="hargx-collection-list__container{% if section.settings.container_width == 'wide' %} hargx-collection-list__container--wide{% endif %} page-width">
    {%- if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.description != blank
    -%}
      <div class="hargx-collection-list__header hargx-collection-list__header--{{ section.settings.text_alignment }}">
        {%- if section.settings.eyebrow != blank -%}
          <p class="hargx-collection-list__eyebrow">
            {{ section.settings.eyebrow | escape }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <{{ section.settings.heading_tag }} class="hargx-collection-list__heading hargx-collection-list__heading--{{ section.settings.heading_size }}">
            {{ section.settings.heading | escape }}
          </{{ section.settings.heading_tag }}>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="hargx-collection-list__description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="hargx-collection-list__grid">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          {%- if block.settings.collection != blank -%}
            {% render 'hargx-collection-list-card',
              collection: block.settings.collection,
              section_settings: section.settings,
              block_attributes: block.shopify_attributes
            %}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for collection in collections -%}
          {% render 'hargx-collection-list-card',
            collection: collection,
            section_settings: section.settings
          %}
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HARGX Collection List",
  "tag": "section",
  "class": "section-hargx-collection-list",
  "max_blocks": 16,
  "settings": [
    {
