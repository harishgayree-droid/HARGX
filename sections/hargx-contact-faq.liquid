{% comment %}
  HARGX Contact FAQ
  Premium FAQ accordion for the Contact page.
{% endcomment %}
{{ 'hargx-contact-faq.css' | asset_url | stylesheet_tag }}

<section
  id="HargxContactFaq-{{ section.id }}"
  class="hargx-contact-faq"
  data-section-id="{{ section.id }}"
>
  <div class="hargx-contact-faq__container">
    <div class="hargx-contact-faq__header">
      {% if section.settings.eyebrow != blank %}
        <p class="hargx-contact-faq__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="hargx-contact-faq__heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.text != blank %}
        <div class="hargx-contact-faq__intro rte">
          {{ section.settings.text }}
        </div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="hargx-contact-faq__list">
        {% for block in section.blocks %}
          <details
            class="hargx-contact-faq__item"
            {% if block.settings.open_by_default %}
              open
            {% endif %}
            {{ block.shopify_attributes }}
          >
            <summary class="hargx-contact-faq__question">
              <span class="hargx-contact-faq__question-text">
                {{ block.settings.question }}
              </span>

              <span
                class="hargx-contact-faq__icon"
                aria-hidden="true"
              >
                <svg
                  viewBox="0 0 24 24"
                  fill="none"
                  xmlns="http://www.w3.org/2000/svg"
                >
                  <path
                    d="M5 12H19"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                  <path
                    class="hargx-contact-faq__icon-vertical"
                    d="M12 5V19"
                    stroke="currentColor"
                    stroke-width="1.5"
                    stroke-linecap="round"
                  />
                </svg>
              </span>
            </summary>

            <div class="hargx-contact-faq__answer-wrap">
              <div class="hargx-contact-faq__answer rte">
                {{ block.settings.answer }}
              </div>
            </div>
          </details>
        {% endfor %}
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "HARGX Contact FAQ",
  "tag": "section",
  "class": "section-hargx-contact-faq",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Have a question?"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Intro",
      "default": "<p>Find quick answers to the questions we hear most often.</p>"
    }
  ],
  "blocks": [
    {
      "type": "faq",
      "name": "FAQ",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "label": "Question",
          "default": "How quickly will I receive a response?"
        },
        {
          "type": "richtext",
          "id": "answer",
          "label": "Answer",
          "default": "<p>We usually respond to enquiries within one business day.</p>"
        },
        {
          "type": "checkbox",
          "id": "open_by_default",
          "label": "Open by default",
          "default": false
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HARGX Contact FAQ",
      "blocks": [
        {
          "type": "faq",
          "settings": {
            "question": "How quickly will I receive a response?",
            "answer": "<p>We usually respond to enquiries within one business day.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "What information should I include in my enquiry?",
            "answer": "<p>Tell us what you need help with and include any relevant order, product, or project details so we can assist you faster.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Can I contact you about an existing order?",
            "answer": "<p>Yes. Please include your order number in your message so our team can locate the relevant information.</p>"
          }
        },
        {
          "type": "faq",
          "settings": {
            "question": "Do you offer help before placing an order?",
            "answer": "<p>Absolutely. If you have questions about a product, sizing, availability, or anything else, feel free to contact us before ordering.</p>"
          }
        }
      ]
    }
  ]
}
{% endschema %}