{% comment %}
  HARGX Collection Toolbar
  - Product count
  - Shopify native filters
  - Desktop filter sidebar trigger
  - Mobile filter drawer trigger
  - Native Shopify sorting
{% endcomment %}

{%- assign active_filter_count = 0 -%}

{%- for filter in collection.filters -%}
  {%- assign active_filter_count = active_filter_count | plus: filter.active_values.size -%}

  {%- if filter.type == 'price_range' -%}
    {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
      {%- assign active_filter_count = active_filter_count | plus: 1 -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

<section
  class="hargx-collection-toolbar"
  id="HargxCollectionToolbar-{{ section.id }}"
  style="
    --hargx-toolbar-bg: {{ section.settings.background_color }};
    --hargx-toolbar-text: {{ section.settings.text_color }};
    --hargx-toolbar-accent: {{ section.settings.accent_color }};
    --hargx-toolbar-border: {{ section.settings.border_color }};
    --hargx-toolbar-radius: {{ section.settings.button_radius }}px;
    --hargx-toolbar-top: {{ section.settings.padding_top }}px;
    --hargx-toolbar-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="hargx-collection-toolbar__container page-width">

    <div class="hargx-collection-toolbar__inner">

      <!-- Left -->
      <div class="hargx-collection-toolbar__left">

        {% if section.settings.show_filter_button %}
          <button
            type="button"
            class="hargx-collection-toolbar__button hargx-collection-toolbar__filter-button"
            data-hargx-filter-open
            aria-controls="HargxFilterDrawer-{{ section.id }}"
            aria-expanded="false"
          >
            <span class="hargx-collection-toolbar__button-icon">
              <svg
                width="18"
                height="18"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M4 7H20M7 12H17M10 17H14"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                />
              </svg>
            </span>

            <span>{{ section.settings.filter_label }}</span>

            {% if active_filter_count > 0 %}
              <span class="hargx-collection-toolbar__count">
                {{ active_filter_count }}
              </span>
            {% endif %}
          </button>
        {% endif %}

        {% if section.settings.show_product_count %}
          <span class="hargx-collection-toolbar__product-count">
            {{ collection.products_count }}
            {% if collection.products_count == 1 %}
              product
            {% else %}
              products
            {% endif %}
          </span>
        {% endif %}

      </div>

      <!-- Right -->
      <div class="hargx-collection-toolbar__right">

        {% if section.settings.show_sort %}
          <div class="hargx-collection-toolbar__sort">

            <label
              for="HargxSort-{{ section.id }}"
              class="hargx-collection-toolbar__sort-label"
            >
              {{ section.settings.sort_label }}
            </label>

            <select
              id="HargxSort-{{ section.id }}"
              class="hargx-collection-toolbar__sort-select"
              data-hargx-sort
            >
              {%- assign sort_by = collection.sort_by | default: collection.default_sort_by -%}

              {% for option in collection.sort_options %}
                <option
                  value="{{ option.value | escape }}"
                  {% if option.value == sort_by %}
                    selected
                  {% endif %}
                >
                  {{ option.name }}
                </option>
              {% endfor %}
            </select>

            <span class="hargx-collection-toolbar__sort-icon">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M7 10L12 15L17 10"
                  stroke="currentColor"
                  stroke-width="1.7"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </span>

          </div>
        {% endif %}

      </div>

    </div>

  </div>
</section>

<!-- Filter Drawer -->

<div
  id="HargxFilterDrawer-{{ section.id }}"
  class="hargx-filter-drawer"
  data-hargx-filter-drawer
  hidden
>
  <div
    class="hargx-filter-drawer__overlay"
    data-hargx-filter-close
  ></div>

  <aside
    class="hargx-filter-drawer__panel"
    role="dialog"
    aria-modal="true"
    aria-labelledby="HargxFilterTitle-{{ section.id }}"
  >

    <div class="hargx-filter-drawer__header">

      <div>
        <h2
          id="HargxFilterTitle-{{ section.id }}"
          class="hargx-filter-drawer__title"
        >
          Filters
        </h2>

        {% if active_filter_count > 0 %}
          <span class="hargx-filter-drawer__active-count">
            {{ active_filter_count }}
            active
          </span>
        {% endif %}
      </div>

      <button
        type="button"
        class="hargx-filter-drawer__close"
        data-hargx-filter-close
        aria-label="Close filters"
      >
        <svg
          width="20"
          height="20"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <path
            d="M6 6L18 18M18 6L6 18"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
          />
        </svg>
      </button>

    </div>

    <div class="hargx-filter-drawer__body">

      {% if collection.filters.size > 0 %}

        <form
          id="HargxFilterForm-{{ section.id }}"
          class="hargx-filter-form"
        >

          {% for filter in collection.filters %}

            <details
              class="hargx-filter-group"
              {% if filter.active_values.size > 0 %}
                open
              {% endif %}
            >

              <summary class="hargx-filter-group__summary">

                <span>
                  {{ filter.label }}
                </span>

                <span class="hargx-filter-group__summary-right">

                  {% if filter.active_values.size > 0 %}
                    <span class="hargx-filter-group__active">
                      {{ filter.active_values.size }}
                    </span>
                  {% endif %}

                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M6 9L12 15L18 9"
                      stroke="currentColor"
                      stroke-width="1.7"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>

                </span>

              </summary>

              <div class="hargx-filter-group__content">

                {% case filter.type %}

                  {% when 'boolean' %}

                    <label class="hargx-filter-checkbox">

                      <input
                        type="checkbox"
                        name="{{ filter.param_name }}"
                        value="{{ filter.true_value.value }}"
                        {% if filter.true_value.active %}
                          checked
                        {% endif %}
                        {% if filter.true_value.count == 0 and filter.true_value.active == false %}
                          disabled
                        {% endif %}
                      >

                      <span class="hargx-filter-checkbox__box"></span>

                      <span class="hargx-filter-checkbox__label">
                        {{ filter.true_value.label }}
                      </span>

                      <span class="hargx-filter-checkbox__count">
                        {{ filter.true_value.count }}
                      </span>

                    </label>

                  {% when 'list' %}

                    <div class="hargx-filter-options">

                      {% for value in filter.values %}

                        <label
                          class="hargx-filter-checkbox{% if value.count == 0 and value.active == false %} is-disabled{% endif %}"
                        >

                          <input
                            type="checkbox"
                            name="{{ value.param_name }}"
                            value="{{ value.value }}"
                            {% if value.active %}
                              checked
                            {% endif %}
                            {% if value.count == 0 and value.active == false %}
                              disabled
                            {% endif %}
                          >

                          <span class="hargx-filter-checkbox__box"></span>

                          <span class="hargx-filter-checkbox__label">
                            {{ value.label }}
                          </span>

                          <span class="hargx-filter-checkbox__count">
                            {{ value.count }}
                          </span>

                        </label>

                      {% endfor %}

                    </div>

                  {% when 'price_range' %}

                    <div class="hargx-price-filter">

                      <div class="hargx-price-filter__fields">

                        <div class="hargx-price-filter__field">

                          <span class="hargx-price-filter__currency">
                            {{ cart.currency.symbol }}
                          </span>

                          <input
                            class="hargx-price-filter__input"
                            type="number"
                            name="{{ filter.min_value.param_name }}"
                            value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                            placeholder="0"
                            min="0"
                            inputmode="decimal"
                          >

                        </div>

                        <span class="hargx-price-filter__separator">
                          –
                        </span>

                        <div class="hargx-price-filter__field">

                          <span class="hargx-price-filter__currency">
                            {{ cart.currency.symbol }}
                          </span>

                          <input
                            class="hargx-price-filter__input"
                            type="number"
                            name="{{ filter.max_value.param_name }}"
                            value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                            placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            min="0"
                            inputmode="decimal"
                          >

                        </div>

                      </div>

                    </div>

                {% endcase %}

              </div>

            </details>

          {% endfor %}

        </form>

      {% else %}

        <div class="hargx-filter-drawer__empty">
          <p>No filters are available for this collection.</p>
        </div>

      {% endif %}

    </div>

    <div class="hargx-filter-drawer__footer">

      {% if active_filter_count > 0 %}
        <a
          href="{{ collection.url }}"
          class="hargx-filter-drawer__clear"
        >
          Clear all
        </a>
      {% endif %}

      <button
        type="button"
        class="hargx-filter-drawer__apply"
        data-hargx-filter-apply
      >
        Apply filters
      </button>

    </div>

  </aside>
</div>

<script>
  (function () {
    const section = document.getElementById(
      'HargxCollectionToolbar-{{ section.id }}'
    );

    const drawer = document.getElementById(
      'HargxFilterDrawer-{{ section.id }}'
    );

    if (!section || !drawer) return;

    const openButton = section.querySelector('[data-hargx-filter-open]');
    const closeButtons = drawer.querySelectorAll('[data-hargx-filter-close]');
    const applyButton = drawer.querySelector('[data-hargx-filter-apply]');
    const filterForm = drawer.querySelector('.hargx-filter-form');
    const sortSelect = section.querySelector('[data-hargx-sort]');

    function openDrawer() {
      drawer.hidden = false;

      requestAnimationFrame(function () {
        drawer.classList.add('is-open');
      });

      document.documentElement.classList.add('hargx-filter-open');

      if (openButton) {
        openButton.setAttribute('aria-expanded', 'true');
      }
    }

    function closeDrawer() {
      drawer.classList.remove('is-open');
      document.documentElement.classList.remove('hargx-filter-open');

      if (openButton) {
        openButton.setAttribute('aria-expanded', 'false');
      }

      setTimeout(function () {
        drawer.hidden = true;
      }, 300);
    }

    if (openButton) {
      openButton.addEventListener('click', openDrawer);
    }

    closeButtons.forEach(function (button) {
      button.addEventListener('click', closeDrawer);
    });

    if (applyButton && filterForm) {
      applyButton.addEventListener('click', function () {
        const formData = new FormData(filterForm);
        const params = new URLSearchParams();

        formData.forEach(function (value, key) {
          if (value !== '') {
            params.append(key, value);
          }
        });

        const url = new URL(window.location.href);

        url.search = params.toString();

        window.location.href = url.toString();
      });
    }

    if (sortSelect) {
      sortSelect.addEventListener('change', function () {
        const url = new URL(window.location.href);

        url.searchParams.set('sort_by', this.value);

        window.location.href = url.toString();
      });
    }

    document.addEventListener('keydown', function (event) {
      if (event.key === 'Escape' && drawer.classList.contains('is-open')) {
        closeDrawer();
      }
    });
  })();
</script>

<style>
  .hargx-collection-toolbar {
    background: var(--hargx-toolbar-bg);
    color: var(--hargx-toolbar-text);
    padding-top: var(--hargx-toolbar-top);
    padding-bottom: var(--hargx-toolbar-bottom);
    border-top: 1px solid var(--hargx-toolbar-border);
    border-bottom: 1px solid var(--hargx-toolbar-border);
  }

  .hargx-collection-toolbar__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  .hargx-collection-toolbar__left,
  .hargx-collection-toolbar__right {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .hargx-collection-toolbar__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    min-height: 42px;
    padding: 9px 16px;
    border: 1px solid var(--hargx-toolbar-text);
    border-radius: var(--hargx-toolbar-radius);
    background: transparent;
    color: var(--hargx-toolbar-text);
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    line-height: 1;
    cursor: pointer;
    transition:
      background 0.25s ease,
      color 0.25s ease,
      border-color 0.25s ease;
  }

  .hargx-collection-toolbar__button:hover {
    background: var(--hargx-toolbar-text);
    color: #fff;
  }

  .hargx-collection-toolbar__button-icon {
    display: inline-flex;
  }

  .hargx-collection-toolbar__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 50%;
    background: var(--hargx-toolbar-accent);
    color: #fff;
    font-size: 10px;
    font-weight: 700;
  }

  .hargx-collection-toolbar__product-count {
    color: rgba(0, 0, 0, 0.55);
    font-size: 13px;
  }

  .hargx-collection-toolbar__sort {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .hargx-collection-toolbar__sort-label {
    color: rgba(0, 0, 0, 0.55);
    font-size: 13px;
    white-space: nowrap;
  }

  .hargx-collection-toolbar__sort-select {
    appearance: none;
    min-width: 150px;
    padding: 10px 30px 10px 12px;
    border: 1px solid var(--hargx-toolbar-border);
    border-radius: var(--hargx-toolbar-radius);
    background: transparent;
    color: var(--hargx-toolbar-text);
    font: inherit;
    font-size: 13px;
    cursor: pointer;
  }

  .hargx-collection-toolbar__sort-icon {
    position: absolute;
    right: 10px;
    top: 50%;
    display: flex;
    transform: translateY(-50%);
    pointer-events: none;
  }

  /* Drawer */

  .hargx-filter-drawer {
    position: fixed;
    inset: 0;
    z-index: 9999;
    visibility: hidden;
  }

  .hargx-filter-drawer[hidden] {
    display: block;
  }

  .hargx-filter-drawer.is-open {
    visibility: visible;
  }

  .hargx-filter-drawer__overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.45);
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .hargx-filter-drawer.is-open .hargx-filter-drawer__overlay {
    opacity: 1;
  }

  .hargx-filter-drawer__panel {
    position: absolute;
    top: 0;
    right: 0;
    display: flex;
    flex-direction: column;
    width: min(440px, 92vw);
    height: 100%;
    background: #fff;
    transform: translateX(100%);
    transition: transform 0.35s cubic-bezier(0.2, 0.65, 0.25, 1);
    box-shadow: -10px 0 40px rgba(0, 0, 0, 0.12);
  }

  .hargx-filter-drawer.is-open .hargx-filter-drawer__panel {
    transform: translateX(0);
  }

  .hargx-filter-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    padding: 24px;
    border-bottom: 1px solid #e8e5df;
  }

  .hargx-filter-drawer__title {
    margin: 0;
    font-size: 22px;
    line-height: 1.1;
  }

  .hargx-filter-drawer__active-count {
    display: block;
    margin-top: 5px;
    color: var(--hargx-toolbar-accent);
    font-size: 12px;
  }

  .hargx-filter-drawer__close {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid #e8e5df;
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
  }

  .hargx-filter-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 0 24px;
  }

  .hargx-filter-group {
    border-bottom: 1px solid #e8e5df;
  }

  .hargx-filter-group__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 20px 0;
    list-style: none;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
  }

  .hargx-filter-group__summary::-webkit-details-marker {
    display: none;
  }

  .hargx-filter-group__summary-right {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hargx-filter-group[open]
    .hargx-filter-group__summary-right
    svg {
    transform: rotate(180deg);
  }

  .hargx-filter-group__summary-right svg {
    transition: transform 0.25s ease;
  }

  .hargx-filter-group__active {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 50%;
    background: var(--hargx-toolbar-accent);
    color: #fff;
    font-size: 10px;
  }

  .hargx-filter-group__content {
    padding: 0 0 20px;
  }

  .hargx-filter-options {
    display: grid;
    gap: 12px;
  }

  .hargx-filter-checkbox {
    position: relative;
    display: grid;
    grid-template-columns: 20px minmax(0, 1fr) auto;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    font-size: 13px;
  }

  .hargx-filter-checkbox input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .hargx-filter-checkbox__box {
    position: relative;
    display: block;
    width: 18px;
    height: 18px;
    border: 1px solid #bdb9b1;
    border-radius: 3px;
    transition:
      background 0.2s ease,
      border-color 0.2s ease;
  }

  .hargx-filter-checkbox input:checked
    + .hargx-filter-checkbox__box {
    border-color: var(--hargx-toolbar-accent);
    background: var(--hargx-toolbar-accent);
  }

  .hargx-filter-checkbox input:checked
    + .hargx-filter-checkbox__box::after {
    position: absolute;
    left: 5px;
    top: 2px;
    width: 5px;
    height: 9px;
    border: solid #fff;
    border-width: 0 1.5px 1.5px 0;
    content: "";
    transform: rotate(45deg);
  }

  .hargx-filter-checkbox__label {
    min-width: 0;
  }

  .hargx-filter-checkbox__count {
    color: #8a877f;
    font-size: 11px;
  }

  .hargx-filter-checkbox.is-disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* Price */

  .hargx-price-filter__fields {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 10px;
  }

  .hargx-price-filter__field {
    position: relative;
  }

  .hargx-price-filter__currency {
    position: absolute;
    left: 12px;
    top: 50%;
    color: #777;
    font-size: 12px;
    transform: translateY(-50%);
  }

  .hargx-price-filter__input {
    width: 100%;
    min-height: 42px;
    padding: 10px 10px 10px 26px;
    border: 1px solid #d9d5cd;
    border-radius: 8px;
    background: #fff;
    font: inherit;
    font-size: 13px;
  }

  .hargx-price-filter__separator {
    color: #999;
  }

  /* Footer */

  .hargx-filter-drawer__footer {
    display: flex;
    align-items: center;
    gap: 15px;
    padding: 20px 24px;
    border-top: 1px solid #e8e5df;
    background: #fff;
  }

  .hargx-filter-drawer__clear {
    color: var(--hargx-toolbar-text);
    font-size: 13px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .hargx-filter-drawer__apply {
    flex: 1;
    min-height: 48px;
    border: 0;
    border-radius: var(--hargx-toolbar-radius);
    background: var(--hargx-toolbar-text);
    color: #fff;
    font: inherit;
    font-size: 13px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.25s ease;
  }

  .hargx-filter-drawer__apply:hover {
    background: var(--hargx-toolbar-accent);
  }

  html.hargx-filter-open {
    overflow: hidden;
  }

  @media screen and (max-width: 749px) {
    .hargx-collection-toolbar {
      padding-top: 12px;
      padding-bottom: 12px;
    }

    .hargx-collection-toolbar__inner {
      gap: 10px;
    }

    .hargx-collection-toolbar__left,
    .hargx-collection-toolbar__right {
      gap: 8px;
    }

    .hargx-collection-toolbar__product-count {
      display: none;
    }

    .hargx-collection-toolbar__button {
      min-height: 40px;
      padding: 8px 13px;
      font-size: 12px;
    }

    .hargx-collection-toolbar__sort-label {
      display: none;
    }

    .hargx-collection-toolbar__sort-select {
      min-width: 120px;
      min-height: 40px;
      font-size: 12px;
    }

    .hargx-filter-drawer__panel {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "HARGX Collection Toolbar",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_filter_button",
      "label": "Show filter button",
      "default": true
    },
    {
      "type": "text",
      "id": "filter_label",
      "label": "Filter label",
      "default": "Filter"
    },
    {
      "type": "checkbox",
      "id": "show_product_count",
      "label": "Show product count",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show sorting",
      "default": true
    },
    {
      "type": "text",
      "id": "sort_label",
      "label": "Sort label",
      "default": "Sort by"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FFFFFF"
    },
