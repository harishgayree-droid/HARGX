{%- liquid
  assign products_to_show = section.settings.products_to_show
  assign desktop_columns = section.settings.desktop_columns
  assign mobile_columns = section.settings.mobile_columns
-%}

<section
  id="HargxRecommendedProducts-{{ section.id }}"
  class="hargx-recommended-products"
  data-hargx-recommendations
  data-product-id="{{ product.id }}"
  data-limit="{{ products_to_show }}"
  data-section-id="{{ section.id }}"
  data-url="{{ routes.product_recommendations_url }}"
  style="
    --hargx-recommendations-desktop-columns: {{ desktop_columns }};
    --hargx-recommendations-mobile-columns: {{ mobile_columns }};
    --hargx-recommendations-heading-alignment: {{ section.settings.heading_alignment }};
    --hargx-recommendations-spacing-top: {{ section.settings.section_spacing_top }}px;
    --hargx-recommendations-spacing-bottom: {{ section.settings.section_spacing_bottom }}px;
  "
>
  <div class="hargx-recommended-products__container page-width">

    <div
      class="hargx-recommended-products__content"
      data-hargx-recommendations-content
    >
      <div class="hargx-recommended-products__header">

        {%- if section.settings.heading != blank -%}
          <h2 class="hargx-recommended-products__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.subheading != blank -%}
          <div class="hargx-recommended-products__subheading">
            {{ section.settings.subheading }}
          </div>
        {%- endif -%}

      </div>

      <div
        class="hargx-recommended-products__grid"
        data-hargx-recommendations-grid
      >
        {%- for recommendation in recommendations.products -%}
          {% render 'hargx-product-card', product: recommendation %}
        {%- endfor -%}
      </div>

      {%- if section.settings.show_view_all -%}
        <div class="hargx-recommended-products__footer">
          <a
            href="{{ routes.all_products_collection_url }}"
            class="hargx-recommended-products__view-all"
          >
            {{ section.settings.view_all_text }}
          </a>
        </div>
      {%- endif -%}

    </div>

  </div>
</section>

{% schema %}
{
  "name": "Recommended Products",
  "tag": "section",
  "class": "section-hargx-recommended-products",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "You may also like"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading",
      "default": "<p>More products you might love.</p>"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        }
      ],
      "default": "left"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all link",
      "default": false
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all text",
      "default": "View all products"
    },
    {
      "type": "range",
      "id": "section_spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_spacing_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "HARGX Recommended Products"
    }
  ]
}
{% endschema %}