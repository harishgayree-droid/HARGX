{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'HargxProductForm-' | append: section.id
-%}

{{ 'hargx-product.css' | asset_url | stylesheet_tag }}

<section
  id="HargxProduct-{{ section.id }}"
  class="hargx-product"
  data-section-id="{{ section.id }}"
  data-product-id="{{ product.id }}"
>
  <div class="hargx-product__container page-width">

    <div class="hargx-product__layout">

      {%- comment -%}
        Product Media
        Step 4 me is gallery ko aur improve karenge.
      {%- endcomment -%}

      <div
        class="hargx-product__media"
        data-hargx-gallery
      >

        <div class="hargx-product__gallery">

          {%- comment -%}
            Main media viewer
          {%- endcomment -%}

          <div class="hargx-product__gallery-main">

            {%- for media in product.media -%}

              <div
                class="hargx-product__gallery-slide{% if forloop.first %} is-active{% endif %}"
                data-hargx-gallery-slide
                data-media-id="{{ media.id }}"
                data-media-index="{{ forloop.index0 }}"
              >

                {%- case media.media_type -%}

                  {%- when 'image' -%}

                    {{
                      media
                      | image_url: width: 2000
                      | image_tag:
                        loading: forloop.first | default: false,
                        widths: '600, 800, 1000, 1200, 1600, 2000',
                        sizes: '(min-width: 990px) 55vw, 100vw',
                        class: 'hargx-product__gallery-image',
                        alt: media.alt | escape
                    }}

                  {%- when 'video' -%}

                    {{
                      media
                      | video_tag:
                        controls: true,
                        autoplay: false,
                        loop: false,
                        muted: false,
                        class: 'hargx-product__gallery-video'
                    }}

                  {%- when 'external_video' -%}

                    <div class="hargx-product__gallery-external-video">
                      {{ media | external_video_tag }}
                    </div>

                  {%- when 'model' -%}

                    <div class="hargx-product__gallery-model">
                      {{ media | model_viewer_tag }}
                    </div>

                {%- endcase -%}

              </div>

            {%- endfor -%}

          </div>


          {%- comment -%}
            Previous / Next buttons
          {%- endcomment -%}

          {%- if product.media.size > 1 -%}

            <button
              type="button"
              class="hargx-product__gallery-button hargx-product__gallery-button--prev"
              data-hargx-gallery-prev
              aria-label="Previous product media"
            >
              <span aria-hidden="true">←</span>
            </button>

            <button
              type="button"
              class="hargx-product__gallery-button hargx-product__gallery-button--next"
              data-hargx-gallery-next
              aria-label="Next product media"
            >
              <span aria-hidden="true">→</span>
            </button>

          {%- endif -%}

        </div>


        {%- comment -%}
          Thumbnail navigation
        {%- endcomment -%}

        {%- if product.media.size > 1 -%}

          <div
            class="hargx-product__gallery-thumbnails"
            data-hargx-gallery-thumbnails
          >

            {%- for media in product.media -%}

              <button
                type="button"
                class="hargx-product__gallery-thumbnail{% if forloop.first %} is-active{% endif %}"
                data-hargx-gallery-thumbnail
                data-media-index="{{ forloop.index0 }}"
                data-media-id="{{ media.id }}"
                aria-label="View product media {{ forloop.index }}"
                aria-current="{% if forloop.first %}true{% else %}false{% endif %}"
              >

                {%- if media.preview_image -%}

                  {{
                    media.preview_image
                    | image_url: width: 240
                    | image_tag:
                      loading: 'lazy',
                      widths: '80, 120, 160, 240',
                      sizes: '80px',
                      class: 'hargx-product__gallery-thumbnail-image',
                      alt: media.alt | escape
                  }}

                {%- endif -%}

                {%- if media.media_type == 'video'
                  or media.media_type == 'external_video'
                -%}

                  <span
                    class="hargx-product__gallery-thumbnail-icon"
                    aria-hidden="true"
                  >
                    ▶
                  </span>

                {%- elsif media.media_type == 'model' -%}

                  <span
                    class="hargx-product__gallery-thumbnail-icon"
                    aria-hidden="true"
                  >
                    3D
                  </span>

                {%- endif -%}

              </button>

            {%- endfor -%}

          </div>

        {%- endif -%}

      </div>


      {%- comment -%}
        Product Information
        Everything inside this area is controlled by blocks.
      {%- endcomment -%}

      <div class="hargx-product__info">

        <div class="hargx-product__info-inner">

          {%- form 'product',
            product,
            id: product_form_id,
            class: 'hargx-product-form',
            data-product-form: ''
          -%}

            <input
              type="hidden"
              name="id"
              value="{{ current_variant.id }}"
              data-hargx-variant-id
            >

            <input
              type="hidden"
              name="quantity"
              value="1"
              data-hargx-hidden-quantity
            >


            {%- for block in section.blocks -%}

              {%- case block.type -%}

                {%- when 'vendor' -%}

                  <div
                    class="hargx-product__block hargx-product__vendor"
                    {{ block.shopify_attributes }}
                  >
                    {%- if product.vendor != blank -%}
                      {{ product.vendor }}
                    {%- endif -%}
                  </div>


                {%- when 'title' -%}

                  <div
                    class="hargx-product__block"
                    {{ block.shopify_attributes }}
                  >
                    <h1 class="hargx-product__title">
                      {{ product.title | escape }}
                    </h1>
                  </div>


                {%- when 'rating' -%}

                  {%- assign rating = product.metafields.reviews.rating.value -%}
                  {%- assign rating_count = product.metafields.reviews.rating_count -%}

                  {%- if rating != blank -%}

                    <div
                      class="hargx-product__block hargx-product__rating"
                      {{ block.shopify_attributes }}
                    >

                      <span
                        class="hargx-product__rating-stars"
                        aria-label="{{ rating }} out of 5 stars"
                      >
                        {%- for i in (1..5) -%}
                          {%- if rating >= i -%}
                            ★
                          {%- else -%}
                            ☆
                          {%- endif -%}
                        {%- endfor -%}
                      </span>

                      {%- if rating_count != blank -%}
                        <span class="hargx-product__rating-count">
                          {{ rating_count }}
                        </span>
                      {%- endif -%}

                    </div>

                  {%- endif -%}


                {%- when 'sku' -%}

                  {%- if current_variant.sku != blank -%}

                    <div
                      class="hargx-product__block hargx-product__sku"
                      {{ block.shopify_attributes }}
                    >
                      <span class="hargx-product__sku-label">
                        SKU:
                      </span>

                      <span data-hargx-sku>
                        {{ current_variant.sku }}
                      </span>
                    </div>

                  {%- endif -%}


                {%- when 'price' -%}

                  <div
                    class="hargx-product__block hargx-product__price"
                    data-hargx-price
                    {{ block.shopify_attributes }}
                  >

                    <span
                      class="hargx-product__price-current"
                      data-hargx-current-price
                    >
                      {{ current_variant.price | money }}
                    </span>

                    {%- if current_variant.compare_at_price > current_variant.price -%}

                      <span
                        class="hargx-product__price-compare"
                        data-hargx-compare-price
                      >
                        {{ current_variant.compare_at_price | money }}
                      </span>

                      <span
                        class="hargx-product__price-badge"
                        data-hargx-sale-badge
                      >
                        Sale
                      </span>

                    {%- else -%}

                      <span
                        class="hargx-product__price-compare"
                        data-hargx-compare-price
                        hidden
                      ></span>

                      <span
                        class="hargx-product__price-badge"
                        data-hargx-sale-badge
                        hidden
                      >
                        Sale
                      </span>

                    {%- endif -%}

                  </div>


                {%- when 'description' -%}

                  {%- if product.description != blank -%}

                    <div
                      class="hargx-product__block hargx-product__description rte"
                      {{ block.shopify_attributes }}
                    >
                      {{ product.description }}
                    </div>

                  {%- endif -%}


                {%- when 'variant_picker' -%}

                  {%- unless product.has_only_default_variant -%}

                    <div
                      class="hargx-product__block hargx-product__variants"
                      data-hargx-variants
                      {{ block.shopify_attributes }}
                    >

                      {%- for option in product.options_with_values -%}

                        <fieldset
                          class="hargx-product__option"
                          data-option-position="{{ option.position }}"
                        >

                          <legend class="hargx-product__option-label">
                            {{ option.name }}
                          </legend>

                          <div class="hargx-product__option-values">

                            {%- for value in option.values -%}

                              {%- assign option_id = 'HargxOption-' | append: section.id | append: '-' | append: option.position | append: '-' | append: forloop.index -%}

                              <input
                                type="radio"
                                id="{{ option_id }}"
                                name="options[{{ option.name | escape }}]"
                                value="{{ value | escape }}"
                                class="hargx-product__option-input"
                                data-hargx-option
                                data-option-position="{{ option.position }}"
                                {% if option.selected_value == value %}
                                  checked
                                {% endif %}
                              >

                              <label
                                for="{{ option_id }}"
                                class="hargx-product__option-value"
                              >
                                {{ value }}
                              </label>

                            {%- endfor -%}

                          </div>

                        </fieldset>

                      {%- endfor -%}

                    </div>

                  {%- endunless -%}


                {%- when 'quantity' -%}

                  <div
                    class="hargx-product__block hargx-product__quantity"
                    {{ block.shopify_attributes }}
                  >

                    <label
                      class="hargx-product__quantity-label"
                      for="HargxQuantity-{{ section.id }}"
                    >
                      {{ block.settings.label }}
                    </label>

                    <div class="hargx-product__quantity-control">

                      <button
                        type="button"
                        class="hargx-product__quantity-button"
                        data-hargx-quantity-minus
                        aria-label="Decrease quantity"
                      >
                        −
                      </button>

                      <input
                        id="HargxQuantity-{{ section.id }}"
                        class="hargx-product__quantity-input"
                        type="number"
                        name="quantity"
                        min="1"
                        value="1"
                        data-hargx-quantity
                      >

                      <button
                        type="button"
                        class="hargx-product__quantity-button"
                        data-hargx-quantity-plus
                        aria-label="Increase quantity"
                      >
                        +
                      </button>

                    </div>

                  </div>


                {%- when 'inventory_status' -%}

                  <div
                    class="hargx-product__block hargx-product__inventory"
                    data-hargx-inventory
                    {{ block.shopify_attributes }}
                  >

                    {%- if current_variant.available -%}

                      {%- if current_variant.inventory_management == 'shopify'
                        and current_variant.inventory_quantity > 0
                        and current_variant.inventory_quantity <= block.settings.low_stock_threshold
                      -%}

                        <span>
                          Only {{ current_variant.inventory_quantity }}
                          left in stock
                        </span>

                      {%- else -%}

                        <span>
                          {{ block.settings.in_stock_text }}
                        </span>

                      {%- endif -%}

                    {%- else -%}

                      <span>
                        {{ block.settings.out_of_stock_text }}
                      </span>

                    {%- endif -%}

                  </div>


                {%- when 'buy_buttons' -%}

                  <div
                    class="hargx-product__block hargx-product__buy-buttons"
                    {{ block.shopify_attributes }}
                  >

                    <button
                      type="submit"
                      name="add"
                      class="hargx-product__add-to-cart"
                      data-hargx-add-to-cart
                      {% unless current_variant.available %}
                        disabled
                      {% endunless %}
                    >

                      <span data-hargx-add-text>
                        {%- if current_variant.available -%}
                          {{ block.settings.add_to_cart_text }}
                        {%- else -%}
                          {{ block.settings.sold_out_text }}
                        {%- endif -%}
                      </span>

                    </button>

                    {%- if block.settings.show_dynamic_checkout -%}

                      <div class="hargx-product__buy-now">
                        {{ form | payment_button }}
                      </div>

                    {%- endif -%}

                  </div>


                {%- when 'trust_item' -%}

                  <div
                    class="hargx-product__block hargx-product__trust"
                    {{ block.shopify_attributes }}
                  >

                    <div class="hargx-product__trust-item">

                      {%- if block.settings.icon != blank -%}
                        <span class="hargx-product__trust-icon">
                          {{ block.settings.icon }}
                        </span>
                      {%- endif -%}

                      <span class="hargx-product__trust-text">
                        {{ block.settings.text }}
                      </span>

                    </div>

                  </div>


                {%- when 'collapsible_tab' -%}

                  <details
                    class="hargx-product__block hargx-product__collapsible"
                    {{ block.shopify_attributes }}
                  >

                    <summary>
                      <span>
                        {{ block.settings.heading }}
                      </span>

                      <span aria-hidden="true">
                        +
                      </span>
                    </summary>

                    <div class="hargx-product__collapsible-content rte">
                      {{ block.settings.content }}
                    </div>

                  </details>


                {%- when 'share' -%}

                  <div
                    class="hargx-product__block hargx-product__share"
                    {{ block.shopify_attributes }}
                  >

                    <span>
                      {{ block.settings.heading }}
                    </span>

                    <button
                      type="button"
                      data-hargx-share
                    >
                      {{ block.settings.button_text }}
                    </button>

                  </div>


                {%- when 'custom_liquid' -%}

                  <div
                    class="hargx-product__block"
                    {{ block.shopify_attributes }}
                  >
                    {{ block.settings.custom_liquid }}
                  </div>


                  {%- when 'complementary_products' -%}

                    {%- assign complementary_products = block.settings.products -%}

                    {%- if complementary_products != blank -%}
                      <div
                        class="hargx-complementary-products"
                        data-hargx-complementary-products
                        {{ block.shopify_attributes }}
                      >
                        {%- if block.settings.heading != blank -%}
                          <div class="hargx-complementary-products__header">
                            <h3 class="hargx-complementary-products__heading">
                              {{ block.settings.heading }}
                            </h3>

                            {%- if block.settings.subheading != blank -%}
                              <div class="hargx-complementary-products__subheading">
                                {{ block.settings.subheading }}
                              </div>
                            {%- endif -%}
                          </div>
                        {%- endif -%}

                        <div
                          class="hargx-complementary-products__list"
                          data-hargx-complementary-list
                        >
                          {%- for complementary_product in complementary_products -%}

                            {%- if complementary_product.id != product.id -%}

                              <article
                                class="hargx-complementary-product"
                                data-complementary-product
                                data-product-id="{{ complementary_product.id }}"
                              >

                                <a
                                  href="{{ complementary_product.url }}"
                                  class="hargx-complementary-product__image-link"
                                  aria-label="{{ complementary_product.title | escape }}"
                                >
                                  {%- if complementary_product.featured_image != blank -%}
                                    {{
                                      complementary_product.featured_image
                                      | image_url: width: 300
                                      | image_tag:
                                        loading: 'lazy',
                                        widths: '120,180,240,300',
                                        sizes: '90px',
                                        class: 'hargx-complementary-product__image'
                                    }}
                                  {%- else -%}
                                    <div class="hargx-complementary-product__image hargx-complementary-product__image--placeholder">
                                      {{ 'product-1' | placeholder_svg_tag }}
                                    </div>
                                  {%- endif -%}
                                </a>

                                <div class="hargx-complementary-product__info">

                                  <a
                                    href="{{ complementary_product.url }}"
                                    class="hargx-complementary-product__title"
                                  >
                                    {{ complementary_product.title }}
                                  </a>

                                  {%- if block.settings.show_price -%}
                                    <div class="hargx-complementary-product__price">
                                      {%- if complementary_product.compare_at_price > complementary_product.price -%}
                                        <span class="hargx-complementary-product__price--sale">
                                          {{ complementary_product.price | money }}
                                        </span>

                                        <span class="hargx-complementary-product__price--compare">
                                          {{ complementary_product.compare_at_price | money }}
                                        </span>
                                      {%- else -%}
                                        <span>
                                          {{ complementary_product.price | money }}
                                        </span>
                                      {%- endif -%}
                                    </div>
                                  {%- endif -%}

                                  {%- if complementary_product.available -%}

                                    {%- if complementary_product.has_only_default_variant -%}

                                      <button
                                        type="button"
                                        class="hargx-complementary-product__add"
                                        data-complementary-add
                                        data-variant-id="{{ complementary_product.selected_or_first_available_variant.id }}"
                                        aria-label="Add {{ complementary_product.title | escape }} to cart"
                                      >
                                        {{ block.settings.button_text }}
                                      </button>

                                    {%- else -%}

                                      <a
                                        href="{{ complementary_product.url }}"
                                        class="hargx-complementary-product__add"
                                      >
                                        {{ block.settings.select_options_text }}
                                      </a>

                                    {%- endif -%}

                                  {%- else -%}

                                    <span class="hargx-complementary-product__sold-out">
                                      {{ 'products.product.sold_out' | t }}
                                    </span>

                                  {%- endif -%}

                                </div>

                              </article>

                            {%- endif -%}

                          {%- endfor -%}
                        </div>
                      </div>
                    {%- endif -%}

              {%- endcase -%}

            {%- endfor -%}

          {%- endform -%}

        </div>
      </div>

    </div>
  </div>


  {%- comment -%}
    Product data used by hargx-product.js
  {%- endcomment -%}

  <script
    type="application/json"
    data-hargx-product-data
  >
    {
      "productId": {{ product.id | json }},
      "selectedVariantId": {{ current_variant.id | json }},
      "variants": [
        {%- for variant in product.variants -%}
          {
            "id": {{ variant.id | json }},
            "available": {{ variant.available | json }},
            "price": {{ variant.price | json }},
            "compare_at_price": {{ variant.compare_at_price | default: 0 | json }},
            "sku": {{ variant.sku | json }},
            "inventory_quantity": {{ variant.inventory_quantity | json }},
            "inventory_management": {{ variant.inventory_management | json }},
            "options": {{ variant.options | json }}
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>

</section>


{% schema %}
{
  "name": "HARGX Product",
  "settings": [],
  "blocks": [
    {
      "type": "vendor",
      "name": "Vendor",
      "limit": 1,
      "settings": []
    },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "rating",
      "name": "Rating",
      "limit": 1,
      "settings": []
    },
    {
      "type": "sku",
      "name": "SKU",
      "limit": 1,
      "settings": []
    },
    {
      "type": "price",
      "name": "Price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": []
    },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": []
    },
    {
      "type": "quantity",
      "name": "Quantity",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Quantity"
        }
      ]
    },
    {
      "type": "inventory_status",
      "name": "Inventory status",
      "limit": 1,
      "settings": [
        {
          "type": "range",
          "id": "low_stock_threshold",
          "label": "Low stock threshold",
          "min": 1,
          "max": 20,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "in_stock_text",
          "label": "In stock text",
          "default": "In stock"
        },
        {
          "type": "text",
          "id": "out_of_stock_text",
          "label": "Out of stock text",
          "default": "Out of stock"
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "add_to_cart_text",
          "label": "Add to cart text",
          "default": "Add to cart"
        },
        {
          "type": "text",
          "id": "sold_out_text",
          "label": "Sold out text",
          "default": "Sold out"
        },
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout button",
          "default": true
        }
      ]
    },
    {
      "type": "trust_item",
      "name": "Trust item",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "✓"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Secure checkout"
        }
      ]
    },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Product information"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content",
          "default": "<p>Add your product information here.</p>"
        }
      ]
    },
    {
      "type": "share",
      "name": "Share",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Share"
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Button text",
          "default": "Share product"
        }
      ]
    },
    {
      "type": "custom_liquid",
      "name": "Custom Liquid",
      "settings": [
        {
          "type": "liquid",
          "id": "custom_liquid",
          "label": "Custom Liquid"
        }
      ]
    },
    {
      "type": "complementary_products",
      "name": "Complementary products",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Complete the look"
        },
        {
          "type": "richtext",
          "id": "subheading",
          "label": "Subheading",
          "default": "<p>Pair it with these products.</p>"
        },
        {
          "type": "product_list",
          "id": "products",
          "label": "Products",
          "limit": 4
        },
        {
          "type": "checkbox",
          "id": "show_price",
          "label": "Show price",
          "default": true
        },
        {
          "type": "text",
          "id": "button_text",
          "label": "Add button text",
          "default": "Add"
        },
        {
          "type": "text",
          "id": "select_options_text",
          "label": "Select options text",
          "default": "Select options"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HARGX Product",
      "blocks": [
        {
          "type": "vendor"
        },
        {
          "type": "title"
        },
        {
          "type": "rating"
        },
