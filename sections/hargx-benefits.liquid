{% comment %}
  HARGX - Benefits / USP Section
  Flexible icon/image based benefits grid.
{% endcomment %}

{%- liquid
  assign section_id = 'HargxBenefits-' | append: section.id
-%}
{{ 'benefits.css' | asset_url | stylesheet_tag }}

<section
  id="{{ section_id }}"
  class="hargx-benefits hargx-benefits--{{ section.settings.layout_style }}"
  style="
    --hargx-benefits-background-setting: {{ section.settings.background_color }};
    --hargx-benefits-text-setting: {{ section.settings.text_color }};
    --hargx-benefits-padding-top: {{ section.settings.padding_top }}px;
    --hargx-benefits-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hargx-benefits-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --hargx-benefits-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="hargx-benefits__container page-width">

    {%- if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.description != blank
    -%}

      <div class="hargx-benefits__header hargx-benefits__header--{{ section.settings.text_alignment }}">

        {%- if section.settings.eyebrow != blank -%}
          <p class="hargx-benefits__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="hargx-benefits__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="hargx-benefits__intro">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

      </div>

    {%- endif -%}

    <div
      class="
        hargx-benefits__grid
        hargx-benefits__grid--{{ section.settings.columns_desktop }}
        hargx-benefits__grid-mobile--{{ section.settings.columns_mobile }}
      "
    >

      {%- for block in section.blocks -%}

        <div
          class="hargx-benefit"
          {{ block.shopify_attributes }}
        >

          <div class="hargx-benefit__icon">

            {%- if block.settings.image != blank -%}

              {{
                block.settings.image
                | image_url: width: 160
                | image_tag:
                  loading: 'lazy',
                  widths: '80, 120, 160',
                  sizes: '80px',
                  class: 'hargx-benefit__image',
                  alt: block.settings.title | escape
              }}

            {%- else -%}

              {%- case block.settings.icon -%}

                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M3 6.5H14V17.5H3V6.5Z" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M14 10H18L21 13.5V17.5H14V10Z" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="7" cy="18" r="2" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="18" cy="18" r="2" stroke="currentColor" stroke-width="1.5"/>
                  </svg>

                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3L19 6V11.5C19 16.2 16.15 19.55 12 21C7.85 19.55 5 16.2 5 11.5V6L12 3Z" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8.5 12L10.8 14.2L15.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>

                {%- when 'refresh' -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M20 11C19.5 6.8 16.1 4 12 4C8.5 4 5.5 6.1 4.3 9.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M4 5V9.5H8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M4 13C4.5 17.2 7.9 20 12 20C15.5 20 18.5 17.9 19.7 14.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M20 19V14.5H15.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>

                {%- when 'lock' -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="5" y="10" width="14" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8 10V7.5C8 5.3 9.8 3.5 12 3.5C14.2 3.5 16 5.3 16 7.5V10" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="12" cy="15.5" r="1" fill="currentColor"/>
                  </svg>

                {%- when 'heart' -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M20.8 8.8C20.8 14 12 20 12 20S3.2 14 3.2 8.8C3.2 5.9 5.4 4 8 4C9.7 4 11.2 4.8 12 6.1C12.8 4.8 14.3 4 16 4C18.6 4 20.8 5.9 20.8 8.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  </svg>

                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3.8L14.5 8.9L20.1 9.7L16 13.7L17 19.3L12 16.6L7 19.3L8 13.7L3.9 9.7L9.5 8.9L12 3.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  </svg>

                {%- when 'support' -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 13V11C4 6.6 7.6 3 12 3C16.4 3 20 6.6 20 11V13" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M4 12H7V18H5.5C4.7 18 4 17.3 4 16.5V12Z" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M20 12H17V18H18.5C19.3 18 20 17.3 20 16.5V12Z" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M17 18C16.2 20 14.5 21 12 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>

                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M12 8V16M8 12H16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>

              {%- endcase -%}

            {%- endif -%}

          </div>

          <div class="hargx-benefit__content">

            {%- if block.settings.title != blank -%}
              <h3 class="hargx-benefit__title">
                {{ block.settings.title }}
              </h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="hargx-benefit__description">
                {{ block.settings.description }}
              </div>
            {%- endif -%}

            {%- if block.settings.link != blank and block.settings.link_text != blank -%}
              <a
                href="{{ block.settings.link }}"
                class="hargx-benefit__link"
              >
                {{ block.settings.link_text }}

                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M2.5 8H13.5M13.5 8L9.5 4M13.5 8L9.5 12"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            {%- endif -%}

          </div>

        </div>

      {%- endfor -%}

    </div>

  </div>
</section>


{% schema %}
{
  "name": "HARGX Benefits",
  "tag": "section",
  "class": "section-hargx-benefits",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Why shop with us"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Made for a better shopping experience"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Thoughtful details from checkout to delivery.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        },
        {
          "value": "5",
          "label": "5 columns"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "options": [
        {
          "value": "default",
          "label": "Minimal"
        },
        {
          "value": "cards",
          "label": "Cards"
        }
      ],
      "default": "default"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF8F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "truck",
              "label": "Shipping"
            },
            {
              "value": "shield",
              "label": "Protection"
            },
            {
              "value": "refresh",
              "label": "Returns"
            },
            {
              "value": "lock",
              "label": "Secure"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "support",
              "label": "Support"
            }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon image",
          "info": "If selected, this replaces the icon above."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Fast & reliable shipping"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Carefully packed and shipped with tracking."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Learn more"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HARGX Benefits",
      "blocks": [
        {
          "type": "benefit",
          "settings": {
            "icon": "truck",
            "title": "Fast & reliable shipping",
            "description": "Carefully packed and shipped with tracking."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "shield",
            "title": "Shop with confidence",
            "description": "Secure shopping from start to finish."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "refresh",
            "title": "Easy returns",
            "description": "A simple and straightforward return experience."
          }
        },
        {
          "type": "benefit",
          "settings": {
            "icon": "support",
            "title": "Here when you need us",
            "description": "Get helpful support whenever you need it."
          }
        }
      ]
    }
  ]
}
{% endschema %}