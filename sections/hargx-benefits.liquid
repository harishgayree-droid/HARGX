{% comment %}
  HARGX - Benefits / USP Section
  Flexible icon/image based benefits grid.
{% endcomment %}

{%- liquid
  assign section_id = 'HargxBenefits-' | append: section.id
-%}

<section
  id="{{ section_id }}"
  class="hargx-benefits hargx-benefits--{{ section.settings.layout_style }}"
>
  <div class="hargx-benefits__container page-width">

    {%- if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.description != blank
    -%}

      <div class="hargx-benefits__header hargx-benefits__header--{{ section.settings.text_alignment }}">

        {%- if section.settings.eyebrow != blank -%}
          <p class="hargx-benefits__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="hargx-benefits__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="hargx-benefits__intro">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

      </div>

    {%- endif -%}

    <div
      class="
        hargx-benefits__grid
        hargx-benefits__grid--{{ section.settings.columns_desktop }}
        hargx-benefits__grid-mobile--{{ section.settings.columns_mobile }}
      "
    >

      {%- for block in section.blocks -%}

        <div
          class="hargx-benefit"
          {{ block.shopify_attributes }}
        >

          <div class="hargx-benefit__icon">

            {%- if block.settings.image != blank -%}

              {{
                block.settings.image
                | image_url: width: 160
                | image_tag:
                  loading: 'lazy',
                  widths: '80, 120, 160',
                  sizes: '80px',
                  class: 'hargx-benefit__image',
                  alt: block.settings.title | escape
              }}

            {%- else -%}

              {%- case block.settings.icon -%}

                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M3 6.5H14V17.5H3V6.5Z" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M14 10H18L21 13.5V17.5H14V10Z" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="7" cy="18" r="2" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="18" cy="18" r="2" stroke="currentColor" stroke-width="1.5"/>
                  </svg>

                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3L19 6V11.5C19 16.2 16.15 19.55 12 21C7.85 19.55 5 16.2 5 11.5V6L12 3Z" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8.5 12L10.8 14.2L15.5 9.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>

                {%- when 'refresh' -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M20 11C19.5 6.8 16.1 4 12 4C8.5 4 5.5 6.1 4.3 9.2" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M4 5V9.5H8.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                    <path d="M4 13C4.5 17.2 7.9 20 12 20C15.5 20 18.5 17.9 19.7 14.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                    <path d="M20 19V14.5H15.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>

                {%- when 'lock' -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <rect x="5" y="10" width="14" height="11" rx="1.5" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M8 10V7.5C8 5.3 9.8 3.5 12 3.5C14.2 3.5 16 5.3 16 7.5V10" stroke="currentColor" stroke-width="1.5"/>
                    <circle cx="12" cy="15.5" r="1" fill="currentColor"/>
                  </svg>

                {%- when 'heart' -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M20.8 8.8C20.8 14 12 20 12 20S3.2 14 3.2 8.8C3.2 5.9 5.4 4 8 4C9.7 4 11.2 4.8 12 6.1C12.8 4.8 14.3 4 16 4C18.6 4 20.8 5.9 20.8 8.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  </svg>

                {%- when 'star' -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M12 3.8L14.5 8.9L20.1 9.7L16 13.7L17 19.3L12 16.6L7 19.3L8 13.7L3.9 9.7L9.5 8.9L12 3.8Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
                  </svg>

                {%- when 'support' -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <path d="M4 13V11C4 6.6 7.6 3 12 3C16.4 3 20 6.6 20 11V13" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M4 12H7V18H5.5C4.7 18 4 17.3 4 16.5V12Z" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M20 12H17V18H18.5C19.3 18 20 17.3 20 16.5V12Z" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M17 18C16.2 20 14.5 21 12 21" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>

                {%- else -%}
                  <svg viewBox="0 0 24 24" fill="none" aria-hidden="true">
                    <circle cx="12" cy="12" r="8.5" stroke="currentColor" stroke-width="1.5"/>
                    <path d="M12 8V16M8 12H16" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/>
                  </svg>

              {%- endcase -%}

            {%- endif -%}

          </div>

          <div class="hargx-benefit__content">

            {%- if block.settings.title != blank -%}
              <h3 class="hargx-benefit__title">
                {{ block.settings.title }}
              </h3>
            {%- endif -%}

            {%- if block.settings.description != blank -%}
              <div class="hargx-benefit__description">
                {{ block.settings.description }}
              </div>
            {%- endif -%}

            {%- if block.settings.link != blank and block.settings.link_text != blank -%}
              <a
                href="{{ block.settings.link }}"
                class="hargx-benefit__link"
              >
                {{ block.settings.link_text }}

                <svg
                  width="16"
                  height="16"
                  viewBox="0 0 16 16"
                  fill="none"
                  aria-hidden="true"
                >
                  <path
                    d="M2.5 8H13.5M13.5 8L9.5 4M13.5 8L9.5 12"
                    stroke="currentColor"
                    stroke-width="1.4"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
              </a>
            {%- endif -%}

          </div>

        </div>

      {%- endfor -%}

    </div>

  </div>
</section>

<style>
  #{{ section_id }} {
    --hargx-benefits-bg: {{ section.settings.background_color }};
    --hargx-benefits-text: {{ section.settings.text_color }};
    --hargx-benefits-accent: #FE7442;
    --hargx-benefits-border: rgba(0, 0, 0, 0.10);

    background-color: var(--hargx-benefits-bg);
    color: var(--hargx-benefits-text);
  }

  #{{ section_id }} .hargx-benefits__container {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  /* Header */

  #{{ section_id }} .hargx-benefits__header {
    max-width: 720px;
    margin-bottom: 48px;
  }

  #{{ section_id }} .hargx-benefits__header--left {
    text-align: left;
    margin-right: auto;
  }

  #{{ section_id }} .hargx-benefits__header--center {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  #{{ section_id }} .hargx-benefits__header--right {
    text-align: right;
    margin-left: auto;
  }

  #{{ section_id }} .hargx-benefits__eyebrow {
    margin: 0 0 10px;
    color: var(--hargx-benefits-accent);
    font-size: 12px;
    font-weight: 700;
    line-height: 1.4;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #{{ section_id }} .hargx-benefits__heading {
    margin: 0;
    color: var(--hargx-benefits-text);
    font-size: clamp(30px, 4vw, 46px);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: -0.035em;
  }

  #{{ section_id }} .hargx-benefits__intro {
    margin-top: 14px;
    color: var(--hargx-benefits-text);
    opacity: 0.65;
    font-size: 15px;
    line-height: 1.7;
  }

  #{{ section_id }} .hargx-benefits__intro p {
    margin: 0;
  }

  /* Grid */

  #{{ section_id }} .hargx-benefits__grid {
    display: grid;
    gap: 0;
  }

  #{{ section_id }} .hargx-benefits__grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  #{{ section_id }} .hargx-benefits__grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  #{{ section_id }} .hargx-benefits__grid--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  #{{ section_id }} .hargx-benefits__grid--5 {
    grid-template-columns: repeat(5, minmax(0, 1fr));
  }

  /* Benefit */

  #{{ section_id }} .hargx-benefit {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 10px 34px;
    border-right: 1px solid var(--hargx-benefits-border);
  }

  #{{ section_id }} .hargx-benefit:first-child {
    padding-left: 0;
  }

  #{{ section_id }} .hargx-benefit:last-child {
    padding-right: 0;
    border-right: 0;
  }

  #{{ section_id }} .hargx-benefit__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin-bottom: 20px;
    color: var(--hargx-benefits-accent);
    background: rgba(254, 116, 66, 0.08);
    border-radius: 50%;
    flex-shrink: 0;
  }

  #{{ section_id }} .hargx-benefit__icon svg {
    width: 23px;
    height: 23px;
  }

  #{{ section_id }} .hargx-benefit__image {
    display: block;
    width: 23px;
    height: 23px;
    object-fit: contain;
  }

  #{{ section_id }} .hargx-benefit__title {
    margin: 0;
    color: var(--hargx-benefits-text);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
  }

  #{{ section_id }} .hargx-benefit__description {
    max-width: 260px;
    margin-top: 8px;
    color: var(--hargx-benefits-text);
    opacity: 0.62;
    font-size: 13px;
    line-height: 1.6;
  }

  #{{ section_id }} .hargx-benefit__link {
    display: inline-flex;
    align-items: center;
    gap: 5px;
    margin-top: 13px;
    color: var(--hargx-benefits-text);
    font-size: 11px;
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    text-decoration: none;
    transition: color 0.25s ease;
  }

  #{{ section_id }} .hargx-benefit__link svg {
    transition: transform 0.25s ease;
  }

  #{{ section_id }} .hargx-benefit__link:hover {
    color: var(--hargx-benefits-accent);
  }

  #{{ section_id }} .hargx-benefit__link:hover svg {
    transform: translateX(4px);
  }

  /* Card layout */

  #{{ section_id }}.hargx-benefits--cards .hargx-benefit {
    margin: 6px;
    padding: 30px;
    border: 1px solid var(--hargx-benefits-border);
    background: rgba(255, 255, 255, 0.45);
  }

  #{{ section_id }}.hargx-benefits--cards .hargx-benefit:first-child,
  #{{ section_id }}.hargx-benefits--cards .hargx-benefit:last-child {
    padding-left: 30px;
    padding-right: 30px;
  }

  @media screen and (max-width: 989px) {
    #{{ section_id }} .hargx-benefits__grid--5 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    #{{ section_id }} .hargx-benefit {
      padding-left: 24px;
      padding-right: 24px;
    }
  }

  @media screen and (max-width: 749px) {
    #{{ section_id }} .hargx-benefits__container {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #{{ section_id }} .hargx-benefits__header {
      margin-bottom: 32px;
    }

    #{{ section_id }} .hargx-benefits__grid-mobile--1 {
      grid-template-columns: 1fr;
    }

    #{{ section_id }} .hargx-benefits__grid-mobile--2 {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    #{{ section_id }} .hargx-benefit {
      padding: 20px 16px;
      border-right: 0;
      border-bottom: 1px solid var(--hargx-benefits-border);
    }

    #{{ section_id }} .hargx-benefit:first-child {
      padding-left: 16px;
    }

    #{{ section_id }} .hargx-benefit:last-child {
      padding-right: 16px;
      border-bottom: 0;
    }

    #{{ section_id }} .hargx-benefit__icon {
      width: 42px;
      height: 42px;
      margin-bottom: 15px;
    }

    #{{ section_id }} .hargx-benefit__icon svg {
      width: 20px;
      height: 20px;
    }

    #{{ section_id }} .hargx-benefit__image {
      width: 20px;
      height: 20px;
    }

    #{{ section_id }} .hargx-benefit__title {
      font-size: 15px;
    }

    #{{ section_id }} .hargx-benefit__description {
      font-size: 12px;
    }

    #{{ section_id }}.hargx-benefits--cards .hargx-benefit {
      margin: 4px;
      padding: 22px 18px;
    }

    #{{ section_id }}.hargx-benefits--cards .hargx-benefit:first-child,
    #{{ section_id }}.hargx-benefits--cards .hargx-benefit:last-child {
      padding-left: 18px;
      padding-right: 18px;
    }
  }
</style>

{% schema %}
{
