<section class="hargx-split-feature-test">
  <div class="page-width">
    <h2>{{ section.settings.heading }}</h2>
    <p>{{ section.settings.text }}</p>
  </div>
</section>

{% schema %}
{
  "name": "HARGX Split Feature",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for the way you live"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Text",
      "default": "Thoughtfully designed products for everyday life."
    }
  ],
  "presets": [
    {
      "name": "HARGX Split Feature"
    }
  ]
}
{% endschema %}