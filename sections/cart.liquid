{% comment %}
  HARGX Cart
  Main cart section for the /cart page.
{% endcomment %}

<div
  class="hargx-cart"
  data-hargx-cart
>

  <div class="hargx-cart__container">

    {%- if cart.item_count > 0 -%}

      <!-- Cart Header -->

      <header class="hargx-cart__header">

        <div class="hargx-cart__header-content">

          <h1 class="hargx-cart__title">
            {{ 'cart.title' | t }}
          </h1>

          <span class="hargx-cart__count">
            {{ cart.item_count }}
            {% if cart.item_count == 1 %}
              item
            {% else %}
              items
            {% endif %}
          </span>

        </div>

      </header>


      <!-- Cart Form -->

      <form
        action="{{ routes.cart_url }}"
        method="post"
        id="HargxCartForm"
        class="hargx-cart__form"
      >

        <div class="hargx-cart__layout">


          <!-- Cart Items -->

          <div class="hargx-cart__items">

            <div class="hargx-cart__items-header">

              <span>
                Products
              </span>

              <span>
                Total
              </span>

            </div>


            <div class="hargx-cart__items-list">

              {%- for item in cart.items -%}

                <article
                  class="hargx-cart-item"
                  data-hargx-cart-item
                  data-line="{{ forloop.index }}"
                >

                  <!-- Product Image -->

                  <a
                    href="{{ item.url }}"
                    class="hargx-cart-item__image"
                    aria-label="{{ item.product.title | escape }}"
                  >

                    {%- if item.image != blank -%}

                      {{
                        item.image
                        | image_url: width: 500
                        | image_tag:
                          loading: 'lazy',
                          widths: '180,250,350,500',
                          sizes: '(min-width: 990px) 180px, 120px',
                          alt: item.product.title
                      }}

                    {%- else -%}

                      {{ 'product-1' | placeholder_svg_tag }}

                    {%- endif -%}

                  </a>


                  <!-- Product Information -->

                  <div class="hargx-cart-item__content">

                    <div class="hargx-cart-item__details">

                      <a
                        href="{{ item.url }}"
                        class="hargx-cart-item__title"
                      >
                        {{ item.product.title }}
                      </a>


                      {%- unless item.product.has_only_default_variant -%}

                        <div class="hargx-cart-item__variant">
                          {{ item.variant.title }}
                        </div>

                      {%- endunless -%}


                      {%- if item.properties != blank -%}

                        <div class="hargx-cart-item__properties">

                          {%- for property in item.properties -%}

                            {%- assign property_first_char = property.first | slice: 0 -%}

                            {%- unless property.last == blank or property_first_char == '_' -%}

                              <div class="hargx-cart-item__property">

                                <span class="hargx-cart-item__property-name">
                                  {{ property.first }}:
                                </span>

                                <span class="hargx-cart-item__property-value">
                                  {{ property.last }}
                                </span>

                              </div>

                            {%- endunless -%}

                          {%- endfor -%}

                        </div>

                      {%- endif -%}


                      <!-- Mobile Price -->

                      <div class="hargx-cart-item__mobile-price">

                        {{ item.final_line_price | money }}

                      </div>

                    </div>


                    <!-- Quantity + Remove -->

                    <div class="hargx-cart-item__actions">

                      <div
                        class="hargx-cart-item__quantity"
                        data-hargx-quantity
                      >

                        <button
                          type="button"
                          class="hargx-cart-item__quantity-button"
                          data-hargx-quantity-minus
                          aria-label="Decrease quantity of {{ item.product.title | escape }}"
                        >
                          −
                        </button>

                        <input
                          type="number"
                          name="updates[]"
                          value="{{ item.quantity }}"
                          min="0"
                          step="1"
                          class="hargx-cart-item__quantity-input"
                          data-hargx-quantity-input
                          aria-label="Quantity of {{ item.product.title | escape }}"
                        >

                        <button
                          type="button"
                          class="hargx-cart-item__quantity-button"
                          data-hargx-quantity-plus
                          aria-label="Increase quantity of {{ item.product.title | escape }}"
                        >
                          +
                        </button>

                      </div>


                      <a
                        href="{{ item.url_to_remove }}"
                        class="hargx-cart-item__remove"
                        data-hargx-remove
                      >
                        Remove
                      </a>

                    </div>

                  </div>


                  <!-- Desktop Line Price -->

                  <div class="hargx-cart-item__price">

                    {%- if item.original_line_price > item.final_line_price -%}

                      <span class="hargx-cart-item__price--sale">
                        {{ item.final_line_price | money }}
                      </span>

                      <span class="hargx-cart-item__price--compare">
                        {{ item.original_line_price | money }}
                      </span>

                    {%- else -%}

                      <span>
                        {{ item.final_line_price | money }}
                      </span>

                    {%- endif -%}

                  </div>

                </article>

              {%- endfor -%}

            </div>


            <!-- Continue Shopping -->

            <div class="hargx-cart__continue">

              <a
                href="{{ routes.all_products_collection_url }}"
                class="hargx-cart__continue-link"
              >
                <span aria-hidden="true">←</span>
                Continue shopping
              </a>

            </div>

          </div>


          <!-- Cart Summary -->

          <aside class="hargx-cart__summary">

            <div class="hargx-cart__summary-inner">

              <h2 class="hargx-cart__summary-title">
                Order summary
              </h2>


              <div class="hargx-cart__summary-row">

                <span>
                  Subtotal
                </span>

                <span>
                  {{ cart.total_price | money }}
                </span>

              </div>

              {%- if section.settings.show_free_shipping_bar -%}

                {%- assign shipping_threshold = section.settings.free_shipping_threshold | times: 100 -%}
                {%- assign shipping_remaining = shipping_threshold | minus: cart.total_price -%}

                {%- if shipping_remaining > 0 -%}
                  {%- assign shipping_progress = cart.total_price | times: 100.0 | divided_by: shipping_threshold -%}
                {%- else -%}
                  {%- assign shipping_progress = 100 -%}
                {%- endif -%}

                <div
                  class="hargx-cart__shipping-progress"
                  data-hargx-shipping-progress
                  data-threshold="{{ shipping_threshold }}"
                >

                  <div class="hargx-cart__shipping-message">

                    {%- if shipping_remaining > 0 -%}

                      <span>
                        You're
                        <strong>
                          {{ shipping_remaining | money }}
                        </strong>
                        away from free shipping.
                      </span>

                    {%- else -%}

                      <span>
                        You've unlocked
                        <strong>free shipping!</strong>
                      </span>

                    {%- endif -%}

                  </div>

                  <div
                    class="hargx-cart__shipping-track"
                    role="progressbar"
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow="{{ shipping_progress | round }}"
                  >
                    <span
                      class="hargx-cart__shipping-fill"
                      style="width: {{ shipping_progress | at_most: 100 }}%;"
                    ></span>
                  </div>

                </div>

              {%- endif -%}


              <div class="hargx-cart__summary-note">
                Taxes and shipping calculated at checkout.
              </div>

              {%- if section.settings.show_order_note -%}

                <div class="hargx-cart__order-note">

                  <button
                    type="button"
                    class="hargx-cart__order-note-toggle"
                    data-hargx-note-toggle
                    aria-expanded="false"
                    aria-controls="HargxCartOrderNote-{{ section.id }}"
                  >
                    <span>
                      Add a note to your order
                    </span>

                    <span
                      class="hargx-cart__order-note-icon"
                      aria-hidden="true"
                    >
                      +
                    </span>
                  </button>

                  <div
                    id="HargxCartOrderNote-{{ section.id }}"
                    class="hargx-cart__order-note-content"
                    data-hargx-note-content
                    hidden
                  >

                    <label
                      for="HargxCartNote-{{ section.id }}"
                      class="hargx-cart__order-note-label"
                    >
                      Order note
                    </label>

                    <textarea
                      id="HargxCartNote-{{ section.id }}"
                      class="hargx-cart__order-note-input"
                      name="note"
                      rows="4"
                      placeholder="Add any special instructions for your order..."
                      maxlength="500"
                      data-hargx-cart-note
                    >{{ cart.note }}</textarea>

                    <div class="hargx-cart__order-note-footer">

                      <span class="hargx-cart__order-note-count">
                        <span data-hargx-note-count>
                          {{ cart.note | size }}
                        </span>/500
                      </span>

                      <button
                        type="button"
                        class="hargx-cart__order-note-save"
                        data-hargx-note-save
                      >
                        Save note
                      </button>

                    </div>

                    <p
                      class="hargx-cart__order-note-status"
                      data-hargx-note-status
                      aria-live="polite"
                    ></p>

                  </div>

                </div>

              {%- endif -%}


              <button
                type="submit"
                name="checkout"
                class="hargx-cart__checkout"
              >
                Checkout
              </button>

              {%- if section.blocks.size > 0 -%}

                <div class="hargx-cart__trust">

                  {%- for block in section.blocks -%}

                    {%- case block.type -%}

                      {%- when 'trust_item' -%}

                        <div
                          class="hargx-cart__trust-item"
                          {{ block.shopify_attributes }}
                        >

                          <div class="hargx-cart__trust-icon" aria-hidden="true">

                            {%- case block.settings.icon -%}

                              {%- when 'check' -%}

                                <svg
                                  width="22"
                                  height="22"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  xmlns="http://www.w3.org/2000/svg"
                                >
                                  <path
                                    d="M5 12.5L9.5 17L19 7.5"
                                    stroke="currentColor"
                                    stroke-width="1.8"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                  />
                                </svg>

                              {%- when 'shield' -%}

                                <svg
                                  width="22"
                                  height="22"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  xmlns="http://www.w3.org/2000/svg"
                                >
                                  <path
                                    d="M12 3L19 6V11C19 15.5 16.2 18.8 12 21C7.8 18.8 5 15.5 5 11V6L12 3Z"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    stroke-linejoin="round"
                                  />
                                  <path
                                    d="M8.5 12L10.8 14.3L15.5 9.6"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                  />
                                </svg>

                              {%- when 'shipping' -%}

                                <svg
                                  width="22"
                                  height="22"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  xmlns="http://www.w3.org/2000/svg"
                                >
                                  <path
                                    d="M3 6H14V16H3V6Z"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    stroke-linejoin="round"
                                  />
                                  <path
                                    d="M14 9H18L21 12V16H14V9Z"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    stroke-linejoin="round"
                                  />
                                  <path
                                    d="M7 19C8.1 19 9 18.1 9 17C9 15.9 8.1 15 7 15C5.9 15 5 15.9 5 17C5 18.1 5.9 19 7 19Z"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                  />
                                  <path
                                    d="M17 19C18.1 19 19 18.1 19 17C19 15.9 18.1 15 17 15C15.9 15 15 15.9 15 17C15 18.1 15.9 19 17 19Z"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                  />
                                </svg>

                              {%- when 'returns' -%}

                                <svg
                                  width="22"
                                  height="22"
                                  viewBox="0 0 24 24"
                                  fill="none"
                                  xmlns="http://www.w3.org/2000/svg"
                                >
                                  <path
                                    d="M9 7H5L8 4"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                  />
                                  <path
                                    d="M5 7C7 5.5 9.2 5 11.5 5C16.2 5 20 8.4 20 13C20 17.4 16.5 20 12 20C8.7 20 6 18.4 5 16"
                                    stroke="currentColor"
                                    stroke-width="1.6"
                                    stroke-linecap="round"
                                  />
                                </svg>

                            {%- endcase -%}

                          </div>

                          <div class="hargx-cart__trust-content">

                            {%- if block.settings.heading != blank -%}
                              <strong class="hargx-cart__trust-heading">
                                {{ block.settings.heading }}
                              </strong>
                            {%- endif -%}

                            {%- if block.settings.text != blank -%}
                              <span class="hargx-cart__trust-text">
                                {{ block.settings.text }}
                              </span>
                            {%- endif -%}

                          </div>

                        </div>

                    {%- endcase -%}

                  {%- endfor -%}

                </div>

              {%- endif -%}


              <a
                href="{{ routes.all_products_collection_url }}"
                class="hargx-cart__continue-summary"
              >
                Continue shopping
              </a>

            </div>

          </aside>

        </div>

      </form>


    {%- else -%}

      <!-- Empty Cart -->

      <div class="hargx-cart__empty">

        <div class="hargx-cart__empty-content">

          <span class="hargx-cart__empty-icon" aria-hidden="true">
            <svg
              width="48"
              height="48"
              viewBox="0 0 48 48"
              fill="none"
              xmlns="http://www.w3.org/2000/svg"
            >
              <path
                d="M10 14H38L35.5 39H12.5L10 14Z"
                stroke="currentColor"
                stroke-width="1.5"
              />
              <path
                d="M17 18V11C17 7.68629 19.6863 5 23 5H25C28.3137 5 31 7.68629 31 11V18"
                stroke="currentColor"
                stroke-width="1.5"
              />
            </svg>
          </span>

          <h1 class="hargx-cart__empty-title">
            Your cart is empty
          </h1>

          <p class="hargx-cart__empty-text">
            Looks like you haven't added anything yet.
          </p>

          <a
            href="{{ routes.all_products_collection_url }}"
            class="hargx-cart__empty-button"
          >
            Continue shopping
          </a>

        </div>

      </div>

    {%- endif -%}

  </div>

</div>


{% schema %}
{
  "name": "HARGX Cart",

  "settings": [
    {
      "type": "checkbox",
      "id": "show_free_shipping_bar",
      "label": "Show free shipping progress",
      "default": true
    },
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold",
      "default": 100,
      "info": "Enter the amount in your store currency."
    },
    {
      "type": "checkbox",
      "id": "show_order_note",
      "label": "Show order note",
      "default": true
    }
  ],

  "blocks": [
    {
      "type": "trust_item",
      "name": "Trust item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "check",
              "label": "Check"
            },
            {
              "value": "shield",
              "label": "Security"
            },
            {
              "value": "shipping",
              "label": "Shipping"
            },
            {
              "value": "returns",
              "label": "Returns"
            }
          ],
          "default": "check"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Secure checkout"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Your payment information is protected."
        }
      ]
    }
  ],

  "max_blocks": 3
}
{% endschema %}