{{ 'footer.css' | asset_url | stylesheet_tag }}

<footer
  class="hargx-footer"
  style="
    --footer-bg: {{ section.settings.background_color }};
    --footer-text: {{ section.settings.text_color }};
    --footer-muted: {{ section.settings.muted_text_color }};
    --footer-border: {{ section.settings.border_color }};
  "
>
  <div class="hargx-footer__container">

    <!-- Footer Main -->
    <div class="hargx-footer__main">

      <!-- Brand -->
      <div class="hargx-footer__brand">

        <a
          href="{{ routes.root_url }}"
          class="hargx-footer__logo"
          aria-label="{{ shop.name }}"
        >
          {% if section.settings.logo != blank %}
            {{
              section.settings.logo
              | image_url: width: section.settings.logo_width
              | image_tag:
                widths: '100,150,200,250,300',
                loading: 'lazy',
                alt: shop.name
            }}
          {% else %}
            <span>{{ shop.name }}</span>
          {% endif %}
        </a>

        {% if section.settings.description != blank %}
          <div class="hargx-footer__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.settings.show_social %}
          <div class="hargx-footer__social">

            {% if section.settings.instagram_url != blank %}
              <a
                href="{{ section.settings.instagram_url }}"
                aria-label="Instagram"
                target="_blank"
                rel="noopener"
              >
                <svg
                  class="hargx-footer__social-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                >
                  <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
                  <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="2" />
                  <circle cx="17.5" cy="6.5" r="1.25" fill="currentColor" />
                </svg>
              </a>
            {% endif %}

            {% if section.settings.facebook_url != blank %}
              <a
                href="{{ section.settings.facebook_url }}"
                aria-label="Facebook"
                target="_blank"
                rel="noopener"
              >
                <svg
                  class="hargx-footer__social-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path fill="currentColor" d="M13.5 21v-8h2.7l.4-3h-3.1V8.1c0-.9.3-1.5 1.6-1.5h1.7V3.9c-.3 0-1.3-.1-2.5-.1-2.5 0-4.2 1.5-4.2 4.3V10H7.3v3h2.8v8h3.4z" />
                </svg>
              </a>
            {% endif %}

            {% if section.settings.tiktok_url != blank %}
              <a
                href="{{ section.settings.tiktok_url }}"
                aria-label="TikTok"
                target="_blank"
                rel="noopener"
              >
                <svg
                  class="hargx-footer__social-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path fill="currentColor" d="M19.6 7.1a6.1 6.1 0 0 1-3.8-1.3v8.1a5.8 5.8 0 1 1-5-5.7v3.2a2.7 2.7 0 1 0 1.9 2.5V2.5h3.1c.2 2 1.7 3.6 3.8 3.9v.7z" />
                </svg>
              </a>
            {% endif %}

            {% if section.settings.youtube_url != blank %}
              <a
                href="{{ section.settings.youtube_url }}"
                aria-label="YouTube"
                target="_blank"
                rel="noopener"
              >
                <svg
                  class="hargx-footer__social-icon"
                  xmlns="http://www.w3.org/2000/svg"
                  viewBox="0 0 24 24"
                  aria-hidden="true"
                  focusable="false"
                >
                  <path fill="currentColor" d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8ZM9.6 15.6V8.4l6.3 3.6-6.3 3.6Z" />
                </svg>
              </a>
            {% endif %}

          </div>
        {% endif %}

      </div>

      <!-- Footer Menus -->
      <div class="hargx-footer__menus">

        {% for block in section.blocks %}

          {% if block.type == 'menu' %}

            <div
              class="hargx-footer__menu"
              {{ block.shopify_attributes }}
            >

              <button
                type="button"
                class="hargx-footer__menu-toggle"
                aria-expanded="false"
              >
                <span>
                  {{ block.settings.heading }}
                </span>

                <span
                  class="hargx-footer__menu-icon"
                  aria-hidden="true"
                >
                  +
                </span>
              </button>

              <div class="hargx-footer__menu-content">

                {% if block.settings.menu != blank %}

                  <nav aria-label="{{ block.settings.heading }}">

                    {% for link in block.settings.menu.links %}

                      <a
                        href="{{ link.url }}"
                        {% if link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ link.title }}
                      </a>

                    {% endfor %}

                  </nav>

                {% endif %}

              </div>

            </div>

          {% endif %}

        {% endfor %}

      </div>

      <!-- Newsletter -->
      {% if section.settings.show_newsletter %}

        <div class="hargx-footer__newsletter">

          {% if section.settings.newsletter_heading != blank %}
            <h2>
              {{ section.settings.newsletter_heading }}
            </h2>
          {% endif %}

          {% if section.settings.newsletter_text != blank %}
            <div class="hargx-footer__newsletter-text">
              {{ section.settings.newsletter_text }}
            </div>
          {% endif %}

          {% form 'customer', class: 'hargx-footer__newsletter-form' %}

            <input
              type="hidden"
              name="contact[tags]"
              value="newsletter"
            >

            <label
              for="HargxNewsletter-{{ section.id }}"
              class="visually-hidden"
            >
              Email address
            </label>

            <div class="hargx-footer__newsletter-input">
              <input
                id="HargxNewsletter-{{ section.id }}"
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="Email address"
                autocomplete="email"
                required
              >

              <button
                type="submit"
                aria-label="Subscribe"
              >
                Subscribe
              </button>
            </div>

            {% if form.errors %}
              <div class="hargx-footer__form-message">
                {{ form.errors | default_errors }}
              </div>
            {% endif %}

            {% if form.posted_successfully? %}
              <div class="hargx-footer__form-message">
                Thanks for subscribing!
              </div>
            {% endif %}

          {% endform %}

        </div>

      {% endif %}

    </div>

    <!-- Footer Bottom -->
    <div class="hargx-footer__bottom">

      <div class="hargx-footer__copyright">
        {% if section.settings.copyright_text != blank %}
          {{ section.settings.copyright_text }}
        {% else %}
          © {{ 'now' | date: '%Y' }} {{ shop.name }}
        {% endif %}
      </div>

      {% if section.settings.show_policy_links %}

        <div class="hargx-footer__policies">

          {% if shop.privacy_policy != blank %}
            <a href="{{ shop.privacy_policy.url }}">
              {{ shop.privacy_policy.title }}
            </a>
          {% endif %}

          {% if shop.terms_of_service != blank %}
            <a href="{{ shop.terms_of_service.url }}">
              {{ shop.terms_of_service.title }}
            </a>
          {% endif %}

          {% if shop.refund_policy != blank %}
            <a href="{{ shop.refund_policy.url }}">
              {{ shop.refund_policy.title }}
            </a>
          {% endif %}

          {% if shop.shipping_policy != blank %}
            <a href="{{ shop.shipping_policy.url }}">
              {{ shop.shipping_policy.title }}
            </a>
          {% endif %}

        </div>

      {% endif %}

      {% if section.settings.show_payment_icons %}

        <div class="hargx-footer__payment">

          {% for type in shop.enabled_payment_types %}
            {{ type | payment_type_svg_tag }}
          {% endfor %}

        </div>

      {% endif %}

    </div>

  </div>
</footer>

{% javascript %}

(function () {
  'use strict';

  const footer = document.querySelector('.hargx-footer');

  if (!footer) return;

  const toggles = footer.querySelectorAll(
    '.hargx-footer__menu-toggle'
  );

  toggles.forEach(function (toggle) {

    toggle.addEventListener('click', function () {

      if (window.innerWidth > 749) return;

      const content = toggle.nextElementSibling;

      if (!content) return;

      const isOpen =
        toggle.classList.contains('is-open');

      toggle.classList.toggle(
        'is-open',
        !isOpen
      );

      toggle.setAttribute(
        'aria-expanded',
        String(!isOpen)
      );

      content.classList.toggle(
        'is-open',
        !isOpen
      );

    });

  });

})();

{% endjavascript %}

{% schema %}
{
  "name": "HARGX Footer",
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 150
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Built for bold ideas and products that stand out.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_newsletter",
      "label": "Show newsletter",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Stay in the loop"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "label": "Newsletter text",
      "default": "<p>Get updates, new releases and more.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show social links",
      "default": true
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram URL"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook URL"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok URL"
    },
    {
      "type": "url",
      "id": "youtube_url",
      "label": "YouTube URL"
    },
    {
      "type": "checkbox",
      "id": "show_policy_links",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright text"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "label": "Muted text color",
      "default": "#B5B5B5"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#2A2A2A"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Footer menu",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HARGX Footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "heading": "Shop"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Support"
          }
        },
        {
          "type": "menu",
          "settings": {
            "heading": "Company"
          }
        }
      ]
    }
  ]
}
{% endschema %}
