{% comment %}
  HARGX Testimonials / Social Proof
  Theme Store ready testimonial section
{% endcomment %}
{{ 'testimonials.css' | asset_url | stylesheet_tag }}
<script src="{{ 'hargx-testimonials.js' | asset_url }}" defer="defer"></script>

<section
  id="HargxTestimonials-{{ section.id }}"
  class="hargx-testimonials hargx-testimonials--{{ section.settings.card_style }} hargx-testimonials--{{ section.settings.display_mode }}"
  data-hargx-testimonials
  style="
    --hargx-testimonials-bg: {{ section.settings.background_color }};
    --hargx-testimonials-text: {{ section.settings.text_color }};
    --hargx-testimonials-accent: {{ section.settings.accent_color }};
    --hargx-testimonials-card-bg: {{ section.settings.card_background }};
    --hargx-testimonials-gap: {{ section.settings.card_gap }}px;
    --hargx-testimonials-radius: {{ section.settings.card_radius }}px;
    --hargx-testimonials-padding-top: {{ section.settings.padding_top }}px;
    --hargx-testimonials-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="hargx-testimonials__container page-width">

    {%- if section.settings.eyebrow != blank
      or section.settings.heading != blank
      or section.settings.description != blank
    -%}
      <div class="hargx-testimonials__header">

        {%- if section.settings.eyebrow != blank -%}
          <div class="hargx-testimonials__eyebrow">
            {{ section.settings.eyebrow }}
          </div>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="hargx-testimonials__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="hargx-testimonials__description rte">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}

      <div
        class="hargx-testimonials__grid"
        {% if section.settings.display_mode == 'slider' %}
          data-hargx-testimonials-track
          role="region"
          tabindex="0"
          aria-label="Customer testimonials"
        {% endif %}
      >

        {%- for block in section.blocks -%}
          <article
            class="hargx-testimonial-card"
            {{ block.shopify_attributes }}
          >

            <div class="hargx-testimonial-card__top">

              <div class="hargx-testimonial-card__stars" aria-label="{{ block.settings.rating }} out of 5 stars">
                {%- assign rating = block.settings.rating | plus: 0 -%}

                {%- for i in (1..5) -%}
                  <span class="hargx-testimonial-card__star{% if i <= rating %} is-active{% endif %}">
                    ★
                  </span>
                {%- endfor -%}
              </div>

              {%- if block.settings.verified -%}
                <div class="hargx-testimonial-card__verified">
                  <svg
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    focusable="false"
                  >
                    <path d="M12 2.5l2.06 1.46 2.52-.12 1.1 2.27 2.27 1.1-.12 2.52L21.5 12l-1.46 2.06.12 2.52-2.27 1.1-1.1 2.27-2.52-.12L12 21.5l-2.06-1.46-2.52.12-1.1-2.27-2.27-1.1.12-2.52L2.5 12l1.46-2.06-.12-2.52 2.27-1.1 1.1-2.27 2.52.12L12 2.5z"/>
                    <path
                      d="M8.2 12.2l2.25 2.25 5.35-5.35"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>

                  <span>{{ block.settings.verified_text }}</span>
                </div>
              {%- endif -%}

            </div>

            {%- if block.settings.quote != blank -%}
              <div class="hargx-testimonial-card__quote rte">
                {{ block.settings.quote }}
              </div>
            {%- endif -%}

            {%- if block.settings.product_name != blank -%}
              <div class="hargx-testimonial-card__product">
                {{ block.settings.product_name }}
              </div>
            {%- endif -%}

            <div class="hargx-testimonial-card__customer">

              {%- if block.settings.customer_image != blank -%}
                <div class="hargx-testimonial-card__avatar">
                  {{
                    block.settings.customer_image
                    | image_url: width: 120
                    | image_tag:
                      loading: 'lazy',
                      widths: '60, 80, 100, 120',
                      sizes: '60px',
                      alt: block.settings.customer_name
                  }}
                </div>
              {%- else -%}
                <div class="hargx-testimonial-card__avatar hargx-testimonial-card__avatar--placeholder">
                  <span>
                    {{ block.settings.customer_name | slice: 0 }}
                  </span>
                </div>
              {%- endif -%}

              <div class="hargx-testimonial-card__customer-info">

                {%- if block.settings.customer_name != blank -%}
                  <div class="hargx-testimonial-card__name">
                    {{ block.settings.customer_name }}
                  </div>
                {%- endif -%}

                {%- if block.settings.customer_detail != blank -%}
                  <div class="hargx-testimonial-card__detail">
                    {{ block.settings.customer_detail }}
                  </div>
                {%- endif -%}

              </div>

            </div>

          </article>
        {%- endfor -%}

      </div>

      {%- if section.settings.display_mode == 'slider' and section.blocks.size > 1 -%}
        <div class="hargx-testimonials__controls">
          <button
            type="button"
            class="hargx-testimonials__control"
            data-hargx-testimonials-prev
            aria-label="Previous testimonials"
            disabled
          >
            <span aria-hidden="true">←</span>
          </button>
          <button
            type="button"
            class="hargx-testimonials__control"
            data-hargx-testimonials-next
            aria-label="Next testimonials"
          >
            <span aria-hidden="true">→</span>
          </button>
        </div>
      {%- endif -%}

    {%- endif -%}

  </div>
</section>

{% schema %}
{
  "name": "HARGX Testimonials",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Loved by customers"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Real people. Real experiences."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>See why customers choose HARGX for products they love.</p>"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "display_mode",
      "label": "Display mode",
      "options": [
        {
          "value": "grid",
          "label": "Grid"
        },
        {
          "value": "slider",
          "label": "Slider"
        }
      ],
      "default": "grid"
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "bordered",
          "label": "Bordered"
        }
      ],
      "default": "bordered"
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Card gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF8F4"
    },
    {
      "type": "color",
      "id": "card_background",
      "label": "Card background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#FE7442"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "blocks": [
    {
      "type": "testimonial",
      "name": "Testimonial",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "Rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show verified badge",
          "default": true
        },
        {
          "type": "text",
          "id": "verified_text",
          "label": "Verified text",
          "default": "Verified customer"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "Testimonial",
          "default": "<p>Absolutely love it. The quality is amazing and the whole experience was seamless.</p>"
        },
        {
          "type": "text",
          "id": "product_name",
          "label": "Product label",
          "default": "Loved their HARGX purchase"
        },
        {
          "type": "image_picker",
          "id": "customer_image",
          "label": "Customer image"
        },
        {
          "type": "text",
          "id": "customer_name",
          "label": "Customer name",
          "default": "Alex Morgan"
        },
        {
          "type": "text",
          "id": "customer_detail",
          "label": "Customer detail",
          "default": "Verified buyer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HARGX Testimonials",
      "blocks": [
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        },
        {
          "type": "testimonial"
        }
      ]
    }
  ]
}
{% endschema %}