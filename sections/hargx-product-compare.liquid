{%- assign compare_heading = section.settings.heading -%}
{%- if compare_heading == blank -%}
  {%- assign compare_heading = 'compare.page.heading' | t -%}
{%- endif -%}
{%- assign compare_description = section.settings.description -%}
{%- if compare_description == blank -%}
  {%- assign compare_description = 'compare.page.description' | t -%}
{%- endif -%}
{%- assign compare_empty_heading = section.settings.empty_heading -%}
{%- if compare_empty_heading == blank -%}
  {%- assign compare_empty_heading = 'compare.page.empty_heading' | t -%}
{%- endif -%}
{%- assign compare_empty_description = section.settings.empty_description -%}
{%- if compare_empty_description == blank -%}
  {%- assign compare_empty_description = 'compare.page.empty_description' | t -%}
{%- endif -%}
{%- assign compare_continue_label = section.settings.continue_shopping_text -%}
{%- if compare_continue_label == blank -%}
  {%- assign compare_continue_label = 'compare.page.continue_shopping' | t -%}
{%- endif -%}

<section
  class="hargx-product-compare"
  data-hargx-compare-page
  data-show-vendor="{{ section.settings.show_vendor }}"
  data-show-availability="{{ section.settings.show_availability }}"
  data-show-type="{{ section.settings.show_product_type }}"
  data-show-description="{{ section.settings.show_description }}"
>
  <div class="hargx-product-compare__container">
    <h1 class="hargx-product-compare__heading">{{ compare_heading | escape }}</h1>
    {%- if compare_description != blank -%}
      <p class="hargx-product-compare__description">{{ compare_description | escape }}</p>
    {%- endif -%}

    <div class="hargx-product-compare__loading" data-hargx-compare-loading role="status" hidden>
      {{ 'compare.page.loading' | t }}
    </div>

    <div class="hargx-product-compare__error" data-hargx-compare-error role="alert" hidden>
      <p data-hargx-compare-error-text>{{ 'compare.status.network_error' | t }}</p>
      <button type="button" class="hargx-product-compare__retry" data-hargx-compare-retry>
        {{ 'compare.actions.retry' | t }}
      </button>
    </div>

    <div class="hargx-product-compare__empty" data-hargx-compare-empty hidden>
      <h2>{{ compare_empty_heading | escape }}</h2>
      <p>{{ compare_empty_description | escape }}</p>
      <a
        class="hargx-product-compare__continue"
        href="{% if section.settings.continue_shopping_url != blank %}{{ section.settings.continue_shopping_url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
      >
        {{ compare_continue_label | escape }}
      </a>
    </div>

    <div class="hargx-product-compare__content" data-hargx-compare-content hidden></div>
  </div>
</section>

{% schema %}
{
  "name": "t:general.product_comparison",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:labels.compare_heading",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "t:labels.compare_description",
      "default": ""
    },
    {
      "type": "text",
      "id": "empty_heading",
      "label": "t:labels.compare_empty_heading",
      "default": ""
    },
    {
      "type": "textarea",
      "id": "empty_description",
      "label": "t:labels.compare_empty_description",
      "default": ""
    },
    {
      "type": "text",
      "id": "continue_shopping_text",
      "label": "t:labels.compare_continue_shopping",
      "default": ""
    },
    {
      "type": "url",
      "id": "continue_shopping_url",
      "label": "t:labels.compare_continue_url"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "label": "t:labels.compare_show_vendor",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_availability",
      "label": "t:labels.compare_show_availability",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_product_type",
      "label": "t:labels.compare_show_type",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "t:labels.compare_show_description",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "t:general.product_comparison"
    }
  ]
}
{% endschema %}
