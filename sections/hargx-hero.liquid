{% comment %}
  HARGX — Custom Hero Banner
  Fully responsive + customizable hero section.
{% endcomment %}
{{ 'hero-banner.css' | asset_url | stylesheet_tag }}


{%- liquid
  assign section_id = 'HargxHero-' | append: section.id
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image | default: desktop_image
-%}

<section
  id="{{ section_id }}"
  class="hargx-hero hargx-hero--{{ section.settings.height }} hargx-hero--content-{{ section.settings.content_position }}"
  data-hargx-hero
  style="
    --hargx-hero-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hargx-hero-content-width: {{ section.settings.content_width }}px;
    --hargx-hero-heading-size: {{ section.settings.heading_size }}px;
    --hargx-hero-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
    --hargx-hero-text-color: {{ section.settings.text_color }};
    --hargx-hero-button-bg: {{ section.settings.button_background }};
    --hargx-hero-button-text: {{ section.settings.button_text_color }};
    --hargx-hero-button-border: {{ section.settings.button_border_color }};
    --hargx-hero-section-bg: {{ section.settings.background_color }};
    --hargx-hero-image-position: {{ section.settings.image_position }};
    --hargx-hero-padding-top: {{ section.settings.padding_top }}px;
    --hargx-hero-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hargx-hero-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --hargx-hero-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="hargx-hero__media">
    {%- if desktop_image != blank -%}

      <picture>
        {%- if mobile_image != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="
              {{ mobile_image | image_url: width: 750 }} 750w,
              {{ mobile_image | image_url: width: 1100 }} 1100w
            "
          >
        {%- endif -%}

        {{
          desktop_image
          | image_url: width: 2400
          | image_tag:
            class: 'hargx-hero__image',
            widths: '750, 1100, 1500, 1800, 2000, 2400',
            sizes: '100vw',
            loading: section.settings.image_loading,
            alt: section.settings.image_alt
        }}
      </picture>

    {%- else -%}

      <div class="hargx-hero__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'hargx-hero__placeholder-svg' }}
      </div>

    {%- endif -%}

    {%- if section.settings.overlay_enabled -%}
      <div class="hargx-hero__overlay"></div>
    {%- endif -%}
  </div>

  <div class="hargx-hero__inner hargx-hero__inner--{{ section.settings.container_width }}">
    <div
      class="
        hargx-hero__content
        hargx-hero__content--{{ section.settings.text_alignment }}
        {% if section.settings.enable_animation %}
          hargx-hero__content--animate
        {% endif %}
      "
    >
      {%- if section.settings.eyebrow != blank -%}
        <div class="hargx-hero__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="hargx-hero__heading">
          {{ section.settings.heading }}
        </h1>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="hargx-hero__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      {%- if section.settings.button_label != blank
        or section.settings.secondary_button_label != blank
      -%}
        <div class="hargx-hero__buttons">

          {%- if section.settings.button_label != blank -%}
            <a
              {% if section.settings.button_link != blank %}
                href="{{ section.settings.button_link }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
              class="hargx-hero__button hargx-hero__button--primary"
            >
              <span>{{ section.settings.button_label }}</span>
              <svg
                class="hargx-hero__button-icon"
                width="16"
                height="16"
                viewBox="0 0 16 16"
                fill="none"
                aria-hidden="true"
              >
                <path
                  d="M3 8H13M8.5 3.5L13 8L8.5 12.5"
                  stroke="currentColor"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                />
              </svg>
            </a>
          {%- endif -%}

          {%- if section.settings.secondary_button_label != blank -%}
            <a
              {% if section.settings.secondary_button_link != blank %}
                href="{{ section.settings.secondary_button_link }}"
              {% else %}
                role="link"
                aria-disabled="true"
              {% endif %}
              class="hargx-hero__button hargx-hero__button--secondary"
            >
              <span>{{ section.settings.secondary_button_label }}</span>
            </a>
          {%- endif -%}

        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if section.settings.show_scroll_indicator -%}
    <button
      type="button"
      class="hargx-hero__scroll"
      data-hargx-hero-scroll
      aria-label="Scroll to next section"
    >
      <span class="hargx-hero__scroll-line"></span>
      <span class="hargx-hero__scroll-text">
        {{ section.settings.scroll_text }}
      </span>
    </button>
  {%- endif -%}
</section>




<script>
  (function () {
    const hero = document.getElementById('{{ section_id }}');

    if (!hero) return;

    const scrollButton = hero.querySelector('[data-hargx-hero-scroll]');

    if (scrollButton) {
      scrollButton.addEventListener('click', function () {
        const nextSection = hero.nextElementSibling;

        if (nextSection) {
          nextSection.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    }
  })();
</script>

