{% comment %}
  HARGX Editorial Section
{% endcomment %}
{{ 'editorial.css' | asset_url | stylesheet_tag }}

<section
  id="HargxEditorial-{{ section.id }}"
  class="hargx-editorial"
  style="
    --hargx-editorial-background: {{ section.settings.background_color }};
    --hargx-editorial-text: {{ section.settings.text_color }};
    --hargx-editorial-padding-top: {{ section.settings.padding_top }}px;
    --hargx-editorial-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hargx-editorial-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --hargx-editorial-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
    --hargx-editorial-column-gap: {{ section.settings.column_gap }}px;
    --hargx-editorial-image-ratio: {{ section.settings.image_ratio }};
  "
>
  <div class="page-width hargx-editorial__container">

    <div
      class="
        hargx-editorial__grid
        hargx-editorial__grid--{{ section.settings.image_position }}
      "
    >

      <div class="hargx-editorial__media">

        {% if section.settings.image != blank %}

          <div class="hargx-editorial__image-wrap">

            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                class: 'hargx-editorial__image'
            }}

            {% if section.settings.show_badge and section.settings.badge_text != blank %}
              <div class="hargx-editorial__badge">
                {{ section.settings.badge_text }}
              </div>
            {% endif %}

          </div>

        {% else %}

          <div class="hargx-editorial__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          </div>

        {% endif %}

      </div>

      <div class="hargx-editorial__content">

        {% if section.settings.eyebrow != blank %}
          <p class="hargx-editorial__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="hargx-editorial__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="hargx-editorial__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="hargx-editorial__features">

            {% for block in section.blocks %}

              <div
                class="hargx-editorial__feature"
                {{ block.shopify_attributes }}
              >

                <span class="hargx-editorial__number">
                  {{ forloop.index | prepend: '0' }}
                </span>

                <div>
                  {% if block.settings.title != blank %}
                    <h3 class="hargx-editorial__feature-title">
                      {{ block.settings.title }}
                    </h3>
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <p class="hargx-editorial__feature-text">
                      {{ block.settings.text }}
                    </p>
                  {% endif %}
                </div>

              </div>

            {% endfor %}

          </div>
        {% endif %}

        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <a
            href="{{ section.settings.button_link }}"
            class="hargx-editorial__button"
          >
            {{ section.settings.button_label }}

            <svg
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M3 9H15M15 9L10 4M15 9L10 14"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        {% endif %}

      </div>

    </div>

  </div>
</section>


{% schema %}
{
  "name": "HARGX Editorial",
  "tag": "section",
  "class": "section-hargx-editorial",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "4 / 3",
          "label": "Landscape"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show image badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Designed with purpose"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The HARGX difference"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Designed to make every detail feel intentional."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Thoughtful design, distinctive details and a better everyday experience.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF8F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Thoughtful design"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every detail is considered with purpose."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HARGX Editorial",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
