{% comment %}
  HARGX Editorial Section
{% endcomment %}

<section
  id="HargxEditorial-{{ section.id }}"
  class="hargx-editorial"
>
  <div class="page-width hargx-editorial__container">

    <div
      class="
        hargx-editorial__grid
        hargx-editorial__grid--{{ section.settings.image_position }}
      "
    >

      <div class="hargx-editorial__media">

        {% if section.settings.image != blank %}

          <div class="hargx-editorial__image-wrap">

            {{
              section.settings.image
              | image_url: width: 1600
              | image_tag:
                loading: 'lazy',
                class: 'hargx-editorial__image'
            }}

            {% if section.settings.show_badge and section.settings.badge_text != blank %}
              <div class="hargx-editorial__badge">
                {{ section.settings.badge_text }}
              </div>
            {% endif %}

          </div>

        {% else %}

          <div class="hargx-editorial__placeholder">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          </div>

        {% endif %}

      </div>

      <div class="hargx-editorial__content">

        {% if section.settings.eyebrow != blank %}
          <p class="hargx-editorial__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="hargx-editorial__heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="hargx-editorial__description">
            {{ section.settings.description }}
          </div>
        {% endif %}

        {% if section.blocks.size > 0 %}
          <div class="hargx-editorial__features">

            {% for block in section.blocks %}

              <div
                class="hargx-editorial__feature"
                {{ block.shopify_attributes }}
              >

                <span class="hargx-editorial__number">
                  {{ forloop.index | prepend: '0' }}
                </span>

                <div>
                  {% if block.settings.title != blank %}
                    <h3 class="hargx-editorial__feature-title">
                      {{ block.settings.title }}
                    </h3>
                  {% endif %}

                  {% if block.settings.text != blank %}
                    <p class="hargx-editorial__feature-text">
                      {{ block.settings.text }}
                    </p>
                  {% endif %}
                </div>

              </div>

            {% endfor %}

          </div>
        {% endif %}

        {% if section.settings.button_label != blank and section.settings.button_link != blank %}
          <a
            href="{{ section.settings.button_link }}"
            class="hargx-editorial__button"
          >
            {{ section.settings.button_label }}

            <svg
              width="18"
              height="18"
              viewBox="0 0 18 18"
              fill="none"
              aria-hidden="true"
            >
              <path
                d="M3 9H15M15 9L10 4M15 9L10 14"
                stroke="currentColor"
                stroke-width="1.5"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </a>
        {% endif %}

      </div>

    </div>

  </div>
</section>

<style>
  #HargxEditorial-{{ section.id }} {
    background: {{ section.settings.background_color }};
    color: {{ section.settings.text_color }};
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__container {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 0.95fr);
    align-items: center;
    gap: {{ section.settings.column_gap }}px;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__grid--right {
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__grid--right .hargx-editorial__media {
    order: 2;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__grid--right .hargx-editorial__content {
    order: 1;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__media {
    position: relative;
    min-width: 0;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__image-wrap {
    position: relative;
    overflow: hidden;
    aspect-ratio: {{ section.settings.image_ratio }};
    background: #EDE9E3;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__image,
  #HargxEditorial-{{ section.id }} .hargx-editorial__placeholder {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__image {
    transition: transform 0.7s ease;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__image-wrap:hover .hargx-editorial__image {
    transform: scale(1.04);
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__badge {
    position: absolute;
    right: 24px;
    bottom: 24px;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 92px;
    height: 92px;
    padding: 12px;
    border-radius: 50%;
    background: #FE7442;
    color: #FFFFFF;
    font-size: 10px;
    font-weight: 700;
    line-height: 1.3;
    letter-spacing: 0.08em;
    text-align: center;
    text-transform: uppercase;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__content {
    max-width: 580px;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__eyebrow {
    margin: 0 0 12px;
    color: #FE7442;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__heading {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: clamp(32px, 4vw, 56px);
    font-weight: 600;
    line-height: 1.05;
    letter-spacing: -0.04em;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__description {
    margin-top: 20px;
    color: {{ section.settings.text_color }};
    opacity: 0.68;
    font-size: 15px;
    line-height: 1.75;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__description p {
    margin: 0 0 10px;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__features {
    margin-top: 30px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__feature {
    display: flex;
    gap: 18px;
    padding: 17px 0;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__number {
    color: #FE7442;
    font-size: 11px;
    font-weight: 700;
    line-height: 1.5;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__feature-title {
    margin: 0;
    color: {{ section.settings.text_color }};
    font-size: 15px;
    font-weight: 600;
    line-height: 1.4;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__feature-text {
    margin: 4px 0 0;
    color: {{ section.settings.text_color }};
    opacity: 0.58;
    font-size: 13px;
    line-height: 1.5;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__button {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 32px;
    padding: 15px 23px;
    background: #000000;
    color: #FFFFFF;
    border: 1px solid #000000;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-decoration: none;
    text-transform: uppercase;
    transition: all 0.3s ease;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__button svg {
    transition: transform 0.3s ease;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__button:hover {
    background: #FE7442;
    border-color: #FE7442;
  }

  #HargxEditorial-{{ section.id }} .hargx-editorial__button:hover svg {
    transform: translateX(4px);
  }

  @media screen and (max-width: 749px) {
    #HargxEditorial-{{ section.id }} .hargx-editorial__container {
      padding-top: {{ section.settings.padding_top_mobile }}px;
      padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
    }

    #HargxEditorial-{{ section.id }} .hargx-editorial__grid,
    #HargxEditorial-{{ section.id }} .hargx-editorial__grid--right {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    #HargxEditorial-{{ section.id }} .hargx-editorial__grid--right .hargx-editorial__media,
    #HargxEditorial-{{ section.id }} .hargx-editorial__grid--right .hargx-editorial__content {
      order: initial;
    }

    #HargxEditorial-{{ section.id }} .hargx-editorial__heading {
      font-size: clamp(30px, 9vw, 40px);
    }

    #HargxEditorial-{{ section.id }} .hargx-editorial__description {
      font-size: 14px;
    }

    #HargxEditorial-{{ section.id }} .hargx-editorial__badge {
      right: 14px;
      bottom: 14px;
      width: 72px;
      height: 72px;
      font-size: 8px;
    }

    #HargxEditorial-{{ section.id }} .hargx-editorial__button {
      width: 100%;
      justify-content: center;
    }
  }
</style>

{% schema %}
{
  "name": "HARGX Editorial",
  "tag": "section",
  "class": "section-hargx-editorial",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "4 / 3",
          "label": "Landscape"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "checkbox",
      "id": "show_badge",
      "label": "Show image badge",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "Designed with purpose"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "The HARGX difference"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Designed to make every detail feel intentional."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Thoughtful design, distinctive details and a better everyday experience.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Discover more"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF8F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "column_gap",
      "label": "Column gap",
      "min": 20,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Thoughtful design"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Text",
          "default": "Every detail is considered with purpose."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HARGX Editorial",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}
