

{{ 'section-hargx-split-feature.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = 'HargxSplitFeature-' | append: section.id

  assign image_alt = section.settings.image.alt
  if image_alt == blank
    assign image_alt = section.settings.heading | strip_html
  endif

  assign image_width_class = section.settings.image_width
  assign image_ratio_class = section.settings.image_ratio
  assign image_position_class = section.settings.image_position
-%}

<section
  id="{{ section_id }}"
  class="
    hargx-split-feature
    hargx-split-feature--image-{{ section.settings.image_side }}
    hargx-split-feature--mobile-{{ section.settings.mobile_order }}
    hargx-split-feature--content-{{ section.settings.content_alignment }}
    hargx-split-feature--width-{{ image_width_class }}
  "
  style="
    --hargx-split-bg: {{ section.settings.background_color }};
    --hargx-split-text: {{ section.settings.text_color }};
    --hargx-split-accent: {{ section.settings.accent_color }};
    --hargx-split-overlay: {{ section.settings.overlay_opacity | divided_by: 100.0 }};
    --hargx-split-radius: {{ section.settings.image_radius }}px;
    --hargx-split-padding-top: {{ section.settings.padding_top }}px;
    --hargx-split-padding-bottom: {{ section.settings.padding_bottom }}px;
    --hargx-split-padding-top-mobile: {{ section.settings.padding_top_mobile }}px;
    --hargx-split-padding-bottom-mobile: {{ section.settings.padding_bottom_mobile }}px;
  "
>
  <div class="hargx-split-feature__container page-width">

    <div class="hargx-split-feature__grid">

      {%- comment -%}
        IMAGE
      {%- endcomment -%}

      <div class="hargx-split-feature__media">

        {%- if section.settings.image != blank -%}

          <div
            class="
              hargx-split-feature__image-wrap
              hargx-split-feature__image-wrap--{{ image_ratio_class }}
              hargx-split-feature__image-wrap--{{ image_position_class }}
            "
          >
            {{
              section.settings.image
              | image_url: width: 2000
              | image_tag:
                class: 'hargx-split-feature__image',
                widths: '480, 640, 750, 900, 1100, 1400, 1600, 1800, 2000',
                sizes: '(min-width: 990px) 50vw, 100vw',
                loading: 'lazy',
                decoding: 'async',
                alt: image_alt
            }}

            {%- if section.settings.show_overlay -%}
              <div
                class="hargx-split-feature__overlay"
                aria-hidden="true"
              ></div>
            {%- endif -%}

            {%- if section.settings.badge != blank -%}
              <div class="hargx-split-feature__badge">
                {{ section.settings.badge }}
              </div>
            {%- endif -%}
          </div>

        {%- else -%}

          <div class="hargx-split-feature__placeholder">
            {{ 'lifestyle-2' | placeholder_svg_tag }}
          </div>

        {%- endif -%}

      </div>

      {%- comment -%}
        CONTENT
      {%- endcomment -%}

      <div class="hargx-split-feature__content">

        <div class="hargx-split-feature__content-inner">

          {%- if section.settings.eyebrow != blank -%}
            <div class="hargx-split-feature__eyebrow">
              {{ section.settings.eyebrow }}
            </div>
          {%- endif -%}

          {%- if section.settings.heading != blank -%}
            <h2 class="hargx-split-feature__heading">
              {{ section.settings.heading }}
            </h2>
          {%- endif -%}

          {%- if section.settings.description != blank -%}
            <div class="hargx-split-feature__description rte">
              {{ section.settings.description }}
            </div>
          {%- endif -%}

          {%- if section.settings.show_features and section.blocks.size > 0 -%}
            <div class="hargx-split-feature__features">

              {%- for block in section.blocks -%}

                <div
                  class="hargx-split-feature__feature"
                  {{ block.shopify_attributes }}
                >
                  <div class="hargx-split-feature__feature-icon">

                    {%- if block.settings.icon != blank -%}

                      {{
                        block.settings.icon
                        | image_url: width: 80
                        | image_tag:
                          class: 'hargx-split-feature__feature-icon-image',
                          loading: 'lazy',
                          decoding: 'async',
                          alt: ''
                      }}

                    {%- else -%}

                      <svg
                        width="18"
                        height="18"
                        viewBox="0 0 24 24"
                        fill="none"
                        aria-hidden="true"
                      >
                        <path
                          d="M12 3L14.8 8.7L21 9.6L16.5 14L17.6 20.2L12 17.3L6.4 20.2L7.5 14L3 9.6L9.2 8.7L12 3Z"
                          stroke="currentColor"
                          stroke-width="1.5"
                          stroke-linecap="round"
                          stroke-linejoin="round"
                        />
                      </svg>

                    {%- endif -%}

                  </div>

                  <div class="hargx-split-feature__feature-content">

                    {%- if block.settings.heading != blank -%}
                      <h3>
                        {{ block.settings.heading }}
                      </h3>
                    {%- endif -%}

                    {%- if block.settings.text != blank -%}
                      <p>
                        {{ block.settings.text }}
                      </p>
                    {%- endif -%}

                  </div>
                </div>

              {%- endfor -%}

            </div>
          {%- endif -%}

          {%- if section.settings.primary_button_label != blank
            or section.settings.secondary_button_label != blank
          -%}

            <div class="hargx-split-feature__buttons">

              {%- if section.settings.primary_button_label != blank
                and section.settings.primary_button_link != blank
              -%}

                <a
                  href="{{ section.settings.primary_button_link }}"
                  class="hargx-split-feature__button hargx-split-feature__button--primary"
                >
                  <span>
                    {{ section.settings.primary_button_label }}
                  </span>

                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 16 16"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M3 8H13M8.5 3.5L13 8L8.5 12.5"
                      stroke="currentColor"
                      stroke-width="1.5"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    />
                  </svg>
                </a>

              {%- endif -%}

              {%- if section.settings.secondary_button_label != blank
                and section.settings.secondary_button_link != blank
              -%}

                <a
                  href="{{ section.settings.secondary_button_link }}"
                  class="hargx-split-feature__button hargx-split-feature__button--secondary"
                >
                  {{ section.settings.secondary_button_label }}
                </a>

              {%- endif -%}

            </div>

          {%- endif -%}

        </div>

      </div>

    </div>

  </div>
</section>

{% schema %}
{
  "name": "HARGX Split Feature",
  "tag": "section",
  "class": "hargx-split-feature-section",
  "settings": [
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_side",
      "label": "Image position",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "mobile_order",
      "label": "Mobile content order",
      "options": [
        {
          "value": "image-first",
          "label": "Image first"
        },
        {
          "value": "content-first",
          "label": "Content first"
        }
      ],
      "default": "image-first"
    },
    {
      "type": "select",
      "id": "image_width",
      "label": "Image width",
      "options": [
        {
          "value": "40",
          "label": "40%"
        },
        {
          "value": "50",
          "label": "50%"
        },
        {
          "value": "60",
          "label": "60%"
        }
      ],
      "default": "50"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image focal position",
      "options": [
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "image_radius",
      "label": "Image corner radius",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "checkbox",
      "id": "show_overlay",
      "label": "Show image overlay",
      "default": false
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay opacity",
      "min": 0,
      "max": 60,
      "step": 5,
      "unit": "%",
      "default": 15
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Image badge",
      "default": ""
    },

    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Designed differently"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Made for the way you live."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Thoughtfully designed products that combine function, simplicity, and a distinctive point of view.</p>"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "Content vertical alignment",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },

    {
      "type": "header",
      "content": "Features"
    },
    {
      "type": "checkbox",
      "id": "show_features",
      "label": "Show feature list",
      "default": true
    },

    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "primary_button_label",
      "label": "Primary button label",
      "default": "Explore collection"
    },
    {
      "type": "url",
      "id": "primary_button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button label",
      "default": "Learn more"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    },

    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF8F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#FE7442"
    },

    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Thoughtfully designed"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Made with attention to every detail."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HARGX Split Feature",
      "blocks": [
        {
          "type": "feature"
        },
        {
          "type": "feature"
        },
        {
          "type": "feature"
        }
      ]
    }
  ]
}
{% endschema %}