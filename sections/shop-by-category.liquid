{% comment %}
  HARGX - Shop by Category
  Premium category grid with responsive layout and hover effects.
{% endcomment %}

{{ 'shop-by-category.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign section_id = 'ShopByCategory-' | append: section.id
-%}

<section
  id="{{ section_id }}"
  class="hargx-shop-category hargx-shop-category--{{ section.settings.card_style }}"
  data-section-id="{{ section.id }}"
>
  <div class="hargx-shop-category__container page-width">

    {%- if section.settings.heading != blank or section.settings.description != blank -%}
      <div class="hargx-shop-category__header hargx-shop-category__header--{{ section.settings.text_alignment }}">

        {%- if section.settings.eyebrow != blank -%}
          <p class="hargx-shop-category__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2 class="hargx-shop-category__heading">
            {{ section.settings.heading }}
          </h2>
        {%- endif -%}

        {%- if section.settings.description != blank -%}
          <div class="hargx-shop-category__description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}

      </div>
    {%- endif -%}

    <div
      class="
        hargx-shop-category__grid
        hargx-shop-category__grid--{{ section.settings.columns_desktop }}
        hargx-shop-category__grid-mobile--{{ section.settings.columns_mobile }}
      "
    >
      {%- for block in section.blocks -%}

        {%- if block.settings.image != blank
          or block.settings.title != blank
          or block.settings.description != blank
        -%}

          <a
            {% if block.settings.link != blank %}
              href="{{ block.settings.link }}"
            {% else %}
              role="link"
              aria-disabled="true"
            {% endif %}
            class="hargx-category-card hargx-category-card--{{ block.settings.content_position }}"
            {{ block.shopify_attributes }}
          >

            <div class="hargx-category-card__media">

              {%- if block.settings.image != blank -%}
                {{
                  block.settings.image
                  | image_url: width: 1200
                  | image_tag:
                    loading: 'lazy',
                    widths: '375, 550, 750, 900, 1200',
                    sizes: '(min-width: 990px) 25vw, 50vw',
                    class: 'hargx-category-card__image',
                    alt: block.settings.image.alt | escape
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'hargx-category-card__image hargx-category-card__placeholder' }}
              {%- endif -%}

              <div class="hargx-category-card__overlay"></div>

              <div class="hargx-category-card__content">

                {%- if block.settings.title != blank -%}
                  <h3 class="hargx-category-card__title">
                    {{ block.settings.title }}
                  </h3>
                {%- endif -%}

                {%- if block.settings.description != blank -%}
                  <div class="hargx-category-card__description">
                    {{ block.settings.description }}
                  </div>
                {%- endif -%}

                {%- if block.settings.show_link -%}
                  <span class="hargx-category-card__link">
                    {{ block.settings.link_text }}

                    <svg
                      class="hargx-category-card__arrow"
                      width="18"
                      height="18"
                      viewBox="0 0 18 18"
                      fill="none"
                      xmlns="http://www.w3.org/2000/svg"
                      aria-hidden="true"
                    >
                      <path
                        d="M3.75 9H14.25M14.25 9L9.75 4.75M14.25 9L9.75 13.25"
                        stroke="currentColor"
                        stroke-width="1.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                {%- endif -%}

              </div>

            </div>

          </a>

        {%- endif -%}

      {%- endfor -%}
    </div>

  </div>
</section>




{% schema %}
{
  "name": "HARGX Shop by Category",
  "tag": "section",
  "class": "section-hargx-shop-category",
  "settings": [
    {
      "type": "header",
      "content": "Section heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Explore"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Explore our collections and find something made for you.</p>"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "columns_desktop",
      "label": "Desktop columns",
      "options": [
        {
          "value": "2",
          "label": "2 columns"
        },
        {
          "value": "3",
          "label": "3 columns"
        },
        {
          "value": "4",
          "label": "4 columns"
        },
        {
          "value": "5",
          "label": "5 columns"
        }
      ],
      "default": "4"
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait"
        },
        {
          "value": "3 / 4",
          "label": "Tall portrait"
        },
        {
          "value": "4 / 3",
          "label": "Landscape"
        },
        {
          "value": "16 / 9",
          "label": "Wide"
        }
      ],
      "default": "4 / 5"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Desktop gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "gap_mobile",
      "label": "Mobile gap",
      "min": 6,
      "max": 24,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "select",
      "id": "card_style",
      "label": "Card style",
      "options": [
        {
          "value": "default",
          "label": "Default"
        },
        {
          "value": "soft",
          "label": "Soft border"
        },
        {
          "value": "sharp",
          "label": "Sharp corners"
        }
      ],
      "default": "default"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF8F4"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom spacing",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Mobile top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 52
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Mobile bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 52
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Category image"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "New Arrivals"
        },
        {
          "type": "textarea",
          "id": "description",
          "label": "Description",
          "default": "Discover the latest additions."
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "show_link",
          "label": "Show link",
          "default": true
        },
        {
          "type": "text",
          "id": "link_text",
          "label": "Link text",
          "default": "Shop now"
        },
        {
          "type": "select",
          "id": "content_position",
          "label": "Content position",
          "options": [
            {
              "value": "bottom",
              "label": "Bottom"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "top",
              "label": "Top"
            }
          ],
          "default": "bottom"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HARGX Shop by Category",
      "blocks": [
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        },
        {
          "type": "category"
        }
      ]
    }
  ]
}
{% endschema %}
