{% comment %}
  HARGX Newsletter / CTA
  Theme Store ready newsletter section
{% endcomment %}

<section
  id="HargxNewsletter-{{ section.id }}"
  class="hargx-newsletter hargx-newsletter--{{ section.settings.layout_style }}"
  style="
    --hargx-newsletter-bg: {{ section.settings.background_color }};
    --hargx-newsletter-text: {{ section.settings.text_color }};
    --hargx-newsletter-accent: {{ section.settings.accent_color }};
    --hargx-newsletter-input-bg: {{ section.settings.input_background }};
    --hargx-newsletter-radius: {{ section.settings.card_radius }}px;
    --hargx-newsletter-padding-top: {{ section.settings.padding_top }}px;
    --hargx-newsletter-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="hargx-newsletter__container page-width">

    <div class="hargx-newsletter__content">

      {%- if section.settings.eyebrow != blank -%}
        <div class="hargx-newsletter__eyebrow">
          {{ section.settings.eyebrow }}
        </div>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="hargx-newsletter__heading">
          {{ section.settings.heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.description != blank -%}
        <div class="hargx-newsletter__description rte">
          {{ section.settings.description }}
        </div>
      {%- endif -%}

      {% form 'customer', class: 'hargx-newsletter__form' %}

        <input type="hidden" name="contact[tags]" value="newsletter">

        <div class="hargx-newsletter__form-row">

          <div class="hargx-newsletter__input-wrap">
            <label
              class="visually-hidden"
              for="HargxNewsletterEmail-{{ section.id }}"
            >
              Email address
            </label>

            <input
              id="HargxNewsletterEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              class="hargx-newsletter__input"
              value="{{ form.email }}"
              placeholder="{{ section.settings.email_placeholder }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
            >
          </div>

          <button
            type="submit"
            class="hargx-newsletter__button button"
          >
            <span>{{ section.settings.button_label }}</span>

            <svg
              class="hargx-newsletter__button-icon"
              viewBox="0 0 24 24"
              aria-hidden="true"
              focusable="false"
            >
              <path
                d="M5 12h13M13 6l6 6-6 6"
                fill="none"
                stroke="currentColor"
                stroke-width="1.8"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </button>

        </div>

        {%- if form.errors -%}
          <div class="hargx-newsletter__message hargx-newsletter__message--error">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}

        {%- if form.posted_successfully? -%}
          <div class="hargx-newsletter__message hargx-newsletter__message--success">
            {{ section.settings.success_message }}
          </div>
        {%- endif -%}

      {% endform %}

      {%- if section.settings.disclaimer != blank -%}
        <div class="hargx-newsletter__disclaimer">
          {{ section.settings.disclaimer }}
        </div>
      {%- endif -%}

    </div>

  </div>
</section>

<style>
  #HargxNewsletter-{{ section.id }} {
    background: var(--hargx-newsletter-bg);
    color: var(--hargx-newsletter-text);
    padding-top: var(--hargx-newsletter-padding-top);
    padding-bottom: var(--hargx-newsletter-padding-bottom);
    overflow: hidden;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__container {
    width: 100%;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__content {
    max-width: 820px;
    margin: 0 auto;
    text-align: center;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__eyebrow {
    margin-bottom: 12px;
    color: var(--hargx-newsletter-accent);
    font-size: 12px;
    line-height: 1.4;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__heading {
    max-width: 720px;
    margin: 0 auto;
    color: var(--hargx-newsletter-text);
    font-size: clamp(34px, 5vw, 58px);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .visually-hidden {
    display: none;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__description {
    max-width: 620px;
    margin: 20px auto 0;
    color: var(--hargx-newsletter-text);
    opacity: 0.7;
    font-size: 16px;
    line-height: 1.7;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__description p {
    margin: 0;
  }

  /* Form */

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__form {
    max-width: 650px;
    margin: 34px auto 0;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__form-row {
    display: flex;
    align-items: stretch;
    gap: 10px;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__input-wrap {
    flex: 1 1 auto;
    min-width: 0;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__input {
    display: block;
    width: 100%;
    min-height: 54px;
    padding: 0 20px;
    border: 1px solid rgba(0, 0, 0, 0.12);
    border-radius: var(--hargx-newsletter-radius);
    background: var(--hargx-newsletter-input-bg);
    color: var(--hargx-newsletter-text);
    font: inherit;
    font-size: 15px;
    outline: none;
    transition:
      border-color 0.25s ease,
      box-shadow 0.25s ease;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__input::placeholder {
    color: var(--hargx-newsletter-text);
    opacity: 0.48;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__input:focus {
    border-color: var(--hargx-newsletter-accent);
    box-shadow: 0 0 0 3px rgba(254, 116, 66, 0.12);
  }

  /* Button */

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__button {
    min-width: 170px;
    min-height: 54px;
    padding: 0 22px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    border: 1px solid var(--hargx-newsletter-accent);
    border-radius: var(--hargx-newsletter-radius);
    background: var(--hargx-newsletter-accent);
    color: #ffffff;
    cursor: pointer;
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
    transition:
      transform 0.3s ease,
      background 0.3s ease,
      border-color 0.3s ease;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__button:hover {
    transform: translateY(-2px);
    background: #000000;
    border-color: #000000;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__button-icon {
    width: 18px;
    height: 18px;
    transition: transform 0.3s ease;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__button:hover
    .hargx-newsletter__button-icon {
    transform: translateX(3px);
  }

  /* Messages */

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__message {
    margin-top: 14px;
    font-size: 13px;
    line-height: 1.5;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__message--success {
    color: #25803d;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__message--error {
    color: #b42318;
  }

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__message ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Disclaimer */

  #HargxNewsletter-{{ section.id }} .hargx-newsletter__disclaimer {
    max-width: 560px;
    margin: 16px auto 0;
    color: var(--hargx-newsletter-text);
    opacity: 0.5;
    font-size: 11px;
    line-height: 1.6;
  }

  /* Accent layout */

  #HargxNewsletter-{{ section.id }}.hargx-newsletter--accent {
    background: var(--hargx-newsletter-accent);
    color: #ffffff;
  }

  #HargxNewsletter-{{ section.id }}.hargx-newsletter--accent
    .hargx-newsletter__heading,
  #HargxNewsletter-{{ section.id }}.hargx-newsletter--accent
    .hargx-newsletter__description,
  #HargxNewsletter-{{ section.id }}.hargx-newsletter--accent
    .hargx-newsletter__disclaimer {
    color: #ffffff;
  }

  #HargxNewsletter-{{ section.id }}.hargx-newsletter--accent
    .hargx-newsletter__eyebrow {
    color: #ffffff;
  }

  #HargxNewsletter-{{ section.id }}.hargx-newsletter--accent
    .hargx-newsletter__input {
    border-color: rgba(255, 255, 255, 0.3);
    background: #ffffff;
    color: #000000;
  }

  #HargxNewsletter-{{ section.id }}.hargx-newsletter--accent
    .hargx-newsletter__input::placeholder {
    color: #000000;
  }

  #HargxNewsletter-{{ section.id }}.hargx-newsletter--accent
    .hargx-newsletter__button {
    background: #000000;
    border-color: #000000;
  }

  #HargxNewsletter-{{ section.id }}.hargx-newsletter--accent
    .hargx-newsletter__button:hover {
    background: #ffffff;
    border-color: #ffffff;
    color: #000000;
  }

  /* Card layout */

  #HargxNewsletter-{{ section.id }}.hargx-newsletter--card
    .hargx-newsletter__content {
    padding: 64px;
    border-radius: 28px;
    background: #ffffff;
    box-shadow: 0 18px 55px rgba(0, 0, 0, 0.07);
  }

  /* Mobile */

  @media screen and (max-width: 749px) {
    #HargxNewsletter-{{ section.id }} {
      padding-top: calc(var(--hargx-newsletter-padding-top) * 0.75);
      padding-bottom: calc(var(--hargx-newsletter-padding-bottom) * 0.75);
    }

    #HargxNewsletter-{{ section.id }} .hargx-newsletter__heading {
      font-size: 34px;
    }

    #HargxNewsletter-{{ section.id }} .hargx-newsletter__description {
      margin-top: 16px;
      font-size: 15px;
    }

    #HargxNewsletter-{{ section.id }} .hargx-newsletter__form {
      margin-top: 28px;
    }

    #HargxNewsletter-{{ section.id }} .hargx-newsletter__form-row {
      flex-direction: column;
      gap: 10px;
    }

    #HargxNewsletter-{{ section.id }} .hargx-newsletter__input,
    #HargxNewsletter-{{ section.id }} .hargx-newsletter__button {
      width: 100%;
      min-height: 52px;
    }

    #HargxNewsletter-{{ section.id }}.hargx-newsletter--card
      .hargx-newsletter__content {
      padding: 36px 22px;
      border-radius: 20px;
    }
  }
</style>

{% schema %}
{
  "name": "HARGX Newsletter",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Stay in the loop"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "Get the latest from HARGX."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Sign up for product launches, new arrivals and updates — straight to your inbox.</p>"
    },
    {
      "type": "text",
      "id": "email_placeholder",
      "label": "Email placeholder",
      "default": "Enter your email address"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Subscribe"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "text",
      "id": "disclaimer",
      "label": "Disclaimer",
      "default": "By subscribing, you agree to receive emails from HARGX."
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout_style",
      "label": "Layout style",
      "options": [
        {
          "value": "standard",
          "label": "Standard"
        },
        {
          "value": "accent",
          "label": "Accent"
        },
        {
          "value": "card",
          "label": "Card"
        }
      ],
      "default": "standard"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Input radius",
      "min": 0,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 14
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#FAF8F4"
    },
    {
      "type": "color",
      "id": "input_background",
      "label": "Input background",
      "default": "#FFFFFF"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#FE7442"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Desktop top padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Desktop bottom padding",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 88
    }
  ],
  "presets": [
    {
      "name": "HARGX Newsletter"
    }
  ]
}
{% endschema %}