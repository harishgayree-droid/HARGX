{%- liquid
  assign products_per_page = section.settings.products_per_page
  assign desktop_columns = section.settings.desktop_columns
  assign mobile_columns = section.settings.mobile_columns
-%}

{%- paginate collection.products by products_per_page -%}

<section
  id="HargxCollectionGrid-{{ section.id }}"
  class="hargx-collection-grid-section"
  data-section-id="{{ section.id }}"
>
  <div class="hargx-collection-grid-section__inner">

    {%- comment -%}
      ==========================================
      TOOLBAR
      ==========================================
    {%- endcomment -%}

    {%- for block in section.blocks -%}
      {%- if block.type == 'toolbar' -%}

        <div
          class="hargx-collection-toolbar"
          {{ block.shopify_attributes }}
          style="
            --toolbar-bg: {{ block.settings.background }};
            --toolbar-text: {{ block.settings.text_color }};
            --toolbar-accent: {{ block.settings.accent_color }};
            --toolbar-border: {{ block.settings.border_color }};
            --toolbar-radius: {{ block.settings.button_radius }}px;
          "
        >
          <div class="hargx-collection-toolbar__inner">

            <div class="hargx-collection-toolbar__left">

              {%- if block.settings.show_product_count -%}
                <div class="hargx-collection-toolbar__count">
                  {{ collection.products_count }}
                  {{ collection.products_count | pluralize: 'product', 'products' }}
                </div>
              {%- endif -%}

              {%- if block.settings.show_filter_button -%}
                <button
                  type="button"
                  class="hargx-collection-toolbar__filter-button"
                  data-hargx-filter-open
                  aria-controls="HargxFilterDrawer-{{ section.id }}"
                  aria-expanded="false"
                >
                  <span class="hargx-collection-toolbar__filter-icon">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M4 6h16M7 12h10M10 18h4" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
                    </svg>
                  </span>

                  <span>{{ block.settings.filter_label }}</span>

                  {%- assign active_filter_count = 0 -%}

                  {%- for filter in collection.filters -%}
                    {%- assign active_filter_count = active_filter_count | plus: filter.active_values.size -%}

                    {%- if filter.type == 'price_range' -%}
                      {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
                        {%- assign active_filter_count = active_filter_count | plus: 1 -%}
                      {%- endif -%}
                    {%- endif -%}
                  {%- endfor -%}

                  <span
                    class="hargx-collection-toolbar__filter-count"
                    data-hargx-filter-count
                    {% if active_filter_count == 0 %}hidden{% endif %}
                  >
                    {{ active_filter_count }}
                  </span>
                </button>
              {%- endif -%}

            </div>

            {%- if block.settings.show_sorting -%}
              <div class="hargx-collection-toolbar__sorting">

                <label for="HargxSort-{{ section.id }}">
                  {{ block.settings.sort_label }}
                </label>

                <select
                  id="HargxSort-{{ section.id }}"
                  name="sort_by"
                  data-hargx-sort
                >
                  {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}

                  {%- for option in collection.sort_options -%}
                    <option
                      value="{{ option.value }}"
                      {% if option.value == current_sort %}selected{% endif %}
                    >
                      {{ option.name }}
                    </option>
                  {%- endfor -%}
                </select>

                <span class="hargx-collection-toolbar__sort-icon">
                  <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="m7 10 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>

              </div>
            {%- endif -%}

          </div>
        </div>

      {%- endif -%}
    {%- endfor -%}


    {%- comment -%}
      ==========================================
      FILTER DRAWER - MOBILE
      ==========================================
    {%- endcomment -%}

    <div
      id="HargxFilterDrawer-{{ section.id }}"
      class="hargx-filter-drawer"
      data-hargx-filter-drawer
      hidden
    >
      <div class="hargx-filter-drawer__overlay" data-hargx-filter-close></div>

      <div
        class="hargx-filter-drawer__panel"
        role="dialog"
        aria-modal="true"
        aria-labelledby="HargxFilterDrawerTitle-{{ section.id }}"
      >

        <div class="hargx-filter-drawer__header">
          <h2 id="HargxFilterDrawerTitle-{{ section.id }}">
            Filters
          </h2>

          <button
            type="button"
            class="hargx-filter-drawer__close"
            data-hargx-filter-close
            aria-label="Close filters"
          >
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="m6 6 12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            </svg>
          </button>
        </div>

        <form
          class="hargx-filter-form"
          data-hargx-filter-form
        >

          {%- for filter in collection.filters -%}

            <details
              class="hargx-filter-group"
              {% if filter.active_values.size > 0 %}open{% endif %}
            >
              <summary>
                <span>
                  {{ filter.label }}
                </span>

                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m7 10 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </summary>

              <div class="hargx-filter-group__content">

                {%- case filter.type -%}

                  {%- when 'boolean' -%}

                    <label class="hargx-filter-option">
                      <input
                        type="checkbox"
                        name="{{ filter.param_name }}"
                        value="{{ filter.true_value.value }}"
                        {% if filter.true_value.active %}checked{% endif %}
                      >

                      <span class="hargx-filter-option__box"></span>

                      <span class="hargx-filter-option__label">
                        {{ filter.true_value.label }}
                      </span>

                      <span class="hargx-filter-option__count">
                        {{ filter.true_value.count }}
                      </span>
                    </label>

                  {%- when 'list' -%}

                    {%- for value in filter.values -%}

                      <label class="hargx-filter-option">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}
                        >

                        <span class="hargx-filter-option__box"></span>

                        <span class="hargx-filter-option__label">
                          {{ value.label }}
                        </span>

                        <span class="hargx-filter-option__count">
                          {{ value.count }}
                        </span>
                      </label>

                    {%- endfor -%}

                  {%- when 'price_range' -%}

                    <div class="hargx-price-range">

                      <div class="hargx-price-range__fields">

                        <div class="hargx-price-range__field">
                          <label for="HargxPriceMin-{{ section.id }}-{{ forloop.index }}">
                            Min
                          </label>

                          <div class="hargx-price-range__input">
                            <span>{{ cart.currency.symbol }}</span>

                            <input
                              id="HargxPriceMin-{{ section.id }}-{{ forloop.index }}"
                              type="number"
                              name="{{ filter.min_value.param_name }}"
                              min="0"
                              max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                              value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                              placeholder="0"
                            >
                          </div>
                        </div>

                        <div class="hargx-price-range__field">
                          <label for="HargxPriceMax-{{ section.id }}-{{ forloop.index }}">
                            Max
                          </label>

                          <div class="hargx-price-range__input">
                            <span>{{ cart.currency.symbol }}</span>

                            <input
                              id="HargxPriceMax-{{ section.id }}-{{ forloop.index }}"
                              type="number"
                              name="{{ filter.max_value.param_name }}"
                              min="0"
                              max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                              value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                              placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                            >
                          </div>
                        </div>

                      </div>

                    </div>

                {%- endcase -%}

              </div>
            </details>

          {%- endfor -%}

          <div class="hargx-filter-drawer__actions">

            <button
              type="button"
              class="hargx-filter-button hargx-filter-button--secondary"
              data-hargx-filter-clear
            >
              Clear all
            </button>

            <button
              type="submit"
              class="hargx-filter-button hargx-filter-button--primary"
            >
              Apply filters
            </button>

          </div>

        </form>

      </div>
    </div>


    {%- comment -%}
      ==========================================
      PRODUCTS + DESKTOP SIDEBAR
      ==========================================
    {%- endcomment -%}

    <div class="hargx-collection-products-layout">

      {%- for block in section.blocks -%}

        {%- if block.type == 'filters' -%}

          <aside
            class="hargx-collection-filters"
            {{ block.shopify_attributes }}
          >

            <div class="hargx-collection-filters__header">

              <div>
                <span class="hargx-collection-filters__eyebrow">
                  {{ block.settings.eyebrow }}
                </span>

                <h2>
                  {{ block.settings.heading }}
                </h2>
              </div>

              <span
                class="hargx-collection-filters__active-count"
                data-hargx-filter-count-desktop
                {% if active_filter_count == 0 %}hidden{% endif %}
              >
                {{ active_filter_count }}
              </span>

            </div>

            <form
              class="hargx-filter-form hargx-filter-form--desktop"
              data-hargx-filter-form
            >

              {%- for filter in collection.filters -%}

                <details
                  class="hargx-filter-group"
                  {% if filter.active_values.size > 0 %}open{% endif %}
                >
                  <summary>
                    <span>
                      {{ filter.label }}
                    </span>

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="m7 10 5 5 5-5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                    </svg>
                  </summary>

                  <div class="hargx-filter-group__content">

                    {%- case filter.type -%}

                      {%- when 'boolean' -%}

                        <label class="hargx-filter-option">
                          <input
                            type="checkbox"
                            name="{{ filter.param_name }}"
                            value="{{ filter.true_value.value }}"
                            {% if filter.true_value.active %}checked{% endif %}
                          >

                          <span class="hargx-filter-option__box"></span>

                          <span class="hargx-filter-option__label">
                            {{ filter.true_value.label }}
                          </span>

                          <span class="hargx-filter-option__count">
                            {{ filter.true_value.count }}
                          </span>
                        </label>

                      {%- when 'list' -%}

                        {%- for value in filter.values -%}

                          <label class="hargx-filter-option">
                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}checked{% endif %}
                              {% if value.count == 0 and value.active == false %}disabled{% endif %}
                            >

                            <span class="hargx-filter-option__box"></span>

                            <span class="hargx-filter-option__label">
                              {{ value.label }}
                            </span>

                            <span class="hargx-filter-option__count">
                              {{ value.count }}
                            </span>
                          </label>

                        {%- endfor -%}

                      {%- when 'price_range' -%}

                        <div class="hargx-price-range">

                          <div class="hargx-price-range__fields">

                            <div class="hargx-price-range__field">
                              <label>
                                Min
                              </label>

                              <div class="hargx-price-range__input">
                                <span>{{ cart.currency.symbol }}</span>

                                <input
                                  type="number"
                                  name="{{ filter.min_value.param_name }}"
                                  min="0"
                                  max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                                  value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                                  placeholder="0"
                                >
                              </div>
                            </div>

                            <div class="hargx-price-range__field">
                              <label>
                                Max
                              </label>

                              <div class="hargx-price-range__input">
                                <span>{{ cart.currency.symbol }}</span>

                                <input
                                  type="number"
                                  name="{{ filter.max_value.param_name }}"
                                  min="0"
                                  max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                                  value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                                  placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                                >
                              </div>
                            </div>

                          </div>

                        </div>

                    {%- endcase -%}

                  </div>
                </details>

              {%- endfor -%}

              <div class="hargx-collection-filters__actions">

                <button
                  type="button"
                  class="hargx-filter-button hargx-filter-button--secondary"
                  data-hargx-filter-clear
                >
                  Clear all
                </button>

                <button
                  type="submit"
                  class="hargx-filter-button hargx-filter-button--primary"
                >
                  {{ block.settings.apply_label }}
                </button>

              </div>

            </form>

          </aside>

        {%- endif -%}

      {%- endfor -%}


      <div class="hargx-collection-products">

        <div
          class="hargx-collection-products__grid"
          style="
            --desktop-columns: {{ desktop_columns }};
            --mobile-columns: {{ mobile_columns }};
            --grid-gap: {{ section.settings.grid_gap }}px;
            --card-radius: {{ section.settings.card_radius }}px;
          "
        >

          {%- if collection.products.size > 0 -%}

            {%- for product in collection.products -%}

              <article class="hargx-product-card">

                <div class="hargx-product-card__media">

                  <a
                    href="{{ product.url }}"
                    class="hargx-product-card__image-link"
                    aria-label="{{ product.title | escape }}"
                  >

                    {%- if product.featured_image != blank -%}

                      {{
                        product.featured_image
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '360, 540, 720, 900',
                          sizes: '(min-width: 990px) 25vw, 50vw',
                          class: 'hargx-product-card__image hargx-product-card__image--primary',
                          alt: product.featured_image.alt | escape
                      }}

                    {%- else -%}

                      {{ 'product-1' | placeholder_svg_tag: 'hargx-product-card__image hargx-product-card__image--placeholder' }}

                    {%- endif -%}


                    {%- if section.settings.show_second_image and product.images.size > 1 -%}

                      {{
                        product.images[1]
                        | image_url: width: 900
                        | image_tag:
                          loading: 'lazy',
                          widths: '360, 540, 720, 900',
                          sizes: '(min-width: 990px) 25vw, 50vw',
                          class: 'hargx-product-card__image hargx-product-card__image--secondary',
                          alt: product.images[1].alt | escape
                      }}

                    {%- endif -%}

                  </a>


                  {%- if section.settings.show_badges -%}

                    <div class="hargx-product-card__badges">

                      {%- if product.available == false -%}

                        <span class="hargx-product-card__badge hargx-product-card__badge--sold">
                          Sold out
                        </span>

                      {%- elsif product.compare_at_price > product.price -%}

                        <span class="hargx-product-card__badge">
                          Sale
                        </span>

                      {%- endif -%}

                    </div>

                  {%- endif -%}


                  {%- if section.settings.enable_quick_add and product.available -%}

                    <div class="hargx-product-card__quick-add">

                      {%- if product.has_only_default_variant -%}

                        <button
                          type="button"
                          class="hargx-product-card__quick-add-button"
                          data-hargx-quick-add
                          data-variant-id="{{ product.selected_or_first_available_variant.id }}"
                        >
                          <span>Add to cart</span>

                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </button>

                      {%- else -%}

                        <a
                          href="{{ product.url }}"
                          class="hargx-product-card__quick-add-button"
                        >
                          <span>Choose options</span>

                          <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                          </svg>
                        </a>

                      {%- endif -%}

                    </div>

                  {%- endif -%}

                </div>


                <div class="hargx-product-card__content">

                  {%- if section.settings.show_vendor and product.vendor != blank -%}
                    <div class="hargx-product-card__vendor">
                      {{ product.vendor }}
                    </div>
                  {%- endif -%}

                  <h3 class="hargx-product-card__title">
                    <a href="{{ product.url }}">
                      {{ product.title }}
                    </a>
                  </h3>


                  {%- if section.settings.show_rating -%}

                    <div class="hargx-product-card__rating">
                      <span aria-hidden="true">★★★★★</span>

                      {%- if section.settings.rating_text != blank -%}
                        <span>{{ section.settings.rating_text }}</span>
                      {%- endif -%}
                    </div>

                  {%- endif -%}


                  <div class="hargx-product-card__price">

                    {%- if product.compare_at_price > product.price -%}

                      <span class="hargx-product-card__price-current">
                        {{ product.price | money }}
                      </span>

                      <s class="hargx-product-card__price-compare">
                        {{ product.compare_at_price | money }}
                      </s>

                    {%- else -%}

                      <span class="hargx-product-card__price-current">
                        {{ product.price | money }}
                      </span>

                    {%- endif -%}

                  </div>

                </div>

              </article>

            {%- endfor -%}

          {%- else -%}

            <div class="hargx-collection-empty">

              <div class="hargx-collection-empty__icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <circle cx="11" cy="11" r="6.5" fill="none" stroke="currentColor" stroke-width="1.7"/>
                  <path d="m16 16 4 4" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
                </svg>
              </div>

              <h2>No products found</h2>

              <p>
                Try adjusting your filters or browse our full collection.
              </p>

              <a
                href="{{ routes.all_products_collection_url }}"
                class="hargx-collection-empty__button"
              >
                Browse all products
              </a>

            </div>

          {%- endif -%}

        </div>


        {%- if paginate.pages > 1 -%}

          <nav
            class="hargx-pagination"
            aria-label="Pagination"
          >

            {%- if paginate.previous -%}

              <a
                href="{{ paginate.previous.url }}"
                class="hargx-pagination__link"
                aria-label="Previous page"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m15 18-6-6 6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>

            {%- endif -%}


            {%- for part in paginate.parts -%}

              {%- if part.is_link -%}

                <a
                  href="{{ part.url }}"
                  class="hargx-pagination__link"
                >
                  {{ part.title }}
                </a>

              {%- else -%}

                <span
                  class="hargx-pagination__link hargx-pagination__link--current"
                  aria-current="page"
                >
                  {{ part.title }}
                </span>

              {%- endif -%}

            {%- endfor -%}


            {%- if paginate.next -%}

              <a
                href="{{ paginate.next.url }}"
                class="hargx-pagination__link"
                aria-label="Next page"
              >
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m9 18 6-6-6-6" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>

            {%- endif -%}

          </nav>

        {%- endif -%}

      </div>

    </div>

  </div>
</section>

{%- endpaginate -%}


<style>
  #HargxCollectionGrid-{{ section.id }} {
    --hargx-bg: {{ section.settings.background }};
    --hargx-text: {{ section.settings.text_color }};
    --hargx-accent: {{ section.settings.accent_color }};
    --hargx-border: {{ section.settings.border_color }};
    --hargx-card-bg: {{ section.settings.card_background }};
    --hargx-button-radius: {{ section.settings.button_radius }}px;
    background: var(--hargx-bg);
    color: var(--hargx-text);
  }

  #HargxCollectionGrid-{{ section.id }} .hargx-collection-grid-section__inner {
    width: min(100% - 40px, {{ section.settings.max_width }}px);
    margin: 0 auto;
  }

  /* =========================
     TOOLBAR
     ========================= */

  #HargxCollectionGrid-{{ section.id }} .hargx-collection-toolbar {
    border-top: 1px solid var(--toolbar-border);
    border-bottom: 1px solid var(--toolbar-border);
    background: var(--toolbar-bg);
    color: var(--toolbar-text);
  }

  #HargxCollectionGrid-{{ section.id }} .hargx-collection-toolbar__inner {
    min-height: 64px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  #HargxCollectionGrid-{{ section.id }} .hargx-collection-toolbar__left {
    display: flex;
    align-items: center;
    gap: 18px;
  }

  #HargxCollectionGrid-{{ section.id }} .hargx-collection-toolbar__count {
    font-size: 13px;
    letter-spacing: .02em;
  }

  #HargxCollectionGrid-{{ section.id }} .hargx-collection-toolbar__filter-button {
    appearance: none;
    border: 0;
    background: transparent;
    color: inherit;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    font: inherit;
    padding: 8px 0;
  }

  #HargxCollectionGrid-{{ section.id }} .hargx-collection-toolbar__filter-icon,
  #HargxCollectionGrid-{{ section.id }} .hargx-collection-toolbar__filter-icon svg {
    width: 18px;
    height: 18px;
  }

  #HargxCollectionGrid-{{ section.id }} .hargx-collection-toolbar__filter-count {
    min-width: 20px;
    height: 20px;
    padding: 0 6px;
    border-radius: 999px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--toolbar-accent);
    color: #fff;
    font-size: 11px;
    line-height: 1;
  }

  #HargxCollectionGrid-{{ section.id }} .hargx-collection-toolbar__sorting {
    position: relative;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  #HargxCollectionGrid-{{ section.id }} .hargx-collection-toolbar__sorting label {
    font-size: 13px;
    white-space: nowrap;
  }

  #HargxCollectionGrid-{{ section.id }} .hargx-collection-toolbar__sorting select {
    appearance: none;
    border: 1px solid var(--toolbar-border);
    background: var(--toolbar-bg);
    color: var(--toolbar-text);
    border-radius: var(--toolbar-radius);
    min-height: 42px;
    padding: 0 38px 0 13px;
    font: inherit;
    cursor: pointer;
  }

  #HargxCollectionGrid-{{ section.id }} .hargx-collection-toolbar__sort-icon {
    position: absolute;
    right: 12px;
    pointer-events: none;
  }

