<script>
  (() => {
    const section = document.getElementById('HargxCollectionGrid-{{ section.id }}');

    if (!section) return;

    /*
     * ==========================================
     * SORTING
     * ==========================================
     */

    const sortSelect = section.querySelector('[data-hargx-sort]');

    if (sortSelect) {
      sortSelect.addEventListener('change', () => {
        const url = new URL(window.location.href);

        url.searchParams.set('sort_by', sortSelect.value);
        url.searchParams.delete('page');

        window.location.href = url.toString();
      });
    }


    /*
     * ==========================================
     * FILTER DRAWER
     * ==========================================
     */

    const drawer = section.querySelector('[data-hargx-filter-drawer]');
    const openButton = section.querySelector('[data-hargx-filter-open]');
    const closeButtons = section.querySelectorAll('[data-hargx-filter-close]');

    const openDrawer = () => {
      if (!drawer) return;

      drawer.hidden = false;

      requestAnimationFrame(() => {
        drawer.classList.add('is-open');
      });

      if (openButton) {
        openButton.setAttribute('aria-expanded', 'true');
      }

      document.documentElement.classList.add('hargx-filter-open');
      document.body.classList.add('hargx-filter-open');
    };

    const closeDrawer = () => {
      if (!drawer) return;

      drawer.classList.remove('is-open');

      if (openButton) {
        openButton.setAttribute('aria-expanded', 'false');
      }

      document.documentElement.classList.remove('hargx-filter-open');
      document.body.classList.remove('hargx-filter-open');

      setTimeout(() => {
        if (!drawer.classList.contains('is-open')) {
          drawer.hidden = true;
        }
      }, 300);
    };

    if (openButton) {
      openButton.addEventListener('click', openDrawer);
    }

    closeButtons.forEach((button) => {
      button.addEventListener('click', closeDrawer);
    });


    /*
     * ==========================================
     * FILTER SUBMIT
     * ==========================================
     */

    const filterForms = section.querySelectorAll('[data-hargx-filter-form]');

    filterForms.forEach((form) => {

      form.addEventListener('submit', (event) => {
        event.preventDefault();

        const params = new URLSearchParams();

        form.querySelectorAll('input').forEach((input) => {

          if (!input.name || input.disabled) return;

          if ((input.type === 'checkbox' || input.type === 'radio') && !input.checked) {
            return;
          }

          if (input.value === '') return;

          params.append(input.name, input.value);

        });


        /*
         * Preserve current sorting.
         */
        const currentUrl = new URL(window.location.href);
        const currentSort = currentUrl.searchParams.get('sort_by');

        if (currentSort) {
          params.set('sort_by', currentSort);
        }


        const queryString = params.toString();

        window.location.href =
          window.location.pathname +
          (queryString ? '?' + queryString : '');
      });

    });


    /*
     * ==========================================
     * CLEAR FILTERS
     * ==========================================
     */

    section.querySelectorAll('[data-hargx-filter-clear]').forEach((button) => {

      button.addEventListener('click', () => {

        const currentUrl = new URL(window.location.href);
        const sort = currentUrl.searchParams.get('sort_by');

        const url = new URL(window.location.pathname, window.location.origin);

        if (sort) {
          url.searchParams.set('sort_by', sort);
        }

        window.location.href = url.toString();

      });

    });


    /*
     * ==========================================
     * QUICK ADD
     * ==========================================
     */

    section.querySelectorAll('[data-hargx-quick-add]').forEach((button) => {

      button.addEventListener('click', async () => {

        const variantId = button.dataset.variantId;

        if (!variantId) return;

        const originalHTML = button.innerHTML;

        button.disabled = true;
        button.classList.add('is-loading');
        button.innerHTML = '<span>Adding...</span>';

        try {

          const response = await fetch(
            window.Shopify.routes.root + 'cart/add.js',
            {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({
                items: [
                  {
                    id: Number(variantId),
                    quantity: 1
                  }
                ]
              })
            }
          );

          if (!response.ok) {
            throw new Error('Unable to add product.');
          }

          await response.json();

          document.dispatchEvent(
            new CustomEvent('hargx:cart:updated')
          );

          if (typeof window.refreshCart === 'function') {
            window.refreshCart();
          }

          button.innerHTML = '<span>Added</span>';

          setTimeout(() => {
            button.innerHTML = originalHTML;
            button.disabled = false;
            button.classList.remove('is-loading');
          }, 1400);

        } catch (error) {

          console.error(error);

          button.innerHTML = '<span>Try again</span>';

          setTimeout(() => {
            button.innerHTML = originalHTML;
            button.disabled = false;
            button.classList.remove('is-loading');
          }, 1600);

        }

      });

    });

  })();
</script>


