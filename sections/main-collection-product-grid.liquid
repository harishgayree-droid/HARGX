{{ 'main-collection-product.css' | asset_url | stylesheet_tag }}
{%- liquid
  assign products_per_page = section.settings.products_per_page
  assign desktop_columns = section.settings.desktop_columns
  assign mobile_columns = section.settings.mobile_columns
  assign desktop_filter_layout = section.settings.desktop_filter_layout
-%}

{%- paginate collection.products by products_per_page -%}

<section
  id="HargxCollectionGrid-{{ section.id }}"
  class="
    hargx-collection
    {% if desktop_filter_layout == 'drawer' %}hargx-collection--filter-drawer{% endif %}
  "
  data-section-id="{{ section.id }}"
>

  <div class="hargx-collection__container page-width">


    {%- comment -%}
      Collection Header
    {%- endcomment -%}

    <header class="hargx-collection__header">

      <h1 class="hargx-collection__title">
        {{ collection.title | escape }}
      </h1>


      {%- if collection.description != blank -%}

        <div class="hargx-collection__description rte">
          {{ collection.description }}
        </div>

      {%- endif -%}

    </header>


    {%- comment -%}
      Mobile Filter Trigger + Drawer

      Rendered at the top level so the drawer is completely
      independent from the product grid layout.
    {%- endcomment -%}

    {%- if collection.filters.size > 0 -%}


      <div
        id="HargxFilterDrawer-{{ section.id }}"
        class="hargx-filter-drawer"
        data-hargx-filter-drawer
        hidden
      >

        <div
          class="hargx-filter-drawer__overlay"
          data-hargx-filter-close
        ></div>


        <aside
          class="hargx-filter-drawer__panel"
          role="dialog"
          aria-modal="true"
          aria-label="Filters"
        >

          <div class="hargx-filter-drawer__header">

            <h2>Filters</h2>

            <button
              type="button"
              class="hargx-filter-drawer__close"
              data-hargx-filter-close
              aria-label="Close filters"
            >
              ×
            </button>

          </div>


          <div class="hargx-filter-drawer__content">

            {%- for filter in collection.filters -%}

              <details
                class="hargx-filter"
                {% if filter.active_values.size > 0 %}open{% endif %}
              >

                <summary class="hargx-filter__summary">

                  <span class="hargx-filter__title">
                    {{ filter.label }}
                  </span>

                  <span
                    class="hargx-filter__icon"
                    aria-hidden="true"
                  >
                    +
                  </span>

                </summary>


                <div class="hargx-filter__content">

                  {% render 'hargx-filters', filter: filter %}

                </div>

              </details>

            {%- endfor -%}

          </div>


          <div class="hargx-filter-drawer__footer">

            <a
              href="{{ collection.url }}"
              class="hargx-filter-drawer__clear"
            >
              Clear all
            </a>

            <button
              type="button"
              class="hargx-filter-drawer__apply"
              data-hargx-filter-apply
            >
              Done
            </button>

          </div>

        </aside>

      </div>

    {%- endif -%}


    {%- comment -%}
      Collection Toolbar
    {%- endcomment -%}

    <div class="hargx-collection__toolbar">

      <div class="hargx-collection__toolbar-count-wrap">

        {%- if collection.filters.size > 0 and desktop_filter_layout == 'drawer' -%}

          <button
            type="button"
            class="hargx-filter-trigger"
            data-hargx-filter-open
            aria-controls="HargxFilterDrawer-{{ section.id }}"
          >
            Filter
          </button>

        {%- endif -%}

        <div class="hargx-collection__toolbar-count">
          {{ collection.products_count }}
          {{ collection.products_count | pluralize: 'product', 'products' }}
        </div>

      </div>

      <div class="hargx-collection__toolbar-sort">

        <label
          for="HargxSortBy-{{ section.id }}"
          class="hargx-collection__sort-label"
        >
          Sort by
        </label>


        <div class="hargx-collection__sort-select-wrap">

          <select
            id="HargxSortBy-{{ section.id }}"
            class="hargx-collection__sort-select"
            name="sort_by"
            data-hargx-sort
          >

            {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}

            {%- for option in collection.sort_options -%}

              <option
                value="{{ option.value }}"
                {% if option.value == current_sort %}selected{% endif %}
              >
                {{ option.name }}
              </option>

            {%- endfor -%}

          </select>


          <span
            class="hargx-collection__sort-icon"
            aria-hidden="true"
          >
            ↓
          </span>

        </div>

      </div>

    </div>


    {%- comment -%}
      Collection Filters + Products
    {%- endcomment -%}

    {%- if collection.filters.size > 0 -%}

      <div
        class="
          hargx-collection__filter-system
          hargx-collection__filter-system--{{ desktop_filter_layout }}
        "
        data-filter-layout="{{ desktop_filter_layout }}"
      >

        {%- comment -%}
          Desktop Horizontal Filters
        {%- endcomment -%}

        {%- if desktop_filter_layout == 'horizontal' -%}

          <div class="hargx-collection__horizontal-filters">

            {%- for filter in collection.filters -%}

              <details class="hargx-filter hargx-filter--horizontal">

                <summary class="hargx-filter__summary">

                  <span class="hargx-filter__title">
                    {{ filter.label }}
                  </span>

                  <span
                    class="hargx-filter__icon"
                    aria-hidden="true"
                  >
                    +
                  </span>

                </summary>


                <div class="hargx-filter__dropdown">

                  {% render 'hargx-filters', filter: filter %}

                </div>

              </details>

            {%- endfor -%}

          </div>

        {%- endif -%}


        {%- comment -%}
          Desktop Vertical Filters
        {%- endcomment -%}

        {%- if desktop_filter_layout == 'vertical' -%}

          <aside
            class="hargx-collection__filters"
            aria-label="Collection filters"
          >

            <div class="hargx-collection__filters-header">

              <h2>
                Filter
              </h2>

            </div>


            {%- for filter in collection.filters -%}

              <details
                class="hargx-filter"
                {% if filter.active_values.size > 0 %}open{% endif %}
              >

                <summary class="hargx-filter__summary">

                  <span class="hargx-filter__title">
                    {{ filter.label }}
                  </span>

                  <span
                    class="hargx-filter__icon"
                    aria-hidden="true"
                  >
                    +
                  </span>

                </summary>


                <div class="hargx-filter__content">

                  {% render 'hargx-filters', filter: filter %}

                </div>

              </details>

            {%- endfor -%}


            <a
              href="{{ collection.url }}"
              class="hargx-filter__clear"
            >
              Clear all
            </a>

          </aside>

        {%- endif -%}


        {%- comment -%}
          Product Grid
        {%- endcomment -%}

        <div class="hargx-collection__products">

          {%- if collection.products.size > 0 -%}

            <div
              class="hargx-collection__grid"
              style="
                --hargx-desktop-columns: {{ desktop_columns }};
                --hargx-mobile-columns: {{ mobile_columns }};
              "
            >

              {%- for product in collection.products -%}

                {% render 'hargx-product-card', product: product %}

              {%- endfor -%}

            </div>

          {%- else -%}

            <div class="hargx-collection__empty">

              <h2>
                No products found
              </h2>

              <p>
                There are currently no products matching your selection.
              </p>

            </div>

          {%- endif -%}

        </div>

      </div>


    {%- else -%}

      {%- comment -%}
        No Filters Available
      {%- endcomment -%}

      <div class="hargx-collection__products">

        {%- if collection.products.size > 0 -%}

          <div
            class="hargx-collection__grid"
            style="
              --hargx-desktop-columns: {{ desktop_columns }};
              --hargx-mobile-columns: {{ mobile_columns }};
            "
          >

            {%- for product in collection.products -%}

              {% render 'hargx-product-card', product: product %}

            {%- endfor -%}

          </div>

        {%- else -%}

          <div class="hargx-collection__empty">

            <h2>
              No products found
            </h2>

            <p>
              There are currently no products in this collection.
            </p>

          </div>

        {%- endif -%}

      </div>

    {%- endif -%}


    {%- comment -%}
      Pagination
    {%- endcomment -%}

    {%- if paginate.pages > 1 -%}

      <nav
        class="hargx-pagination"
        aria-label="Pagination"
      >

        {%- if paginate.previous -%}

          <a
            href="{{ paginate.previous.url }}"
            class="hargx-pagination__link"
          >
            Previous
          </a>

        {%- endif -%}


        <div class="hargx-pagination__pages">

          {%- for part in paginate.parts -%}

            {%- if part.is_link -%}

              <a
                href="{{ part.url }}"
                class="hargx-pagination__page"
              >
                {{ part.title }}
              </a>

            {%- else -%}

              <span
                class="
                  hargx-pagination__page
                  {% if part.title == paginate.current_page %}
                    is-current
                  {% endif %}
                "
              >
                {{ part.title }}
              </span>

            {%- endif -%}

          {%- endfor -%}

        </div>


        {%- if paginate.next -%}

          <a
            href="{{ paginate.next.url }}"
            class="hargx-pagination__link"
          >
            Next
          </a>

        {%- endif -%}

      </nav>

    {%- endif -%}

  </div>

</section>

{%- endpaginate -%}



{% schema %}

{
  "name": "HARGX Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
        "type": "select",
        "id": "desktop_filter_layout",
        "label": "Desktop filter layout",
        "options": [
            {
            "value": "vertical",
            "label": "Vertical sidebar"
            },
            {
            "value": "horizontal",
            "label": "Horizontal"
            },
            {
            "value": "drawer",
            "label": "Drawer"
            }
        ],
        "default": "vertical"
    }
  ],

  "presets": [
    {
      "name": "HARGX Collection Grid"
    }
  ]
}

{% endschema %}