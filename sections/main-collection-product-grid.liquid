{%- liquid
  assign products_per_page = section.settings.products_per_page
  assign desktop_columns = section.settings.desktop_columns
  assign mobile_columns = section.settings.mobile_columns
-%}

{%- paginate collection.products by products_per_page -%}

<section
  id="HargxCollectionGrid-{{ section.id }}"
  class="hargx-collection"
  data-section-id="{{ section.id }}"
>

  <div class="hargx-collection__container page-width">

    {%- comment -%}
      Collection Header
    {%- endcomment -%}

    <header class="hargx-collection__header">

      <h1 class="hargx-collection__title">
        {{ collection.title | escape }}
      </h1>

      {%- if collection.description != blank -%}
        <div class="hargx-collection__description rte">
          {{ collection.description }}
        </div>
      {%- endif -%}

    </header>

    {%- comment -%}
    Collection Toolbar
    {%- endcomment -%}

    <div class="hargx-collection__toolbar">

        <div class="hargx-collection__toolbar-count">
            {{ collection.products_count }}
            {{ collection.products_count | pluralize: 'product', 'products' }}
        </div>


        <div class="hargx-collection__toolbar-sort">

            <label
            for="HargxSortBy-{{ section.id }}"
            class="hargx-collection__sort-label"
            >
            Sort by
            </label>

            <div class="hargx-collection__sort-select-wrap">

            <select
                id="HargxSortBy-{{ section.id }}"
                class="hargx-collection__sort-select"
                name="sort_by"
                data-hargx-sort
            >

                {%- assign current_sort = collection.sort_by | default: collection.default_sort_by -%}

                {%- for option in collection.sort_options -%}

                <option
                    value="{{ option.value }}"
                    {% if option.value == current_sort %}selected{% endif %}
                >
                    {{ option.name }}
                </option>

                {%- endfor -%}

            </select>

            <span class="hargx-collection__sort-icon" aria-hidden="true">
                ↓
            </span>

            </div>

        </div>

    </div>

    {%- if collection.filters.size > 0 -%}

        <div
            class="
            hargx-collection__filter-system
            hargx-collection__filter-system--{{ section.settings.desktop_filter_layout }}
            "
            data-filter-layout="{{ section.settings.desktop_filter_layout }}"
        >

            {%- comment -%}
            Desktop Horizontal Filters
            {%- endcomment -%}

            {%- if section.settings.desktop_filter_layout == 'horizontal' -%}

            <div class="hargx-collection__horizontal-filters">

                {%- for filter in collection.filters -%}

                <details class="hargx-filter hargx-filter--horizontal">

                    <summary class="hargx-filter__summary">

                    <span class="hargx-filter__title">
                        {{ filter.label }}
                    </span>

                    <span class="hargx-filter__icon" aria-hidden="true">
                        +
                    </span>

                    </summary>

                    <div class="hargx-filter__dropdown">

                    {% render 'hargx-filters', filter: filter %}

                    </div>

                </details>

                {%- endfor -%}
 
            </div>

            {%- endif -%}


            {%- comment -%}
            Desktop Vertical Filters
            {%- endcomment -%}

            {%- if section.settings.desktop_filter_layout == 'vertical' -%}

            <aside
                class="hargx-collection__filters"
                aria-label="Collection filters"
            >

                <div class="hargx-collection__filters-header">
                <h2>Filter</h2>
                </div>

                {%- for filter in collection.filters -%}

                <details
                    class="hargx-filter"
                    {% if filter.active_values.size > 0 %}open{% endif %}
                >

                    <summary class="hargx-filter__summary">

                    <span class="hargx-filter__title">
                        {{ filter.label }}
                    </span>

                    <span class="hargx-filter__icon" aria-hidden="true">
                        +
                    </span>

                    </summary>

                    <div class="hargx-filter__content">

                    {% render 'hargx-filters', filter: filter %}

                    </div>

                </details>

                {%- endfor -%}

                <a
                href="{{ collection.url }}"
                class="hargx-filter__clear"
                >
                Clear all
                </a>

            </aside>

        {%- endif -%}


            {%- comment -%}
            Products
            {%- endcomment -%}

            <div class="hargx-collection__products">

            <div class="hargx-collection__grid">

                {%- for product in collection.products -%}

                {% render 'hargx-product-card', product: product %}

                {%- endfor -%}

            </div>

            </div>

        </div>

        {%- else -%}

        <div class="hargx-collection__products">

            <div class="hargx-collection__grid">

            {%- for product in collection.products -%}

                {% render 'hargx-product-card', product: product %}

            {%- endfor -%}

            </div>

        </div>

    {%- endif -%}

    {%- if section.settings.desktop_filter_layout == 'drawer' -%}

      <button
        type="button"
        class="hargx-filter-trigger"
        data-hargx-filter-open
        aria-controls="HargxFilterDrawer-{{ section.id }}"
      >
        Filter
      </button>


      <div
        id="HargxFilterDrawer-{{ section.id }}"
        class="hargx-filter-drawer"
        data-hargx-filter-drawer
        hidden
      >

        <div
          class="hargx-filter-drawer__overlay"
          data-hargx-filter-close
        ></div>

        <aside
          class="hargx-filter-drawer__panel"
          role="dialog"
          aria-modal="true"
          aria-label="Filters"
        >

          <div class="hargx-filter-drawer__header">

            <h2>Filters</h2>

            <button
              type="button"
              class="hargx-filter-drawer__close"
              data-hargx-filter-close
              aria-label="Close filters"
            >
              ×
            </button>

          </div>


          <div class="hargx-filter-drawer__content">

            {%- for filter in collection.filters -%}

              <details
                class="hargx-filter"
                {% if filter.active_values.size > 0 %}open{% endif %}
              >

                <summary class="hargx-filter__summary">

                  <span class="hargx-filter__title">
                    {{ filter.label }}
                  </span>

                  <span class="hargx-filter__icon">
                    +
                  </span>

                </summary>

                <div class="hargx-filter__content">

                  {% render 'hargx-filters', filter: filter %}

                </div>

              </details>

            {%- endfor -%}

          </div>


          <div class="hargx-filter-drawer__footer">

            <a
              href="{{ collection.url }}"
              class="hargx-filter-drawer__clear"
            >
              Clear all
            </a>

            <button
              type="button"
              class="hargx-filter-drawer__apply"
              data-hargx-filter-close
            >
              Done
            </button>

          </div>

        </aside>

      </div>

    {%- endif -%}

    {%- comment -%}
      Product Grid
    {%- endcomment -%}

    {%- if collection.products.size > 0 -%}

        <div
            class="hargx-collection__grid"
            style="
            --hargx-desktop-columns: {{ desktop_columns }};
            --hargx-mobile-columns: {{ mobile_columns }};
            "
        >

        {%- for product in collection.products -%}
            {% render 'hargx-product-card', product: product %}
        {%- endfor -%}

        </div>
    {%- else -%}

      <div class="hargx-collection__empty">
        <h2>No products found</h2>
        <p>There are currently no products in this collection.</p>
      </div>

    {%- endif -%}


    {%- comment -%}
      Pagination
    {%- endcomment -%}

    {%- if paginate.pages > 1 -%}

      <nav
        class="hargx-pagination"
        aria-label="Pagination"
      >

        {%- if paginate.previous -%}
          <a
            href="{{ paginate.previous.url }}"
            class="hargx-pagination__link"
          >
            Previous
          </a>
        {%- endif -%}


        <div class="hargx-pagination__pages">

          {%- for part in paginate.parts -%}

            {%- if part.is_link -%}

              <a
                href="{{ part.url }}"
                class="hargx-pagination__page"
              >
                {{ part.title }}
              </a>

            {%- else -%}

              <span
                class="hargx-pagination__page{% if part.title == paginate.current_page %} is-current{% endif %}"
              >
                {{ part.title }}
              </span>

            {%- endif -%}

          {%- endfor -%}

        </div>


        {%- if paginate.next -%}
          <a
            href="{{ paginate.next.url }}"
            class="hargx-pagination__link"
          >
            Next
          </a>
        {%- endif -%}

      </nav>

    {%- endif -%}

  </div>

</section>

{%- endpaginate -%}


{% stylesheet %}

  .hargx-collection {
    padding: 60px 0 80px;
  }

  .hargx-collection__container {
    max-width: 1400px;
    margin: 0 auto;
  }


  /* Collection Header */

  .hargx-collection__header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 50px;
  }

  .hargx-collection__title {
    margin: 0 0 16px;
    font-size: clamp(32px, 4vw, 56px);
    line-height: 1.05;
    font-weight: 600;
  }

  .hargx-collection__description {
    margin: 0 auto 18px;
    font-size: 16px;
    line-height: 1.6;
  }

  .hargx-collection__count {
    font-size: 13px;
    opacity: 0.65;
  }


  /* Product Grid */

  .hargx-collection__grid {
    display: grid;
    grid-template-columns: repeat(
      var(--hargx-desktop-columns),
      minmax(0, 1fr)
    );
    gap: 40px 24px;
  }


  /* Product Card */

.hargx-product-card {
  min-width: 0;
}

.hargx-product-card__link {
  display: block;
  color: inherit;
  text-decoration: none;
}

.hargx-product-card__media {
  position: relative;
  overflow: hidden;
  background: #FAF8F4;
  aspect-ratio: 1 / 1;
}

.hargx-product-card__image {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: opacity 0.4s ease, transform 0.5s ease;
}

.hargx-product-card__image--secondary {
  position: absolute;
  inset: 0;
  opacity: 0;
}

.hargx-product-card__link:hover
.hargx-product-card__image--primary {
  transform: scale(1.02);
}

.hargx-product-card__link:hover
.hargx-product-card__image--secondary {
  opacity: 1;
}

.hargx-product-card__placeholder {
  width: 100%;
  height: 100%;
}


/* Badges */

.hargx-product-card__badge {
  position: absolute;
  top: 12px;
  left: 12px;
  z-index: 2;
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  font-size: 11px;
  line-height: 1;
  letter-spacing: 0.03em;
  background: #FFFFFF;
}

.hargx-product-card__badge--sold-out {
  background: #000000;
  color: #FFFFFF;
}

.hargx-product-card__badge--sale {
  background: #FE7442;
  color: #FFFFFF;
}


/* Content */

.hargx-product-card__content {
  padding-top: 14px;
}

.hargx-product-card__title {
  margin: 0 0 7px;
  font-size: 15px;
  line-height: 1.4;
  font-weight: 500;
}

.hargx-product-card__price {
  display: flex;
  align-items: center;
  gap: 8px;
  font-size: 14px;
  line-height: 1.4;
}

.hargx-product-card__price-current {
  font-weight: 500;
}

.hargx-product-card__price-compare {
  opacity: 0.5;
}

  /* Pagination */

  .hargx-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 30px;
    margin-top: 70px;
  }

  .hargx-pagination__pages {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .hargx-pagination__link,
  .hargx-pagination__page {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 38px;
    min-height: 38px;
    padding: 6px 10px;
    color: inherit;
    text-decoration: none;
    font-size: 13px;
  }

  .hargx-pagination__page.is-current {
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 5px;
  }


  /* Empty State */

  .hargx-collection__empty {
    padding: 80px 20px;
    text-align: center;
  }

  .hargx-collection__empty h2 {
    margin: 0 0 10px;
  }

  .hargx-collection__empty p {
    margin: 0;
  }

/* =========================================================
   HARGX COLLECTION TOOLBAR
   ========================================================= */

.hargx-collection__toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;

  margin-bottom: 30px;
  padding: 16px 0;

  border-top: 1px solid rgba(0, 0, 0, 0.12);
  border-bottom: 1px solid rgba(0, 0, 0, 0.12);
}


/* Product Count */

.hargx-collection__toolbar-count {
  font-size: 13px;
  line-height: 1.4;
  opacity: 0.65;
}


/* Sorting */

.hargx-collection__toolbar-sort {
  display: flex;
  align-items: center;
  gap: 10px;
}

.hargx-collection__sort-label {
  font-size: 13px;
  line-height: 1.4;
  white-space: nowrap;
}

.hargx-collection__sort-select-wrap {
  position: relative;
  display: flex;
  align-items: center;
}

.hargx-collection__sort-select {
  appearance: none;
  -webkit-appearance: none;

  min-width: 180px;
  padding: 8px 30px 8px 4px;

  border: 0;
  border-radius: 0;

  background: transparent;
  color: inherit;

  font: inherit;
  font-size: 13px;
  line-height: 1.4;

  cursor: pointer;
}

.hargx-collection__sort-select:focus {
  outline: none;
}

.hargx-collection__sort-select:focus-visible {
  outline: 1px solid #000000;
  outline-offset: 3px;
}

.hargx-collection__sort-icon {
  position: absolute;
  right: 5px;
  top: 50%;

  pointer-events: none;

  transform: translateY(-50%);

  font-size: 13px;
  line-height: 1;
}


/* =========================================================
   MOBILE
   ========================================================= */

@media screen and (max-width: 749px) {

  .hargx-collection__toolbar {
    margin-bottom: 24px;
    padding: 12px 0;
  }

  .hargx-collection__toolbar-count {
    font-size: 12px;
  }

  .hargx-collection__toolbar-sort {
    gap: 5px;
  }

  .hargx-collection__sort-label {
    font-size: 12px;
  }

  .hargx-collection__sort-select {
    min-width: 125px;
    padding-right: 24px;
    font-size: 12px;
  }

}

/* =========================================================
   HARGX FILTER LAYOUT
   ========================================================= */

.hargx-collection__filter-system--vertical {
  display: grid;
  grid-template-columns: 230px minmax(0, 1fr);
  gap: 40px;
  align-items: start;
}

.hargx-collection__filter-system--vertical
.hargx-collection__filters {
  position: sticky;
  top: 30px;
}

.hargx-collection__filter-system--drawer {
  display: block;
}


/* =========================================================
   FILTER SIDEBAR
   ========================================================= */

.hargx-collection__filters {
  position: sticky;
  top: 30px;
}

.hargx-collection__filters-header {
  margin-bottom: 20px;
}

.hargx-collection__filters-header h2 {
  margin: 0;
  font-size: 14px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}


/* Individual filter */

.hargx-filter {
  border-top: 1px solid rgba(0, 0, 0, 0.12);
}

.hargx-filter:last-of-type {
  border-bottom: 1px solid rgba(0, 0, 0, 0.12);
}

.hargx-filter__summary {
  display: flex;
  align-items: center;
  justify-content: space-between;

  padding: 17px 0;

  cursor: pointer;
  list-style: none;
}

.hargx-filter__summary::-webkit-details-marker {
  display: none;
}

.hargx-filter__title {
  font-size: 13px;
  font-weight: 500;
}

.hargx-filter__icon {
  font-size: 18px;
  line-height: 1;
  transition: transform 0.25s ease;
}

.hargx-filter[open]
.hargx-filter__icon {
  transform: rotate(45deg);
}


/* Filter content */

.hargx-filter__content {
  padding: 0 0 17px;
}

.hargx-filter__options {
  display: flex;
  flex-direction: column;
  gap: 11px;
}


/* Checkbox */

.hargx-filter__checkbox {
  display: grid;
  grid-template-columns: 16px minmax(0, 1fr) auto;
  align-items: center;
  gap: 8px;

  font-size: 13px;
  line-height: 1.4;

  cursor: pointer;
}

.hargx-filter__checkbox input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.hargx-filter__checkbox-mark {
  width: 15px;
  height: 15px;

  border: 1px solid rgba(0, 0, 0, 0.35);

  transition:
    background 0.2s ease,
    border-color 0.2s ease;
}

.hargx-filter__checkbox input:checked
+ .hargx-filter__checkbox-mark {
  background: #000000;
  border-color: #000000;
}

.hargx-filter__label {
  min-width: 0;
}

.hargx-filter__count {
  font-size: 11px;
  opacity: 0.5;
}


/* Disabled */

.hargx-filter__checkbox input:disabled
~ .hargx-filter__label {
  opacity: 0.35;
}

.hargx-filter__checkbox:has(input:disabled) {
  cursor: not-allowed;
}


/* Price */

.hargx-filter__price {
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
}

.hargx-filter__price-field label {
  display: block;
  margin-bottom: 5px;

  font-size: 11px;
  opacity: 0.6;
}

.hargx-filter__price-input {
  display: flex;
  align-items: center;

  border: 1px solid rgba(0, 0, 0, 0.18);
}

.hargx-filter__price-input span {
  padding-left: 9px;
  font-size: 12px;
  opacity: 0.6;
}

.hargx-filter__price-input input {
  width: 100%;
  min-width: 0;
  padding: 9px;

  border: 0;
  background: transparent;

  font: inherit;
  font-size: 12px;
}

.hargx-filter__price-input input:focus {
  outline: none;
}


/* Clear */

.hargx-filter__clear {
  display: inline-block;

  margin-top: 18px;

  color: inherit;

  font-size: 12px;
  text-decoration: underline;
  text-underline-offset: 4px;
}

/* =========================================================
   HORIZONTAL FILTERS
   ========================================================= */

.hargx-collection__horizontal-filters {
  display: flex;
  align-items: center;
  gap: 10px;

  margin-bottom: 30px;
}

.hargx-filter--horizontal {
  position: relative;
  border: 1px solid rgba(0, 0, 0, 0.15);
}

.hargx-filter--horizontal .hargx-filter__summary {
  min-width: 140px;
  padding: 12px 14px;
}

.hargx-filter--horizontal .hargx-filter__dropdown {
  position: absolute;
  top: calc(100% + 8px);
  left: 0;

  z-index: 20;

  width: 280px;
  max-height: 420px;
  overflow-y: auto;

  padding: 18px;

  background: #FFFFFF;
  border: 1px solid rgba(0, 0, 0, 0.12);

  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);
}

.hargx-filter--horizontal[open] {
  z-index: 30;
}

  /* Mobile */

  @media screen and (max-width: 749px) {

    .hargx-collection {
      padding: 40px 0 60px;
    }

    .hargx-collection__header {
      margin-bottom: 30px;
    }

    .hargx-collection__grid {
      grid-template-columns: repeat(
        var(--hargx-mobile-columns),
        minmax(0, 1fr)
      );
      gap: 30px 12px;
    }

    .hargx-product-card__content {
      padding-top: 10px;
    }

    .hargx-product-card__title {
      font-size: 14px;
    }

    .hargx-product-card__price {
      font-size: 13px;
    }

    .hargx-pagination {
      margin-top: 50px;
      gap: 15px;
    }

  }

{% endstylesheet %}


{% schema %}

{
  "name": "HARGX Collection Grid",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "range",
      "id": "desktop_columns",
      "label": "Desktop columns",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Mobile columns",
      "options": [
        {
          "value": "1",
          "label": "1 column"
        },
        {
          "value": "2",
          "label": "2 columns"
        }
      ],
      "default": "2"
    },
    {
        "type": "select",
        "id": "desktop_filter_layout",
        "label": "Desktop filter layout",
        "options": [
            {
            "value": "vertical",
            "label": "Vertical sidebar"
            },
            {
            "value": "horizontal",
            "label": "Horizontal"
            },
            {
            "value": "drawer",
            "label": "Drawer"
            }
        ],
        "default": "vertical"
    }
  ],

  "presets": [
    {
      "name": "HARGX Collection Grid"
    }
  ]
}

{% endschema %}