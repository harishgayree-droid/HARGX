<header
  class="hargx-header hargx-header--{{ section.settings.header_layout }}"
  {% if section.settings.sticky_header %}
    data-sticky-header
  {% endif %}
>
  <div class="hargx-header__inner">

    <!-- Mobile Menu Button -->
    <button
      type="button"
      class="hargx-header__mobile-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="HargxMobileMenu-{{ section.id }}"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- Logo -->
    <a
      href="{{ routes.root_url }}"
      class="hargx-header__logo"
      aria-label="{{ shop.name }}"
    >
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: section.settings.logo_width
          | image_tag:
            widths: '100,150,200,250,300',
            loading: 'eager',
            alt: shop.name
        }}
      {% else %}
        <span>{{ shop.name }}</span>
      {% endif %}
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hargx-header__nav"
      aria-label="Main navigation"
    >
      {% for link in section.settings.menu.links %}

        <div
          class="
            hargx-header__nav-item
            {% if link.links != blank %}has-dropdown{% endif %}
            {% if section.settings.header_layout == 'mega-menu' and link.links != blank %}
              has-mega-menu
            {% endif %}
          "
        >

          <a
            href="{{ link.url }}"
            class="hargx-header__nav-link"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{ link.title }}

            {% if link.links != blank %}
              <span
                class="hargx-header__chevron"
                aria-hidden="true"
              >
                ↓
              </span>
            {% endif %}
          </a>

          {% if link.links != blank %}

            {% if section.settings.header_layout == 'mega-menu' %}

              <!-- MEGA MENU -->
              <div class="hargx-header__mega-menu">

                <div class="hargx-header__mega-inner">

                  {% for child_link in link.links %}

                    <div class="hargx-header__mega-column">

                      <a
                        href="{{ child_link.url }}"
                        class="hargx-header__mega-heading"
                        {% if child_link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ child_link.title }}
                      </a>

                      {% if child_link.links != blank %}

                        <div class="hargx-header__mega-links">

                          {% for grandchild_link in child_link.links %}

                            <a
                              href="{{ grandchild_link.url }}"
                              class="hargx-header__mega-link"
                              {% if grandchild_link.current %}
                                aria-current="page"
                              {% endif %}
                            >
                              {{ grandchild_link.title }}
                            </a>

                          {% endfor %}

                        </div>

                      {% endif %}

                    </div>

                  {% endfor %}

                </div>

              </div>

            {% else %}

              <!-- STANDARD DROPDOWN -->
              <div class="hargx-header__dropdown">

                {% for child_link in link.links %}

                  <div class="hargx-header__dropdown-item">

                    <a
                      href="{{ child_link.url }}"
                      class="hargx-header__dropdown-link"
                      {% if child_link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      <span>
                        {{ child_link.title }}
                      </span>

                      {% if child_link.links != blank %}
                        <span
                          class="hargx-header__dropdown-arrow"
                          aria-hidden="true"
                        >
                          →
                        </span>
                      {% endif %}
                    </a>

                    {% if child_link.links != blank %}

                      <div class="hargx-header__sub-dropdown">

                        {% for grandchild_link in child_link.links %}

                          <a
                            href="{{ grandchild_link.url }}"
                            class="hargx-header__sub-dropdown-link"
                            {% if grandchild_link.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{ grandchild_link.title }}
                          </a>

                        {% endfor %}

                      </div>

                    {% endif %}

                  </div>

                {% endfor %}

              </div>

            {% endif %}

          {% endif %}

        </div>

      {% endfor %}
    </nav>

    <!-- Header Actions -->
    <div class="hargx-header__actions">

      <!-- Search -->
      <button
        type="button"
        class="hargx-header__action hargx-header__search"
        aria-label="Search"
        aria-expanded="false"
        aria-controls="HargxSearchOverlay-{{ section.id }}"
        data-hargx-search-open
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.7"/>
          <path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </button>

      <!-- Account -->
      {% if shop.customer_accounts_enabled %}

        <div class="hargx-header__account">

          <button
            type="button"
            class="hargx-header__action hargx-header__account-button"
            aria-label="Account"
            aria-expanded="false"
            aria-haspopup="true"
          >
            {{ 'icon-account.svg' | inline_asset_content }}
          </button>

          <div class="hargx-header__account-menu">

            <div class="hargx-header__account-menu-inner">

              <a
                href="{{ routes.account_url }}"
                class="hargx-header__account-title"
              >
                {% if customer %}
                  My Account
                {% else %}
                  Account
                {% endif %}
              </a>

              {% if section.settings.customer_account_menu != blank %}

                <nav
                  class="hargx-header__account-links"
                  aria-label="Customer account menu"
                >

                  {% for account_link in section.settings.customer_account_menu.links %}

                    <a
                      href="{{ account_link.url }}"
                      class="hargx-header__account-link"
                      {% if account_link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ account_link.title }}
                    </a>

                  {% endfor %}

                </nav>

              {% endif %}

              {% if customer %}

                <a
                  href="{{ routes.account_logout_url }}"
                  class="hargx-header__account-link hargx-header__account-logout"
                >
                  Log out
                </a>

              {% endif %}

            </div>

          </div>

        </div>

      {% endif %}

      <!-- Cart -->
      <a
        href="{{ routes.cart_url }}"
        class="hargx-header__action hargx-header__cart"
        data-hargx-cart-drawer-open
        aria-label="Cart"
      >
        {{ 'icon-cart.svg' | inline_asset_content }}

        {% if cart.item_count > 0 %}
          <span class="hargx-header__cart-count">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>

    </div>

  </div>

  <div
    id="HargxSearchOverlay-{{ section.id }}"
    class="hargx-search-overlay"
    data-hargx-search-overlay
    data-suggest-url="{{ routes.predictive_search_url }}.json"
    aria-hidden="true"
    hidden
  >
    <button
      type="button"
      class="hargx-search-overlay__backdrop"
      data-hargx-search-close
      aria-label="Close search"
      tabindex="-1"
    ></button>

    <div
      class="hargx-search-overlay__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="HargxSearchTitle-{{ section.id }}"
    >
      <div class="hargx-search-overlay__inner">
        <div class="hargx-search-overlay__top">
          <h2 id="HargxSearchTitle-{{ section.id }}">Search</h2>
          <button
            type="button"
            class="hargx-search-overlay__close"
            data-hargx-search-close
            aria-label="Close search"
          >
            ×
          </button>
        </div>

        <form
          action="{{ routes.search_url }}"
          method="get"
          class="hargx-search-overlay__form"
          role="search"
        >
          <svg
            class="hargx-search-overlay__form-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.7"/>
            <path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
          <label class="visually-hidden" for="HargxSearchInput-{{ section.id }}">
            Search products and collections
          </label>
          <input
            id="HargxSearchInput-{{ section.id }}"
            class="hargx-search-overlay__input"
            type="search"
            name="q"
            placeholder="Search products and collections"
            autocomplete="off"
            aria-autocomplete="list"
            aria-controls="HargxSearchSuggestions-{{ section.id }}"
            data-hargx-search-input
          >
          <button
            type="submit"
            class="hargx-search-overlay__submit"
            aria-label="Submit search"
          >
            Search
          </button>
        </form>

        <div
          id="HargxSearchSuggestions-{{ section.id }}"
          class="hargx-search-overlay__suggestions"
          data-hargx-search-suggestions
          role="status"
          aria-live="polite"
        ></div>

        <div class="hargx-search-overlay__collections">
          <div class="hargx-search-overlay__section-heading">
            <h3>Shop collections</h3>
            <a href="{{ routes.all_products_collection_url }}">View all</a>
          </div>

          <div class="hargx-search-overlay__collection-grid">
            {%- if section.settings.search_collections != blank -%}
              {%- for collection in section.settings.search_collections -%}
                {%- assign collection_image = collection.featured_image | default: collection.products.first.featured_image -%}
                <a
                  class="hargx-search-overlay__collection"
                  href="{{ collection.url }}"
                >
                  <span class="hargx-search-overlay__collection-image">
                    {%- if collection_image != blank -%}
                      {{
                        collection_image
                        | image_url: width: 480
                        | image_tag:
                          loading: 'lazy',
                          widths: '160, 240, 320, 480',
                          sizes: '(min-width: 750px) 25vw, 50vw',
                          alt: collection.title
                      }}
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag }}
                    {%- endif -%}
                  </span>
                  <span class="hargx-search-overlay__collection-title">
                    {{ collection.title | escape }}
                  </span>
                </a>
              {%- endfor -%}
            {%- else -%}
              {%- assign all_products_collection = collections.all -%}
              <a
                class="hargx-search-overlay__collection hargx-search-overlay__collection--all"
                href="{{ routes.all_products_collection_url }}"
              >
                <span class="hargx-search-overlay__collection-image">
                  {%- if all_products_collection.featured_image != blank -%}
                    {{
                      all_products_collection.featured_image
                      | image_url: width: 480
                      | image_tag:
                        loading: 'lazy',
                        widths: '160, 240, 320, 480',
                        sizes: '(min-width: 750px) 25vw, 50vw',
                        alt: all_products_collection.title
                    }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </span>
                <span class="hargx-search-overlay__collection-title">Shop all products</span>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================
       MOBILE MENU
       ======================================== -->

  <div
    id="HargxMobileMenu-{{ section.id }}"
    class="hargx-mobile-menu"
    aria-hidden="true"
  >

    <div class="hargx-mobile-menu__overlay"></div>

    <div
      class="hargx-mobile-menu__drawer"
      role="dialog"
      aria-modal="true"
      aria-label="Mobile navigation"
    >

      <div class="hargx-mobile-menu__header">

        <span class="hargx-mobile-menu__title">
          Menu
        </span>

        <button
          type="button"
          class="hargx-mobile-menu__close"
          aria-label="Close menu"
        >
          <span></span>
          <span></span>
        </button>

      </div>

      <nav
        class="hargx-mobile-menu__nav"
        aria-label="Mobile navigation"
      >

        {% for link in section.settings.menu.links %}

          <div class="hargx-mobile-menu__item">

            {% if link.links != blank %}

              <button
                type="button"
                class="hargx-mobile-menu__link hargx-mobile-menu__toggle-submenu"
                aria-expanded="false"
              >
                <span>
                  {{ link.title }}
                </span>

                <span
                  class="hargx-mobile-menu__arrow"
                  aria-hidden="true"
                >
                  +
                </span>
              </button>

              <div class="hargx-mobile-menu__submenu">

                <a
                  href="{{ link.url }}"
                  class="
                    hargx-mobile-menu__submenu-link
                    hargx-mobile-menu__submenu-link--parent
                  "
                >
                  View {{ link.title }}
                </a>

                {% for child_link in link.links %}

                  <div class="hargx-mobile-menu__submenu-item">

                    {% if child_link.links != blank %}

                      <button
                        type="button"
                        class="
                          hargx-mobile-menu__submenu-link
                          hargx-mobile-menu__toggle-submenu
                        "
                        aria-expanded="false"
                      >
                        <span>
                          {{ child_link.title }}
                        </span>

                        <span
                          class="hargx-mobile-menu__arrow"
                          aria-hidden="true"
                        >
                          +
                        </span>
                      </button>

                      <div class="hargx-mobile-menu__subsubmenu">

                        {% for grandchild_link in child_link.links %}

                          <a
                            href="{{ grandchild_link.url }}"
                            class="hargx-mobile-menu__subsubmenu-link"
                          >
                            {{ grandchild_link.title }}
                          </a>

                        {% endfor %}

                      </div>

                    {% else %}

                      <a
                        href="{{ child_link.url }}"
                        class="hargx-mobile-menu__submenu-link"
                      >
                        {{ child_link.title }}
                      </a>

                    {% endif %}

                  </div>

                {% endfor %}

              </div>

            {% else %}

              <a
                href="{{ link.url }}"
                class="hargx-mobile-menu__link"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{ link.title }}
              </a>

            {% endif %}

          </div>

        {% endfor %}

      </nav>

      <!-- Mobile Account -->
      {% if shop.customer_accounts_enabled %}

        <div class="hargx-mobile-menu__account">

          <div class="hargx-mobile-menu__account-title">
            Account
          </div>

          <a
            href="{{ routes.account_url }}"
            class="hargx-mobile-menu__account-link"
          >
            My Account
          </a>

          {% if section.settings.customer_account_menu != blank %}

            {% for account_link in section.settings.customer_account_menu.links %}

              <a
                href="{{ account_link.url }}"
                class="hargx-mobile-menu__account-link"
              >
                {{ account_link.title }}
              </a>

            {% endfor %}

          {% endif %}

          {% if customer %}

            <a
              href="{{ routes.account_logout_url }}"
              class="hargx-mobile-menu__account-link"
            >
              Log out
            </a>

          {% endif %}

        </div>

      {% endif %}

    </div>

  </div>

</header>

{% stylesheet %}

/* ========================================
   HARGX HEADER
   ======================================== */

.hargx-header {
  position: relative;

  width: 100%;

  background: var(--color-white);
  color: var(--color-black);

  border-bottom: 1px solid var(--color-border);

  z-index: 50;
}

.shopify-section-group-header-group:has(.hargx-header[data-sticky-header]) {
  position: sticky;
  top: 0;
  z-index: 50;
}

.hargx-header[data-sticky-header] {
  position: relative;
}

.hargx-header__inner {
  position: relative;

  width: min(
    calc(var(--page-width) - var(--page-margin) * 2),
    calc(100% - var(--page-margin) * 2)
  );

  min-height: 76px;

  margin-inline: auto;

  display: flex;
  align-items: center;

  gap: 32px;
}

/* ========================================
   LOGO
   ======================================== */

.hargx-header__logo {
  flex: 0 0 auto;

  display: flex;
  align-items: center;

  color: inherit;
  text-decoration: none;

  font-family: var(--font-heading--family);
  font-weight: 700;
  font-size: 22px;

  z-index: 2;
}

.hargx-header__logo img {
  display: block;

  width: auto;
  max-width: 100%;
}

/* ========================================
   DESKTOP NAVIGATION
   ======================================== */

.hargx-header__nav {
  flex: 1;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 28px;
}

.hargx-header__nav-item {
  position: relative;

  display: flex;
  align-items: center;
}

.hargx-header__nav-link {
  display: inline-flex;
  align-items: center;

  gap: 5px;

  color: inherit;
  text-decoration: none;

  font-size: 14px;
  line-height: 1.2;
  font-weight: 500;

  padding-block: 28px;
}

.hargx-header__nav-link:hover,
.hargx-header__nav-item:focus-within > .hargx-header__nav-link {
  color: var(--color-primary);
}

.hargx-header__chevron {
  font-size: 11px;
  line-height: 1;

  transition: transform 0.2s ease;
}

.hargx-header__nav-item:hover .hargx-header__chevron,
.hargx-header__nav-item:focus-within .hargx-header__chevron {
  transform: rotate(180deg);
}

/* ========================================
   STANDARD DROPDOWN
   ======================================== */

.hargx-header__dropdown {
  position: absolute;

  top: 100%;
  left: 50%;

  min-width: 220px;

  padding: 10px;

  background: var(--color-white);

  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);

  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transform: translate(-50%, 8px);

  transition:
    opacity 0.2s ease,
    visibility 0.2s ease,
    transform 0.2s ease;

  z-index: 100;
}

.hargx-header__nav-item:hover > .hargx-header__dropdown,
.hargx-header__nav-item:focus-within > .hargx-header__dropdown {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;

  transform: translate(-50%, 0);
}

.hargx-header__dropdown-item {
  position: relative;
}

.hargx-header__dropdown-link {
  display: flex;
  align-items: center;
  justify-content: space-between;

  width: 100%;

  padding: 11px 12px;

  color: var(--color-black);
  text-decoration: none;

  font-size: 14px;
  line-height: 1.3;

  border-radius: 4px;
}

.hargx-header__dropdown-link:hover,
.hargx-header__dropdown-link:focus {
  background: var(--color-warm-background);
  color: var(--color-primary);
}

.hargx-header__dropdown-arrow {
  font-size: 12px;
}

/* ========================================
   THIRD LEVEL DROPDOWN
   ======================================== */

.hargx-header__sub-dropdown {
  position: absolute;

  top: -10px;
  left: calc(100% + 0px);

  min-width: 210px;

  padding: 10px;

  background: var(--color-white);

  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);

  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transform: translateX(8px);

  transition:
    opacity 0.2s ease,
    visibility 0.2s ease,
    transform 0.2s ease;

  z-index: 110;
}

.hargx-header__dropdown-item:hover > .hargx-header__sub-dropdown,
.hargx-header__dropdown-item:focus-within > .hargx-header__sub-dropdown {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;

  transform: translateX(0);
}

.hargx-header__sub-dropdown-link {
  display: block;

  padding: 10px 12px;

  color: var(--color-black);
  text-decoration: none;

  font-size: 14px;

  border-radius: 4px;
}

.hargx-header__sub-dropdown-link:hover,
.hargx-header__sub-dropdown-link:focus {
  background: var(--color-warm-background);
  color: var(--color-primary);
}

/* ========================================
   MEGA MENU
   ======================================== */

.hargx-header__mega-menu {
  position: fixed;

  top: 76px;
  left: 0;

  width: 100vw;

  background: var(--color-white);

  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);

  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transform: translateY(8px);

  transition:
    opacity 0.2s ease,
    visibility 0.2s ease,
    transform 0.2s ease;

  z-index: 100;
}

.hargx-header__nav-item:hover > .hargx-header__mega-menu,
.hargx-header__nav-item:focus-within > .hargx-header__mega-menu {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;

  transform: translateY(0);
}

.hargx-header__mega-inner {
  width: min(
    calc(var(--page-width) - var(--page-margin) * 2),
    calc(100% - var(--page-margin) * 2)
  );

  margin-inline: auto;

  padding: 36px 0 40px;

  display: grid;

  grid-template-columns: repeat(
    auto-fit,
    minmax(170px, 1fr)
  );

  gap: 34px;
}

.hargx-header__mega-column {
  min-width: 0;
}

.hargx-header__mega-heading {
  display: block;

  margin-bottom: 14px;

  color: var(--color-black);
  text-decoration: none;

  font-size: 14px;
  line-height: 1.3;

  font-weight: 700;
}

.hargx-header__mega-heading:hover,
.hargx-header__mega-heading:focus {
  color: var(--color-primary);
}

.hargx-header__mega-links {
  display: flex;
  flex-direction: column;

  gap: 8px;
}

.hargx-header__mega-link {
  display: block;

  color: var(--color-muted-text);
  text-decoration: none;

  font-size: 14px;
  line-height: 1.4;
}

.hargx-header__mega-link:hover,
.hargx-header__mega-link:focus {
  color: var(--color-primary);
}

/* ========================================
   HEADER ACTIONS
   ======================================== */

.hargx-header__actions {
  flex: 0 0 auto;

  display: flex;
  align-items: center;

  gap: 18px;
}

.hargx-header__action {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;

  color: inherit;
  text-decoration: none;

  border: 0;
  background: transparent;

  cursor: pointer;
}

.hargx-header__search {
  flex: 0 0 40px;
}

.hargx-search-overlay[hidden] {
  display: none;
}

.hargx-search-overlay {
  position: fixed;
  inset: 0;
  z-index: 150;
  display: flex;
  justify-content: center;
  overflow-y: auto;
  padding: 0 24px 40px;
}

.hargx-search-overlay__backdrop {
  position: fixed;
  inset: 0;
  width: 100%;
  height: 100%;
  border: 0;
  background: rgba(0, 0, 0, 0.48);
  cursor: default;
}

.hargx-search-overlay__panel {
  position: relative;
  z-index: 1;
  align-self: flex-start;
  width: min(100%, 1000px);
  margin-top: 5vh;
  padding: 28px 36px 36px;
  border-radius: var(--border-radius);
  background: var(--color-white);
  box-shadow: 0 20px 70px rgba(0, 0, 0, 0.2);
}

.hargx-search-overlay__top,
.hargx-search-overlay__section-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
}

.hargx-search-overlay__top {
  margin-bottom: 20px;
}

.hargx-search-overlay__top h2,
.hargx-search-overlay__section-heading h3 {
  margin: 0;
  font-family: var(--font-heading--family);
  font-size: 20px;
  font-weight: var(--font-heading--weight);
}

.hargx-search-overlay__close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 40px;
  height: 40px;
  border: 0;
  background: transparent;
  color: var(--color-text);
  font: inherit;
  font-size: 30px;
  line-height: 1;
  cursor: pointer;
}

.hargx-search-overlay__form {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 58px;
  padding: 6px 8px 6px 16px;
  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);
  background: var(--color-white);
}

.hargx-search-overlay__form:focus-within {
  border-color: var(--color-text);
}

.hargx-search-overlay__form-icon {
  flex: 0 0 22px;
  width: 22px;
  height: 22px;
}

.hargx-search-overlay .visually-hidden {
  position: absolute;
  width: 1px;
  height: 1px;
  overflow: hidden;
  clip: rect(0, 0, 0, 0);
  white-space: nowrap;
  clip-path: inset(50%);
}

.hargx-search-overlay__input {
  flex: 1;
  min-width: 0;
  height: 44px;
  border: 0;
  outline: 0;
  background: transparent;
  color: var(--color-text);
  font: inherit;
  font-size: 16px;
}

.hargx-search-overlay__submit {
  min-height: 44px;
  padding: 0 22px;
  border: 0;
  border-radius: calc(var(--border-radius) * 0.7);
  background: var(--color-black);
  color: var(--color-white);
  font: inherit;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
}

.hargx-search-overlay__submit:hover {
  background: var(--color-primary);
}

.hargx-search-overlay__suggestions:not(:empty) {
  margin-top: 24px;
}

.hargx-search-overlay__suggestion-heading {
  margin: 0 0 12px;
  color: var(--color-muted-text);
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.hargx-search-overlay__suggestion-list {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px 20px;
}

.hargx-search-overlay__suggestion {
  display: flex;
  align-items: center;
  gap: 12px;
  min-width: 0;
  padding: 8px;
  color: var(--color-text);
  text-decoration: none;
}

.hargx-search-overlay__suggestion:hover {
  background: var(--color-warm-background);
}

.hargx-search-overlay__suggestion img,
.hargx-search-overlay__suggestion-placeholder {
  display: block;
  flex: 0 0 52px;
  width: 52px;
  height: 52px;
  object-fit: cover;
  background: var(--color-warm-background);
}

.hargx-search-overlay__suggestion-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: var(--color-muted-text);
  font-size: 10px;
}

.hargx-search-overlay__suggestion-title {
  overflow: hidden;
  font-size: 13px;
  line-height: 1.4;
  text-overflow: ellipsis;
}

.hargx-search-overlay__suggestion-type {
  display: block;
  margin-top: 3px;
  color: var(--color-muted-text);
  font-size: 11px;
}

.hargx-search-overlay__message {
  margin: 0;
  color: var(--color-muted-text);
  font-size: 13px;
}

.hargx-search-overlay__collections {
  margin-top: 30px;
}

.hargx-search-overlay__section-heading {
  margin-bottom: 14px;
}

.hargx-search-overlay__section-heading h3 {
  font-size: 16px;
}

.hargx-search-overlay__section-heading > a {
  color: var(--color-text);
  font-size: 12px;
  text-underline-offset: 3px;
}

.hargx-search-overlay__collection-grid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
}

.hargx-search-overlay__collection {
  min-width: 0;
  color: var(--color-text);
  text-decoration: none;
}

.hargx-search-overlay__collection-image {
  display: block;
  overflow: hidden;
  aspect-ratio: 1.25;
  background: var(--color-warm-background);
}

.hargx-search-overlay__collection-image img,
.hargx-search-overlay__collection-image svg {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.3s ease;
}

.hargx-search-overlay__collection:hover img,
.hargx-search-overlay__collection:hover svg {
  transform: scale(1.04);
}

.hargx-search-overlay__collection-title {
  display: block;
  margin-top: 8px;
  font-size: 12px;
  font-weight: 600;
}

.hargx-header__action svg {
  width: 25px;
  height: 25px;
}

.hargx-header__action:hover,
.hargx-header__action:focus {
