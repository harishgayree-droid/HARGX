{% javascript %}

(function () {
  'use strict';

  const header = document.querySelector('.hargx-header');

  if (!header) return;

  /* ========================================
     MOBILE MENU
     ======================================== */

  const mobileToggle = header.querySelector(
    '.hargx-header__mobile-toggle'
  );

  const mobileMenu = header.querySelector(
    '.hargx-mobile-menu'
  );

  const mobileClose = header.querySelector(
    '.hargx-mobile-menu__close'
  );

  const mobileOverlay = header.querySelector(
    '.hargx-mobile-menu__overlay'
  );

  const searchOverlay = header.querySelector(
    '[data-hargx-search-overlay]'
  );
  const searchOpenButton = header.querySelector(
    '[data-hargx-search-open]'
  );
  const searchInput = header.querySelector(
    '[data-hargx-search-input]'
  );
  const searchSuggestions = header.querySelector(
    '[data-hargx-search-suggestions]'
  );
  const searchCloseButtons = header.querySelectorAll(
    '[data-hargx-search-close]'
  );

  if (
    searchOverlay &&
    searchOpenButton &&
    searchInput &&
    searchSuggestions
  ) {
    let searchTimer;
    let activeRequest;
    let previousOverflow = '';

    const closeSearch = () => {
      if (searchOverlay.hidden) {
        return;
      }

      searchOverlay.hidden = true;
      searchOverlay.setAttribute('aria-hidden', 'true');
      searchOpenButton.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = previousOverflow;
      window.clearTimeout(searchTimer);

      if (activeRequest) {
        activeRequest.abort();
        activeRequest = null;
      }

      searchOpenButton.focus();
    };

    searchOpenButton.addEventListener('click', () => {
      if (mobileMenu?.classList.contains('is-open')) {
        mobileClose?.click();
      }

      previousOverflow = document.documentElement.style.overflow;
      searchOverlay.hidden = false;
      searchOverlay.setAttribute('aria-hidden', 'false');
      searchOpenButton.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';

      window.requestAnimationFrame(() => {
        searchInput.focus();
      });
    });

    searchCloseButtons.forEach((button) => {
      button.addEventListener('click', closeSearch);
    });

    const addSuggestionGroup = (title, results, type) => {
      if (!results.length) {
        return;
      }

      const heading = document.createElement('h3');
      heading.className = 'hargx-search-overlay__suggestion-heading';
      heading.textContent = title;

      const list = document.createElement('div');
      list.className = 'hargx-search-overlay__suggestion-list';

      results.forEach((result) => {
        const link = document.createElement('a');
        link.className = 'hargx-search-overlay__suggestion';
        link.href = result.url;

        const imageUrl =
          (typeof result.featured_image === 'string'
            ? result.featured_image
            : result.featured_image?.url) ||
          result.image ||
          result.image_url;

        if (imageUrl) {
          const image = document.createElement('img');
          image.src = imageUrl;
          image.alt = '';
          image.loading = 'lazy';
          link.appendChild(image);
        } else {
          const placeholder = document.createElement('span');
          placeholder.className =
            'hargx-search-overlay__suggestion-placeholder';
          placeholder.setAttribute('aria-hidden', 'true');
          placeholder.textContent = type;
          link.appendChild(placeholder);
        }

        const details = document.createElement('span');
        details.className = 'hargx-search-overlay__suggestion-title';
        details.textContent = result.title;

        const resultType = document.createElement('span');
        resultType.className = 'hargx-search-overlay__suggestion-type';
        resultType.textContent = type;
        details.appendChild(resultType);
        link.appendChild(details);
        list.appendChild(link);
      });

      searchSuggestions.append(heading, list);
    };

    searchInput.addEventListener('input', () => {
      window.clearTimeout(searchTimer);

      if (activeRequest) {
        activeRequest.abort();
        activeRequest = null;
      }

      const query = searchInput.value.trim();
      searchSuggestions.replaceChildren();

      if (query.length < 2) {
        return;
      }

      searchTimer = window.setTimeout(async () => {
        const suggestUrl = new URL(
          searchOverlay.dataset.suggestUrl,
          window.location.origin
        );
        suggestUrl.searchParams.set('q', query);
        suggestUrl.searchParams.set(
          'resources[type]',
          'product,collection'
        );
        suggestUrl.searchParams.set('resources[limit]', '5');
        suggestUrl.searchParams.set(
          'resources[options][unavailable_products]',
          'hide'
        );

        const requestController = new AbortController();
        activeRequest = requestController;

        try {
          const response = await fetch(suggestUrl.toString(), {
            headers: { Accept: 'application/json' },
            signal: requestController.signal
          });

          if (!response.ok) {
            throw new Error(
              `Predictive search request failed: ${response.status}`
            );
          }

          const data = await response.json();

          if (searchInput.value.trim() !== query) {
            return;
          }

          const results = data.resources?.results || {};
          const products = results.products || [];
          const collections = results.collections || [];

          addSuggestionGroup('Products', products, 'Product');
          addSuggestionGroup('Collections', collections, 'Collection');

          if (!products.length && !collections.length) {
            const message = document.createElement('p');
            message.className = 'hargx-search-overlay__message';
            message.textContent = 'No suggestions found. Try another search.';
            searchSuggestions.appendChild(message);
          }
        } catch (error) {
          if (error.name === 'AbortError') {
            return;
          }

          console.error('HARGX predictive search failed:', error);
          const message = document.createElement('p');
          message.className = 'hargx-search-overlay__message';
          message.textContent =
            'Suggestions could not be loaded. Submit your search to see results.';
          searchSuggestions.replaceChildren(message);
        } finally {
          if (activeRequest === requestController) {
            activeRequest = null;
          }
        }
      }, 250);
    });

    document.addEventListener('keydown', (event) => {
      if (searchOverlay.hidden) {
        return;
      }

      if (event.key === 'Escape') {
        closeSearch();
        return;
      }

      if (event.key === 'Tab') {
        const focusableElements = Array.from(
          searchOverlay.querySelectorAll(
            'a[href], button:not([disabled]), input:not([disabled])'
          )
        ).filter((element) => element.offsetParent !== null);
        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];

        if (
          event.shiftKey &&
          document.activeElement === firstElement
        ) {
          event.preventDefault();
          lastElement?.focus();
        } else if (
          !event.shiftKey &&
          document.activeElement === lastElement
        ) {
          event.preventDefault();
          firstElement?.focus();
        }
      }
    });
  }

  if (mobileToggle && mobileMenu) {

    const openMenu = function () {

      mobileMenu.classList.add('is-open');

      mobileMenu.setAttribute(
        'aria-hidden',
        'false'
      );

      mobileToggle.setAttribute(
        'aria-expanded',
        'true'
      );

      document.documentElement.style.overflow = 'hidden';

    };

    const closeMenu = function () {

      mobileMenu.classList.remove('is-open');

      mobileMenu.setAttribute(
        'aria-hidden',
        'true'
      );

      mobileToggle.setAttribute(
        'aria-expanded',
        'false'
      );

      document.documentElement.style.overflow = '';

    };

    mobileToggle.addEventListener(
      'click',
      openMenu
    );

    if (mobileClose) {

      mobileClose.addEventListener(
        'click',
        closeMenu
      );

    }

    if (mobileOverlay) {

      mobileOverlay.addEventListener(
        'click',
        closeMenu
      );

    }

    const submenuToggles = header.querySelectorAll(
      '.hargx-mobile-menu__toggle-submenu'
    );

    submenuToggles.forEach(function (toggle) {

      toggle.addEventListener(
        'click',
        function () {

          const submenu =
            toggle.nextElementSibling;

          if (!submenu) return;

          const isOpen =
            toggle.classList.contains('is-open');

          toggle.classList.toggle(
            'is-open',
            !isOpen
          );

          toggle.setAttribute(
            'aria-expanded',
            String(!isOpen)
          );

          submenu.classList.toggle(
            'is-open',
            !isOpen
          );

        }
      );

    });

    document.addEventListener(
      'keydown',
      function (event) {

        if (event.key === 'Escape') {

          closeMenu();

        }

      }
    );

  }

  /* ========================================
     ACCOUNT DROPDOWN
     ======================================== */

  const account = header.querySelector(
    '.hargx-header__account'
  );

  const accountButton = header.querySelector(
    '.hargx-header__account-button'
  );

  if (account && accountButton) {

    accountButton.addEventListener(
      'click',
      function (event) {

        event.preventDefault();

        const isOpen =
          account.classList.contains('is-open');

        account.classList.toggle(
          'is-open',
          !isOpen
        );

        accountButton.setAttribute(
          'aria-expanded',
          String(!isOpen)
        );

      }
    );

    document.addEventListener(
      'click',
      function (event) {

        if (!account.contains(event.target)) {

          account.classList.remove(
            'is-open'
          );

          accountButton.setAttribute(
            'aria-expanded',
            'false'
          );

        }

      }
    );

    document.addEventListener(
      'keydown',
      function (event) {

        if (event.key === 'Escape') {

          account.classList.remove(
            'is-open'
          );

          accountButton.setAttribute(
            'aria-expanded',
            'false'
          );

        }

      }
    );

  }

})();

{% endjavascript %}

