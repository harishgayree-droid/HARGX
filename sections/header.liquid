<header
  class="hargx-header hargx-header--{{ section.settings.header_layout }}"
  {% if section.settings.sticky_header %}
    data-sticky-header
  {% endif %}
>
  <div class="hargx-header__inner">

    <!-- Mobile Menu Button -->
    <button
      type="button"
      class="hargx-header__mobile-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="HargxMobileMenu-{{ section.id }}"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- Logo -->
    <a
      href="{{ routes.root_url }}"
      class="hargx-header__logo"
      aria-label="{{ shop.name }}"
    >
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: section.settings.logo_width
          | image_tag:
            widths: '100,150,200,250,300',
            loading: 'eager',
            alt: shop.name
        }}
      {% else %}
        <span>{{ shop.name }}</span>
      {% endif %}
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hargx-header__nav"
      aria-label="Main navigation"
    >
      {% for link in section.settings.menu.links %}

        <div
          class="
            hargx-header__nav-item
            {% if link.links != blank %}has-dropdown{% endif %}
            {% if section.settings.header_layout == 'mega-menu' and link.links != blank %}
              has-mega-menu
            {% endif %}
          "
        >

          <a
            href="{{ link.url }}"
            class="hargx-header__nav-link"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{ link.title }}

            {% if link.links != blank %}
              <span
                class="hargx-header__chevron"
                aria-hidden="true"
              >
                ↓
              </span>
            {% endif %}
          </a>

          {% if link.links != blank %}

            {% if section.settings.header_layout == 'mega-menu' %}

              <!-- MEGA MENU -->
              <div class="hargx-header__mega-menu">

                <div class="hargx-header__mega-inner">

                  {% for child_link in link.links %}

                    <div class="hargx-header__mega-column">

                      <a
                        href="{{ child_link.url }}"
                        class="hargx-header__mega-heading"
                        {% if child_link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ child_link.title }}
                      </a>

                      {% if child_link.links != blank %}

                        <div class="hargx-header__mega-links">

                          {% for grandchild_link in child_link.links %}

                            <a
                              href="{{ grandchild_link.url }}"
                              class="hargx-header__mega-link"
                              {% if grandchild_link.current %}
                                aria-current="page"
                              {% endif %}
                            >
                              {{ grandchild_link.title }}
                            </a>

                          {% endfor %}

                        </div>

                      {% endif %}

                    </div>

                  {% endfor %}

                </div>

              </div>

            {% else %}

              <!-- STANDARD DROPDOWN -->
              <div class="hargx-header__dropdown">

                {% for child_link in link.links %}

                  <div class="hargx-header__dropdown-item">

                    <a
                      href="{{ child_link.url }}"
                      class="hargx-header__dropdown-link"
                      {% if child_link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      <span>
                        {{ child_link.title }}
                      </span>

                      {% if child_link.links != blank %}
                        <span
                          class="hargx-header__dropdown-arrow"
                          aria-hidden="true"
                        >
                          →
                        </span>
                      {% endif %}
                    </a>

                    {% if child_link.links != blank %}

                      <div class="hargx-header__sub-dropdown">

                        {% for grandchild_link in child_link.links %}

                          <a
                            href="{{ grandchild_link.url }}"
                            class="hargx-header__sub-dropdown-link"
                            {% if grandchild_link.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{ grandchild_link.title }}
                          </a>

                        {% endfor %}

                      </div>

                    {% endif %}

                  </div>

                {% endfor %}

              </div>

            {% endif %}

          {% endif %}

        </div>

      {% endfor %}
    </nav>

    <!-- Header Actions -->
    <div class="hargx-header__actions">

      <!-- Search -->
      <button
        type="button"
        class="hargx-header__action hargx-header__search"
        aria-label="Search"
        aria-expanded="false"
        aria-controls="HargxSearchOverlay-{{ section.id }}"
        data-hargx-search-open
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="none"
          aria-hidden="true"
        >
          <circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.7"/>
          <path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
        </svg>
      </button>
      
      <!-- Shopify Account -->
      {% if shop.customer_accounts_enabled %}
        <div class="hargx-header__account">
          <shopify-account
            menu="{{ section.settings.customer_account_menu }}"
          >
            <span slot="signed-out-avatar" class="hargx-header__account-avatar">
              {{ 'icon-account.svg' | inline_asset_content }}
            </span>
          </shopify-account>
        </div>
      {% endif %}

      {% if section.settings.show_wishlist %}
        <a
          href="{% if section.settings.wishlist_page != blank %}{{ section.settings.wishlist_page.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}"
          class="hargx-header__action hargx-wishlist-header-link"
          aria-label="Wishlist"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <path d="M12 21s-7-4.35-9.33-8.1C.7 9.75 2.15 5.5 6 4.35A5.3 5.3 0 0 1 12 6.9a5.3 5.3 0 0 1 6-2.55c3.85 1.15 5.3 5.4 3.33 8.55C19 16.65 12 21 12 21Z" stroke="currentColor" stroke-width="1.7" stroke-linejoin="round"/>
          </svg>
          {% if section.settings.show_wishlist_counter %}
            <span
              class="hargx-wishlist-count"
              data-hargx-wishlist-count
              hidden
            >0</span>
          {% endif %}
        </a>
      {% endif %}


      <!-- Cart -->
      <a
        href="{{ routes.cart_url }}"
        class="hargx-header__action hargx-header__cart"
        data-hargx-cart-drawer-open
        aria-label="Cart"
      >
        {{ 'icon-cart.svg' | inline_asset_content }}

        {% if cart.item_count > 0 %}
          <span class="hargx-header__cart-count">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>

    </div>

  </div>

  <div
    id="HargxSearchOverlay-{{ section.id }}"
    class="hargx-search-overlay"
    data-hargx-search-overlay
    data-suggest-url="{{ routes.predictive_search_url }}.json"
    aria-hidden="true"
    hidden
  >
    <button
      type="button"
      class="hargx-search-overlay__backdrop"
      data-hargx-search-close
      aria-label="Close search"
      tabindex="-1"
    ></button>

    <div
      class="hargx-search-overlay__panel"
      role="dialog"
      aria-modal="true"
      aria-labelledby="HargxSearchTitle-{{ section.id }}"
    >
      <div class="hargx-search-overlay__inner">
        <div class="hargx-search-overlay__top">
          <h2 id="HargxSearchTitle-{{ section.id }}">Search</h2>
          <button
            type="button"
            class="hargx-search-overlay__close"
            data-hargx-search-close
            aria-label="Close search"
          >
            ×
          </button>
        </div>

        <form
          action="{{ routes.search_url }}"
          method="get"
          class="hargx-search-overlay__form"
          role="search"
        >
          <svg
            class="hargx-search-overlay__form-icon"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            fill="none"
            aria-hidden="true"
          >
            <circle cx="10.8" cy="10.8" r="6.8" stroke="currentColor" stroke-width="1.7"/>
            <path d="m16 16 4.2 4.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
          </svg>
          <label class="visually-hidden" for="HargxSearchInput-{{ section.id }}">
            Search products and collections
          </label>
          <input
            id="HargxSearchInput-{{ section.id }}"
            class="hargx-search-overlay__input"
            type="search"
            name="q"
            placeholder="Search products and collections"
            autocomplete="off"
            aria-autocomplete="list"
            aria-controls="HargxSearchSuggestions-{{ section.id }}"
            data-hargx-search-input
          >
          <button
            type="submit"
            class="hargx-search-overlay__submit"
            aria-label="Submit search"
          >
            Search
          </button>
        </form>

        <div
          id="HargxSearchSuggestions-{{ section.id }}"
          class="hargx-search-overlay__suggestions"
          data-hargx-search-suggestions
          role="status"
          aria-live="polite"
        ></div>

        <div class="hargx-search-overlay__collections">
          <div class="hargx-search-overlay__section-heading">
            <h3>Shop collections</h3>
            <a href="{{ routes.all_products_collection_url }}">View all</a>
          </div>

          <div class="hargx-search-overlay__collection-grid">
            {%- if section.settings.search_collections != blank -%}
              {%- for collection in section.settings.search_collections -%}
                {%- assign collection_image = collection.featured_image | default: collection.products.first.featured_image -%}
                <a
                  class="hargx-search-overlay__collection"
                  href="{{ collection.url }}"
                >
                  <span class="hargx-search-overlay__collection-image">
                    {%- if collection_image != blank -%}
                      {{
                        collection_image
                        | image_url: width: 480
                        | image_tag:
                          loading: 'lazy',
                          widths: '160, 240, 320, 480',
                          sizes: '(min-width: 750px) 25vw, 50vw',
                          alt: collection.title
                      }}
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag }}
                    {%- endif -%}
                  </span>
                  <span class="hargx-search-overlay__collection-title">
                    {{ collection.title | escape }}
                  </span>
                </a>
              {%- endfor -%}
            {%- else -%}
              {%- assign all_products_collection = collections.all -%}
              <a
                class="hargx-search-overlay__collection hargx-search-overlay__collection--all"
                href="{{ routes.all_products_collection_url }}"
              >
                <span class="hargx-search-overlay__collection-image">
                  {%- if all_products_collection.featured_image != blank -%}
                    {{
                      all_products_collection.featured_image
                      | image_url: width: 480
                      | image_tag:
                        loading: 'lazy',
                        widths: '160, 240, 320, 480',
                        sizes: '(min-width: 750px) 25vw, 50vw',
                        alt: all_products_collection.title
                    }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag }}
                  {%- endif -%}
                </span>
                <span class="hargx-search-overlay__collection-title">Shop all products</span>
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- ========================================
       MOBILE MENU
       ======================================== -->

  <div
    id="HargxMobileMenu-{{ section.id }}"
    class="hargx-mobile-menu"
    aria-hidden="true"
  >

    <div class="hargx-mobile-menu__overlay"></div>

    <div
      class="hargx-mobile-menu__drawer"
      role="dialog"
      aria-modal="true"
      aria-label="Mobile navigation"
    >

      <div class="hargx-mobile-menu__header">

        <span class="hargx-mobile-menu__title">
          Menu
        </span>

        <button
          type="button"
          class="hargx-mobile-menu__close"
          aria-label="Close menu"
        >
          <span></span>
          <span></span>
        </button>

      </div>

      <nav
        class="hargx-mobile-menu__nav"
        aria-label="Mobile navigation"
      >

        {% for link in section.settings.menu.links %}

          <div class="hargx-mobile-menu__item">

            {% if link.links != blank %}

              <button
                type="button"
                class="hargx-mobile-menu__link hargx-mobile-menu__toggle-submenu"
                aria-expanded="false"
              >
                <span>
                  {{ link.title }}
                </span>

                <span
                  class="hargx-mobile-menu__arrow"
                  aria-hidden="true"
                >
                  +
                </span>
              </button>

              <div class="hargx-mobile-menu__submenu">

                <a
                  href="{{ link.url }}"
                  class="
                    hargx-mobile-menu__submenu-link
                    hargx-mobile-menu__submenu-link--parent
                  "
                >
                  View {{ link.title }}
                </a>

                {% for child_link in link.links %}

                  <div class="hargx-mobile-menu__submenu-item">

                    {% if child_link.links != blank %}

                      <button
                        type="button"
                        class="
                          hargx-mobile-menu__submenu-link
                          hargx-mobile-menu__toggle-submenu
                        "
                        aria-expanded="false"
                      >
                        <span>
                          {{ child_link.title }}
                        </span>

                        <span
                          class="hargx-mobile-menu__arrow"
                          aria-hidden="true"
                        >
                          +
                        </span>
                      </button>

                      <div class="hargx-mobile-menu__subsubmenu">

                        {% for grandchild_link in child_link.links %}

                          <a
                            href="{{ grandchild_link.url }}"
                            class="hargx-mobile-menu__subsubmenu-link"
                          >
                            {{ grandchild_link.title }}
                          </a>

                        {% endfor %}

                      </div>

                    {% else %}

                      <a
                        href="{{ child_link.url }}"
                        class="hargx-mobile-menu__submenu-link"
                      >
                        {{ child_link.title }}
                      </a>

                    {% endif %}

                  </div>

                {% endfor %}

              </div>

            {% else %}

              <a
                href="{{ link.url }}"
                class="hargx-mobile-menu__link"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{ link.title }}
              </a>

            {% endif %}

          </div>

        {% endfor %}

      </nav>


    </div>

  </div>

</header>


{% javascript %}

(function () {
  'use strict';

  const header = document.querySelector('.hargx-header');

  if (!header) return;

  /* ========================================
     MOBILE MENU
     ======================================== */

  const mobileToggle = header.querySelector(
    '.hargx-header__mobile-toggle'
  );

  const mobileMenu = header.querySelector(
    '.hargx-mobile-menu'
  );

  const mobileClose = header.querySelector(
    '.hargx-mobile-menu__close'
  );

  const mobileOverlay = header.querySelector(
    '.hargx-mobile-menu__overlay'
  );

  const searchOverlay = header.querySelector(
    '[data-hargx-search-overlay]'
  );
  const searchOpenButton = header.querySelector(
    '[data-hargx-search-open]'
  );
  const searchInput = header.querySelector(
    '[data-hargx-search-input]'
  );
  const searchSuggestions = header.querySelector(
    '[data-hargx-search-suggestions]'
  );
  const searchCloseButtons = header.querySelectorAll(
    '[data-hargx-search-close]'
  );

  if (
    searchOverlay &&
    searchOpenButton &&
    searchInput &&
    searchSuggestions
  ) {
    let searchTimer;
    let activeRequest;
    let previousOverflow = '';

    const closeSearch = () => {
      if (searchOverlay.hidden) {
        return;
      }

      searchOverlay.hidden = true;
      searchOverlay.setAttribute('aria-hidden', 'true');
      searchOpenButton.setAttribute('aria-expanded', 'false');
      document.documentElement.style.overflow = previousOverflow;
      window.clearTimeout(searchTimer);

      if (activeRequest) {
        activeRequest.abort();
        activeRequest = null;
      }

      searchOpenButton.focus();
    };

    searchOpenButton.addEventListener('click', () => {
      if (mobileMenu?.classList.contains('is-open')) {
        mobileClose?.click();
      }

      previousOverflow = document.documentElement.style.overflow;
      searchOverlay.hidden = false;
      searchOverlay.setAttribute('aria-hidden', 'false');
      searchOpenButton.setAttribute('aria-expanded', 'true');
      document.documentElement.style.overflow = 'hidden';

      window.requestAnimationFrame(() => {
        searchInput.focus();
      });
    });

    searchCloseButtons.forEach((button) => {
      button.addEventListener('click', closeSearch);
    });

    const addSuggestionGroup = (title, results, type) => {
      if (!results.length) {
        return;
      }

      const heading = document.createElement('h3');
      heading.className = 'hargx-search-overlay__suggestion-heading';
      heading.textContent = title;

      const list = document.createElement('div');
      list.className = 'hargx-search-overlay__suggestion-list';

      results.forEach((result) => {
        const link = document.createElement('a');
        link.className = 'hargx-search-overlay__suggestion';
        link.href = result.url;

        const imageUrl =
          (typeof result.featured_image === 'string'
            ? result.featured_image
            : result.featured_image?.url) ||
          result.image ||
          result.image_url;

        if (imageUrl) {
          const image = document.createElement('img');
          image.src = imageUrl;
          image.alt = '';
          image.loading = 'lazy';
          link.appendChild(image);
        } else {
          const placeholder = document.createElement('span');
          placeholder.className =
            'hargx-search-overlay__suggestion-placeholder';
          placeholder.setAttribute('aria-hidden', 'true');
          placeholder.textContent = type;
          link.appendChild(placeholder);
        }

        const details = document.createElement('span');
        details.className = 'hargx-search-overlay__suggestion-title';
        details.textContent = result.title;

        const resultType = document.createElement('span');
        resultType.className = 'hargx-search-overlay__suggestion-type';
        resultType.textContent = type;
        details.appendChild(resultType);
        link.appendChild(details);
        list.appendChild(link);
      });

      searchSuggestions.append(heading, list);
    };

    searchInput.addEventListener('input', () => {
      window.clearTimeout(searchTimer);

      if (activeRequest) {
        activeRequest.abort();
        activeRequest = null;
      }

      const query = searchInput.value.trim();
      searchSuggestions.replaceChildren();

      if (query.length < 2) {
        return;
      }

      searchTimer = window.setTimeout(async () => {
        const suggestUrl = new URL(
          searchOverlay.dataset.suggestUrl,
          window.location.origin
        );
        suggestUrl.searchParams.set('q', query);
        suggestUrl.searchParams.set(
          'resources[type]',
          'product,collection'
        );
        suggestUrl.searchParams.set('resources[limit]', '5');
        suggestUrl.searchParams.set(
          'resources[options][unavailable_products]',
          'hide'
        );

        const requestController = new AbortController();
        activeRequest = requestController;

        try {
          const response = await fetch(suggestUrl.toString(), {
            headers: { Accept: 'application/json' },
            signal: requestController.signal
          });

          if (!response.ok) {
            throw new Error(
              `Predictive search request failed: ${response.status}`
            );
          }

          const data = await response.json();

          if (searchInput.value.trim() !== query) {
            return;
          }

          const results = data.resources?.results || {};
          const products = results.products || [];
          const collections = results.collections || [];

          addSuggestionGroup('Products', products, 'Product');
          addSuggestionGroup('Collections', collections, 'Collection');

          if (!products.length && !collections.length) {
            const message = document.createElement('p');
            message.className = 'hargx-search-overlay__message';
            message.textContent = 'No suggestions found. Try another search.';
            searchSuggestions.appendChild(message);
          }
        } catch (error) {
          if (error.name === 'AbortError') {
            return;
          }

          console.error('HARGX predictive search failed:', error);
          const message = document.createElement('p');
          message.className = 'hargx-search-overlay__message';
          message.textContent =
            'Suggestions could not be loaded. Submit your search to see results.';
          searchSuggestions.replaceChildren(message);
        } finally {
          if (activeRequest === requestController) {
            activeRequest = null;
          }
        }
      }, 250);
    });

    document.addEventListener('keydown', (event) => {
      if (searchOverlay.hidden) {
        return;
      }

      if (event.key === 'Escape') {
        closeSearch();
        return;
      }

      if (event.key === 'Tab') {
        const focusableElements = Array.from(
          searchOverlay.querySelectorAll(
            'a[href], button:not([disabled]), input:not([disabled])'
          )
        ).filter((element) => element.offsetParent !== null);
        const firstElement = focusableElements[0];
        const lastElement = focusableElements[focusableElements.length - 1];

        if (
          event.shiftKey &&
          document.activeElement === firstElement
        ) {
          event.preventDefault();
          lastElement?.focus();
        } else if (
          !event.shiftKey &&
          document.activeElement === lastElement
        ) {
          event.preventDefault();
          firstElement?.focus();
        }
      }
    });
  }

  if (mobileToggle && mobileMenu) {

    const openMenu = function () {

      mobileMenu.classList.add('is-open');

      mobileMenu.setAttribute(
        'aria-hidden',
        'false'
      );

      mobileToggle.setAttribute(
        'aria-expanded',
        'true'
      );

      document.documentElement.style.overflow = 'hidden';

    };

    const closeMenu = function () {

      mobileMenu.classList.remove('is-open');

      mobileMenu.setAttribute(
        'aria-hidden',
        'true'
      );

      mobileToggle.setAttribute(
        'aria-expanded',
        'false'
      );

      document.documentElement.style.overflow = '';

    };

    mobileToggle.addEventListener(
      'click',
      openMenu
    );

    if (mobileClose) {

      mobileClose.addEventListener(
        'click',
        closeMenu
      );

    }

    if (mobileOverlay) {

      mobileOverlay.addEventListener(
        'click',
        closeMenu
      );

    }

    const submenuToggles = header.querySelectorAll(
      '.hargx-mobile-menu__toggle-submenu'
    );

    submenuToggles.forEach(function (toggle) {

      toggle.addEventListener(
        'click',
        function () {

          const submenu =
            toggle.nextElementSibling;

          if (!submenu) return;

          const isOpen =
            toggle.classList.contains('is-open');

          toggle.classList.toggle(
            'is-open',
            !isOpen
          );

          toggle.setAttribute(
            'aria-expanded',
            String(!isOpen)
          );

          submenu.classList.toggle(
            'is-open',
            !isOpen
          );

        }
      );

    });

    document.addEventListener(
      'keydown',
      function (event) {

        if (event.key === 'Escape') {

          closeMenu();

        }

      }
    );

  }

})();

{% endjavascript %}

{% schema %}
{
  "name": "HARGX Header",
  "settings": [
    {
      "type": "select",
      "id": "header_layout",
      "label": "Header layout",
      "options": [
        {
          "value": "classic",
          "label": "Classic"
        },
        {
          "value": "center-logo",
          "label": "Center Logo"
        },
        {
          "value": "minimal",
          "label": "Minimal"
        },
        {
          "value": "mega-menu",
          "label": "Mega Menu"
        }
      ],
      "default": "classic"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo"
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 300,
      "step": 5,
      "unit": "px",
      "default": 150
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Main menu"
    },
    {
      "type": "collection_list",
      "id": "search_collections",
      "label": "Search overlay collections",
      "info": "Choose collections to display below search suggestions.",
