<header
  class="hargx-header hargx-header--{{ section.settings.header_layout }}"
  {% if section.settings.sticky_header %}
    data-sticky-header
  {% endif %}
>
  <div class="hargx-header__inner">

    <!-- Mobile Menu Button -->
    <button
      type="button"
      class="hargx-header__mobile-toggle"
      aria-label="Open menu"
      aria-expanded="false"
      aria-controls="HargxMobileMenu-{{ section.id }}"
    >
      <span></span>
      <span></span>
      <span></span>
    </button>

    <!-- Logo -->
    <a
      href="{{ routes.root_url }}"
      class="hargx-header__logo"
      aria-label="{{ shop.name }}"
    >
      {% if section.settings.logo != blank %}
        {{
          section.settings.logo
          | image_url: width: section.settings.logo_width
          | image_tag:
            widths: '100,150,200,250,300',
            loading: 'eager',
            alt: shop.name
        }}
      {% else %}
        <span>{{ shop.name }}</span>
      {% endif %}
    </a>

    <!-- Desktop Navigation -->
    <nav
      class="hargx-header__nav"
      aria-label="Main navigation"
    >
      {% for link in section.settings.menu.links %}

        <div
          class="
            hargx-header__nav-item
            {% if link.links != blank %}has-dropdown{% endif %}
            {% if section.settings.header_layout == 'mega-menu' and link.links != blank %}
              has-mega-menu
            {% endif %}
          "
        >

          <a
            href="{{ link.url }}"
            class="hargx-header__nav-link"
            {% if link.current %}
              aria-current="page"
            {% endif %}
          >
            {{ link.title }}

            {% if link.links != blank %}
              <span
                class="hargx-header__chevron"
                aria-hidden="true"
              >
                ↓
              </span>
            {% endif %}
          </a>

          {% if link.links != blank %}

            {% if section.settings.header_layout == 'mega-menu' %}

              <!-- MEGA MENU -->
              <div class="hargx-header__mega-menu">

                <div class="hargx-header__mega-inner">

                  {% for child_link in link.links %}

                    <div class="hargx-header__mega-column">

                      <a
                        href="{{ child_link.url }}"
                        class="hargx-header__mega-heading"
                        {% if child_link.current %}
                          aria-current="page"
                        {% endif %}
                      >
                        {{ child_link.title }}
                      </a>

                      {% if child_link.links != blank %}

                        <div class="hargx-header__mega-links">

                          {% for grandchild_link in child_link.links %}

                            <a
                              href="{{ grandchild_link.url }}"
                              class="hargx-header__mega-link"
                              {% if grandchild_link.current %}
                                aria-current="page"
                              {% endif %}
                            >
                              {{ grandchild_link.title }}
                            </a>

                          {% endfor %}

                        </div>

                      {% endif %}

                    </div>

                  {% endfor %}

                </div>

              </div>

            {% else %}

              <!-- STANDARD DROPDOWN -->
              <div class="hargx-header__dropdown">

                {% for child_link in link.links %}

                  <div class="hargx-header__dropdown-item">

                    <a
                      href="{{ child_link.url }}"
                      class="hargx-header__dropdown-link"
                      {% if child_link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      <span>
                        {{ child_link.title }}
                      </span>

                      {% if child_link.links != blank %}
                        <span
                          class="hargx-header__dropdown-arrow"
                          aria-hidden="true"
                        >
                          →
                        </span>
                      {% endif %}
                    </a>

                    {% if child_link.links != blank %}

                      <div class="hargx-header__sub-dropdown">

                        {% for grandchild_link in child_link.links %}

                          <a
                            href="{{ grandchild_link.url }}"
                            class="hargx-header__sub-dropdown-link"
                            {% if grandchild_link.current %}
                              aria-current="page"
                            {% endif %}
                          >
                            {{ grandchild_link.title }}
                          </a>

                        {% endfor %}

                      </div>

                    {% endif %}

                  </div>

                {% endfor %}

              </div>

            {% endif %}

          {% endif %}

        </div>

      {% endfor %}
    </nav>

    <!-- Header Actions -->
    <div class="hargx-header__actions">

      <!-- Search -->
      <a
        href="{{ routes.search_url }}"
        class="hargx-header__action"
        aria-label="Search"
      >
        {{ 'icon-search.svg' | inline_asset_content }}
      </a>

      <!-- Account -->
      {% if shop.customer_accounts_enabled %}

        <div class="hargx-header__account">

          <button
            type="button"
            class="hargx-header__action hargx-header__account-button"
            aria-label="Account"
            aria-expanded="false"
            aria-haspopup="true"
          >
            {{ 'icon-account.svg' | inline_asset_content }}
          </button>

          <div class="hargx-header__account-menu">

            <div class="hargx-header__account-menu-inner">

              <a
                href="{{ routes.account_url }}"
                class="hargx-header__account-title"
              >
                {% if customer %}
                  My Account
                {% else %}
                  Account
                {% endif %}
              </a>

              {% if section.settings.customer_account_menu != blank %}

                <nav
                  class="hargx-header__account-links"
                  aria-label="Customer account menu"
                >

                  {% for account_link in section.settings.customer_account_menu.links %}

                    <a
                      href="{{ account_link.url }}"
                      class="hargx-header__account-link"
                      {% if account_link.current %}
                        aria-current="page"
                      {% endif %}
                    >
                      {{ account_link.title }}
                    </a>

                  {% endfor %}

                </nav>

              {% endif %}

              {% if customer %}

                <a
                  href="{{ routes.account_logout_url }}"
                  class="hargx-header__account-link hargx-header__account-logout"
                >
                  Log out
                </a>

              {% endif %}

            </div>

          </div>

        </div>

      {% endif %}

      <!-- Cart -->
      <a
        href="{{ routes.cart_url }}"
        class="hargx-header__action hargx-header__cart"
        aria-label="Cart"
      >
        {{ 'icon-cart.svg' | inline_asset_content }}

        {% if cart.item_count > 0 %}
          <span class="hargx-header__cart-count">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>

    </div>

  </div>

  <!-- ========================================
       MOBILE MENU
       ======================================== -->

  <div
    id="HargxMobileMenu-{{ section.id }}"
    class="hargx-mobile-menu"
    aria-hidden="true"
  >

    <div class="hargx-mobile-menu__overlay"></div>

    <div
      class="hargx-mobile-menu__drawer"
      role="dialog"
      aria-modal="true"
      aria-label="Mobile navigation"
    >

      <div class="hargx-mobile-menu__header">

        <span class="hargx-mobile-menu__title">
          Menu
        </span>

        <button
          type="button"
          class="hargx-mobile-menu__close"
          aria-label="Close menu"
        >
          <span></span>
          <span></span>
        </button>

      </div>

      <nav
        class="hargx-mobile-menu__nav"
        aria-label="Mobile navigation"
      >

        {% for link in section.settings.menu.links %}

          <div class="hargx-mobile-menu__item">

            {% if link.links != blank %}

              <button
                type="button"
                class="hargx-mobile-menu__link hargx-mobile-menu__toggle-submenu"
                aria-expanded="false"
              >
                <span>
                  {{ link.title }}
                </span>

                <span
                  class="hargx-mobile-menu__arrow"
                  aria-hidden="true"
                >
                  +
                </span>
              </button>

              <div class="hargx-mobile-menu__submenu">

                <a
                  href="{{ link.url }}"
                  class="
                    hargx-mobile-menu__submenu-link
                    hargx-mobile-menu__submenu-link--parent
                  "
                >
                  View {{ link.title }}
                </a>

                {% for child_link in link.links %}

                  <div class="hargx-mobile-menu__submenu-item">

                    {% if child_link.links != blank %}

                      <button
                        type="button"
                        class="
                          hargx-mobile-menu__submenu-link
                          hargx-mobile-menu__toggle-submenu
                        "
                        aria-expanded="false"
                      >
                        <span>
                          {{ child_link.title }}
                        </span>

                        <span
                          class="hargx-mobile-menu__arrow"
                          aria-hidden="true"
                        >
                          +
                        </span>
                      </button>

                      <div class="hargx-mobile-menu__subsubmenu">

                        {% for grandchild_link in child_link.links %}

                          <a
                            href="{{ grandchild_link.url }}"
                            class="hargx-mobile-menu__subsubmenu-link"
                          >
                            {{ grandchild_link.title }}
                          </a>

                        {% endfor %}

                      </div>

                    {% else %}

                      <a
                        href="{{ child_link.url }}"
                        class="hargx-mobile-menu__submenu-link"
                      >
                        {{ child_link.title }}
                      </a>

                    {% endif %}

                  </div>

                {% endfor %}

              </div>

            {% else %}

              <a
                href="{{ link.url }}"
                class="hargx-mobile-menu__link"
                {% if link.current %}
                  aria-current="page"
                {% endif %}
              >
                {{ link.title }}
              </a>

            {% endif %}

          </div>

        {% endfor %}

      </nav>

      <!-- Mobile Account -->
      {% if shop.customer_accounts_enabled %}

        <div class="hargx-mobile-menu__account">

          <div class="hargx-mobile-menu__account-title">
            Account
          </div>

          <a
            href="{{ routes.account_url }}"
            class="hargx-mobile-menu__account-link"
          >
            My Account
          </a>

          {% if section.settings.customer_account_menu != blank %}

            {% for account_link in section.settings.customer_account_menu.links %}

              <a
                href="{{ account_link.url }}"
                class="hargx-mobile-menu__account-link"
              >
                {{ account_link.title }}
              </a>

            {% endfor %}

          {% endif %}

          {% if customer %}

            <a
              href="{{ routes.account_logout_url }}"
              class="hargx-mobile-menu__account-link"
            >
              Log out
            </a>

          {% endif %}

        </div>

      {% endif %}

    </div>

  </div>

</header>

{% stylesheet %}

/* ========================================
   HARGX HEADER
   ======================================== */

.hargx-header {
  position: relative;

  width: 100%;

  background: var(--color-white);
  color: var(--color-black);

  border-bottom: 1px solid var(--color-border);

  z-index: 50;
}

.hargx-header[data-sticky-header] {
  position: sticky;
  top: 0;
}

.hargx-header__inner {
  position: relative;

  width: min(
    calc(var(--page-width) - var(--page-margin) * 2),
    calc(100% - var(--page-margin) * 2)
  );

  min-height: 76px;

  margin-inline: auto;

  display: flex;
  align-items: center;

  gap: 32px;
}

/* ========================================
   LOGO
   ======================================== */

.hargx-header__logo {
  flex: 0 0 auto;

  display: flex;
  align-items: center;

  color: inherit;
  text-decoration: none;

  font-family: var(--font-heading--family);
  font-weight: 700;
  font-size: 22px;

  z-index: 2;
}

.hargx-header__logo img {
  display: block;

  width: auto;
  max-width: 100%;
}

/* ========================================
   DESKTOP NAVIGATION
   ======================================== */

.hargx-header__nav {
  flex: 1;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 28px;
}

.hargx-header__nav-item {
  position: relative;

  display: flex;
  align-items: center;
}

.hargx-header__nav-link {
  display: inline-flex;
  align-items: center;

  gap: 5px;

  color: inherit;
  text-decoration: none;

  font-size: 14px;
  line-height: 1.2;
  font-weight: 500;

  padding-block: 28px;
}

.hargx-header__nav-link:hover,
.hargx-header__nav-item:focus-within > .hargx-header__nav-link {
  color: var(--color-primary);
}

.hargx-header__chevron {
  font-size: 11px;
  line-height: 1;

  transition: transform 0.2s ease;
}

.hargx-header__nav-item:hover .hargx-header__chevron,
.hargx-header__nav-item:focus-within .hargx-header__chevron {
  transform: rotate(180deg);
}

/* ========================================
   STANDARD DROPDOWN
   ======================================== */

.hargx-header__dropdown {
  position: absolute;

  top: 100%;
  left: 50%;

  min-width: 220px;

  padding: 10px;

  background: var(--color-white);

  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);

  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transform: translate(-50%, 8px);

  transition:
    opacity 0.2s ease,
    visibility 0.2s ease,
    transform 0.2s ease;

  z-index: 100;
}

.hargx-header__nav-item:hover > .hargx-header__dropdown,
.hargx-header__nav-item:focus-within > .hargx-header__dropdown {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;

  transform: translate(-50%, 0);
}

.hargx-header__dropdown-item {
  position: relative;
}

.hargx-header__dropdown-link {
  display: flex;
  align-items: center;
  justify-content: space-between;

  width: 100%;

  padding: 11px 12px;

  color: var(--color-black);
  text-decoration: none;

  font-size: 14px;
  line-height: 1.3;

  border-radius: 4px;
}

.hargx-header__dropdown-link:hover,
.hargx-header__dropdown-link:focus {
  background: var(--color-warm-background);
  color: var(--color-primary);
}

.hargx-header__dropdown-arrow {
  font-size: 12px;
}

/* ========================================
   THIRD LEVEL DROPDOWN
   ======================================== */

.hargx-header__sub-dropdown {
  position: absolute;

  top: -10px;
  left: calc(100% + 10px);

  min-width: 210px;

  padding: 10px;

  background: var(--color-white);

  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);

  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transform: translateX(8px);

  transition:
    opacity 0.2s ease,
    visibility 0.2s ease,
    transform 0.2s ease;

  z-index: 110;
}

.hargx-header__dropdown-item:hover > .hargx-header__sub-dropdown,
.hargx-header__dropdown-item:focus-within > .hargx-header__sub-dropdown {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;

  transform: translateX(0);
}

.hargx-header__sub-dropdown-link {
  display: block;

  padding: 10px 12px;

  color: var(--color-black);
  text-decoration: none;

  font-size: 14px;

  border-radius: 4px;
}

.hargx-header__sub-dropdown-link:hover,
.hargx-header__sub-dropdown-link:focus {
  background: var(--color-warm-background);
  color: var(--color-primary);
}

/* ========================================
   MEGA MENU
   ======================================== */

.hargx-header__mega-menu {
  position: absolute;

  top: 100%;
  left: 50%;

  width: 100vw;

  background: var(--color-white);

  border-top: 1px solid var(--color-border);
  border-bottom: 1px solid var(--color-border);

  box-shadow: 0 18px 40px rgba(0, 0, 0, 0.08);

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transform: translate(-50%, 8px);

  transition:
    opacity 0.2s ease,
    visibility 0.2s ease,
    transform 0.2s ease;

  z-index: 100;
}

.hargx-header__nav-item:hover > .hargx-header__mega-menu,
.hargx-header__nav-item:focus-within > .hargx-header__mega-menu {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;

  transform: translate(-50%, 0);
}

.hargx-header__mega-inner {
  width: min(
    calc(var(--page-width) - var(--page-margin) * 2),
    calc(100% - var(--page-margin) * 2)
  );

  margin-inline: auto;

  padding: 36px 0 40px;

  display: grid;

  grid-template-columns: repeat(
    auto-fit,
    minmax(170px, 1fr)
  );

  gap: 34px;
}

.hargx-header__mega-column {
  min-width: 0;
}

.hargx-header__mega-heading {
  display: block;

  margin-bottom: 14px;

  color: var(--color-black);
  text-decoration: none;

  font-size: 14px;
  line-height: 1.3;

  font-weight: 700;
}

.hargx-header__mega-heading:hover,
.hargx-header__mega-heading:focus {
  color: var(--color-primary);
}

.hargx-header__mega-links {
  display: flex;
  flex-direction: column;

  gap: 8px;
}

.hargx-header__mega-link {
  display: block;

  color: var(--color-muted-text);
  text-decoration: none;

  font-size: 14px;
  line-height: 1.4;
}

.hargx-header__mega-link:hover,
.hargx-header__mega-link:focus {
  color: var(--color-primary);
}

/* ========================================
   HEADER ACTIONS
   ======================================== */

.hargx-header__actions {
  flex: 0 0 auto;

  display: flex;
  align-items: center;

  gap: 18px;
}

.hargx-header__action {
  position: relative;

  display: flex;
  align-items: center;
  justify-content: center;

  color: inherit;
  text-decoration: none;

  border: 0;
  background: transparent;

  cursor: pointer;
}

.hargx-header__action svg {
  width: 21px;
  height: 21px;
}

.hargx-header__action:hover,
.hargx-header__action:focus {
  color: var(--color-primary);
}

/* ========================================
   ACCOUNT
   ======================================== */

.hargx-header__account {
  position: relative;
}

.hargx-header__account-menu {
  position: absolute;

  top: calc(100% + 10px);
  right: 0;

  width: 220px;

  padding: 10px;

  background: var(--color-white);

  border: 1px solid var(--color-border);
  border-radius: var(--border-radius);

  box-shadow: 0 12px 35px rgba(0, 0, 0, 0.08);

  opacity: 0;
  visibility: hidden;
  pointer-events: none;

  transform: translateY(8px);

  transition:
    opacity 0.2s ease,
    visibility 0.2s ease,
    transform 0.2s ease;

  z-index: 120;
}

.hargx-header__account.is-open .hargx-header__account-menu,
.hargx-header__account:focus-within .hargx-header__account-menu {
  opacity: 1;
  visibility: visible;
  pointer-events: auto;

  transform: translateY(0);
}

.hargx-header__account-menu-inner {
  display: flex;
  flex-direction: column;

  gap: 2px;
}

.hargx-header__account-title {
  display: block;

  padding: 10px 12px;
  margin-bottom: 4px;

  color: var(--color-black);
  text-decoration: none;

  font-size: 14px;
  font-weight: 700;

  border-bottom: 1px solid var(--color-border);
}

.hargx-header__account-links {
  display: flex;
  flex-direction: column;
}

.hargx-header__account-link {
  display: block;

  padding: 9px 12px;

  color: var(--color-black);
  text-decoration: none;

  font-size: 14px;

  border-radius: 4px;
}

.hargx-header__account-link:hover,
.hargx-header__account-link:focus {
  background: var(--color-warm-background);
  color: var(--color-primary);
}

.hargx-header__account-logout {
  margin-top: 4px;

  border-top: 1px solid var(--color-border);

  border-radius: 0;
}

/* ========================================
   CART COUNT
   ======================================== */

.hargx-header__cart-count {
  position: absolute;

  top: -9px;
  right: -10px;

  min-width: 17px;
  height: 17px;

  padding: 0 4px;

  display: flex;
  align-items: center;
  justify-content: center;

  background: var(--color-primary);
  color: var(--color-white);

  border-radius: 50%;

  font-size: 9px;
  line-height: 1;
  font-weight: 700;
}

/* ========================================
   MOBILE MENU BUTTON
   ======================================== */

.hargx-header__mobile-toggle {
  display: none;

  width: 24px;
  height: 24px;

  padding: 0;

  border: 0;
  background: transparent;

  flex-direction: column;
  justify-content: center;

  gap: 5px;

  cursor: pointer;
}

.hargx-header__mobile-toggle span {
  display: block;

  width: 20px;
  height: 1.5px;

  background: currentColor;

  transition:
    transform 0.2s ease,
    opacity 0.2s ease;
}

/* ========================================
   MOBILE MENU
   ======================================== */

.hargx-mobile-menu {
  position: fixed;

  inset: 0;

  visibility: hidden;
  pointer-events: none;

  z-index: 200;
}

.hargx-mobile-menu.is-open {
  visibility: visible;
  pointer-events: auto;
}

.hargx-mobile-menu__overlay {
  position: absolute;

  inset: 0;

  background: rgba(0, 0, 0, 0.35);

  opacity: 0;

  transition: opacity 0.25s ease;
}

.hargx-mobile-menu.is-open .hargx-mobile-menu__overlay {
  opacity: 1;
}

.hargx-mobile-menu__drawer {
  position: absolute;

  top: 0;
  left: 0;

  width: min(88vw, 380px);
  height: 100%;

  overflow-y: auto;

  background: var(--color-white);

  transform: translateX(-100%);

  transition: transform 0.3s ease;
}

.hargx-mobile-menu.is-open .hargx-mobile-menu__drawer {
  transform: translateX(0);
}

/* ========================================
   MOBILE MENU HEADER
   ======================================== */

.hargx-mobile-menu__header {
  min-height: 64px;

  padding: 0 20px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  border-bottom: 1px solid var(--color-border);
}

.hargx-mobile-menu__title {
  font-family: var(--font-heading--family);

  font-size: 18px;
  font-weight: 600;
}

.hargx-mobile-menu__close {
  position: relative;

  width: 32px;
  height: 32px;

  padding: 0;

  border: 0;
  background: transparent;

  cursor: pointer;
}

.hargx-mobile-menu__close span {
  position: absolute;

  top: 50%;
  left: 50%;

  width: 20px;
  height: 1.5px;

  background: currentColor;
}

.hargx-mobile-menu__close span:first-child {
  transform: translate(-50%, -50%) rotate(45deg);
}

.hargx-mobile-menu__close span:last-child {
  transform: translate(-50%, -50%) rotate(-45deg);
}

/* ========================================
   MOBILE NAVIGATION
   ======================================== */

.hargx-mobile-menu__nav {
  padding: 10px 20px 30px;
}

.hargx-mobile-menu__item {
  border-bottom: 1px solid var(--color-border);
}

.hargx-mobile-menu__link {
  display: flex;
  align-items: center;
  justify-content: space-between;

  width: 100%;

  padding: 17px 0;

  color: var(--color-black);
  text-decoration: none;

  font-size: 16px;
  font-weight: 500;

  background: transparent;
  border: 0;

  text-align: left;

  cursor: pointer;
}

.hargx-mobile-menu__link:hover,
.hargx-mobile-menu__link:focus {
  color: var(--color-primary);
}

/* ========================================
   MOBILE SUBMENU
   ======================================== */

.hargx-mobile-menu__submenu {
  display: none;

  padding: 0 0 10px 14px;
}

.hargx-mobile-menu__submenu.is-open {
  display: block;
}

.hargx-mobile-menu__submenu-link {
  display: flex;
  align-items: center;
  justify-content: space-between;

  width: 100%;

  padding: 12px 0;

  color: var(--color-black);
  text-decoration: none;

  font-size: 14px;

  background: transparent;
  border: 0;

  text-align: left;

  cursor: pointer;
}

.hargx-mobile-menu__submenu-link--parent {
  font-weight: 600;
}

.hargx-mobile-menu__submenu-link:hover,
.hargx-mobile-menu__submenu-link:focus {
  color: var(--color-primary);
}

.hargx-mobile-menu__arrow {
  font-size: 18px;
  line-height: 1;

  transition: transform 0.2s ease;
}

.hargx-mobile-menu__toggle-submenu.is-open .hargx-mobile-menu__arrow {
  transform: rotate(45deg);
}

/* ========================================
   MOBILE THIRD LEVEL
   ======================================== */

.hargx-mobile-menu__subsubmenu {
  display: none;

  padding-left: 14px;
}

.hargx-mobile-menu__subsubmenu.is-open {
  display: block;
}

.hargx-mobile-menu__subsubmenu-link {
  display: block;

  padding: 9px 0;

  color: var(--color-black);
  text-decoration: none;

  font-size: 14px;
}

.hargx-mobile-menu__subsubmenu-link:hover,
.hargx-mobile-menu__subsubmenu-link:focus {
  color: var(--color-primary);
}

/* ========================================
   MOBILE ACCOUNT
   ======================================== */

.hargx-mobile-menu__account {
  margin: 0 20px 30px;

  padding-top: 20px;

  border-top: 1px solid var(--color-border);

  display: flex;
  flex-direction: column;
}

.hargx-mobile-menu__account-title {
  margin-bottom: 8px;

  font-family: var(--font-heading--family);

  font-size: 15px;
  font-weight: 700;
}

.hargx-mobile-menu__account-link {
  display: block;

  padding: 10px 0;

  color: var(--color-black);
  text-decoration: none;

  font-size: 14px;
}

.hargx-mobile-menu__account-link:hover,
.hargx-mobile-menu__account-link:focus {
  color: var(--color-primary);
}

/* ========================================
   CLASSIC LAYOUT
   ======================================== */

.hargx-header--classic .hargx-header__logo {
  order: 1;
}

.hargx-header--classic .hargx-header__nav {
  order: 2;
}

.hargx-header--classic .hargx-header__actions {
  order: 3;
}

/* ========================================
   CENTER LOGO
   ======================================== */

.hargx-header--center-logo .hargx-header__inner {
  position: relative;
}

.hargx-header--center-logo .hargx-header__logo {
  position: absolute;

  left: 50%;

  transform: translateX(-50%);
}

.hargx-header--center-logo .hargx-header__nav {
  justify-content: flex-start;
}

.hargx-header--center-logo .hargx-header__actions {
  margin-left: auto;
}

/* ========================================
   MINIMAL
   ======================================== */

.hargx-header--minimal .hargx-header__nav {
  display: none;
}

.hargx-header--minimal .hargx-header__inner {
  justify-content: space-between;
}

.hargx-header--minimal .hargx-header__logo {
  position: absolute;

  left: 50%;

  transform: translateX(-50%);
}

.hargx-header--minimal .hargx-header__mobile-toggle {
  display: flex;
}

/* ========================================
   MEGA MENU
   ======================================== */

.hargx-header--mega-menu .hargx-header__nav {
  gap: 30px;
}

/* ========================================
   MOBILE
   ======================================== */

@media screen and (max-width: 749px) {

  .hargx-header__inner {
    min-height: 64px;

    gap: 16px;
  }

  .hargx-header__mobile-toggle {
    display: flex;

    flex: 0 0 auto;
  }

  .hargx-header__nav {
    display: none;
  }

  .hargx-header__logo {
    position: absolute;

    left: 50%;

    transform: translateX(-50%);
  }

  .hargx-header__actions {
    margin-left: auto;

    gap: 14px;
  }

  .hargx-header__action svg {
    width: 20px;
    height: 20px;
  }

  .hargx-header__account {
    display: none;
  }

  .hargx-header__action:nth-child(2) {
    display: none;
  }

}

/* ========================================
   LARGE DESKTOP
   ======================================== */

@media screen and (min-width: 1400px) {

  .hargx-header__mega-inner {
    padding-top: 42px;
    padding-bottom: 46px;
  }

  .hargx-header__mega-inner {
    gap: 44px;
  }

}

{% endstylesheet %}

{% javascript %}

(function () {
  'use strict';

  const header = document.querySelector('.hargx-header');

  if (!header) return;

  /* ========================================
     MOBILE MENU
     ======================================== */

  const mobileToggle = header.querySelector(
    '.hargx-header__mobile-toggle'
  );

  const mobileMenu = header.querySelector(
    '.hargx-mobile-menu'
  );

  const mobileClose = header.querySelector(
    '.hargx-mobile-menu__close'
  );

  const mobileOverlay = header.querySelector(
    '.hargx-mobile-menu__overlay'
  );

  if (mobileToggle && mobileMenu) {

    const openMenu = function () {

      mobileMenu.classList.add('is-open');

      mobileMenu.setAttribute(
        'aria-hidden',
        'false'
      );

      mobileToggle.setAttribute(
        'aria-expanded',
        'true'
      );

      document.documentElement.style.overflow = 'hidden';

    };

    const closeMenu = function () {

      mobileMenu.classList.remove('is-open');

      mobileMenu.setAttribute(
        'aria-hidden',
        'true'
      );

      mobileToggle.setAttribute(
        'aria-expanded',
        'false'
      );

      document.documentElement.style.overflow = '';

    };

    mobileToggle.addEventListener(
      'click',
      openMenu
    );

    if (mobileClose) {

      mobileClose.addEventListener(
        'click',
        closeMenu
      );

    }

    if (mobileOverlay) {

      mobileOverlay.addEventListener(
        'click',
        closeMenu
      );

    }

    const submenuToggles = header.querySelectorAll(
      '.hargx-mobile-menu__toggle-submenu'
    );

    submenuToggles.forEach(function (toggle) {

      toggle.addEventListener(
        'click',
        function () {

          const submenu =
            toggle.nextElementSibling;

          if (!submenu) return;

          const isOpen =
            toggle.classList.contains('is-open');

          toggle.classList.toggle(
            'is-open',
            !isOpen
          );

          toggle.setAttribute(
            'aria-expanded',
            String(!isOpen)
          );

          submenu.classList.toggle(
            'is-open',
            !isOpen
          );

        }
      );

    });

    document.addEventListener(
      'keydown',
      function (event) {

        if (event.key === 'Escape') {

          closeMenu();

        }

      }
    );

  }

  /* ========================================
     ACCOUNT DROPDOWN
     ======================================== */

  const account = header.querySelector(
    '.hargx-header__account'
  );

  const accountButton = header.querySelector(
    '.hargx-header__account-button'
  );

  if (account && accountButton) {

    accountButton.addEventListener(
      'click',
      function (event) {

        event.preventDefault();

        const isOpen =
          account.classList.contains('is-open');

        account.classList.toggle(
          'is-open',
          !isOpen
        );

        accountButton.setAttribute(
          'aria-expanded',
          String(!isOpen)
        );

      }
    );

    document.addEventListener(
      'click',
      function (event) {

        if (!account.contains(event.target)) {

          account.classList.remove(
            'is-open'
          );

          accountButton.setAttribute(
            'aria-expanded',
            'false'
          );

        }

      }
    );

    document.addEventListener(
      'keydown',
      function (event) {

        if (event.key === 'Escape') {

          account.classList.remove(
            'is-open'
          );

          accountButton.setAttribute(
            'aria-expanded',
            'false'
          );

        }

      }
    );

  }

})();

{% endjavascript %}

