{% comment %}
  HARGX Collection Filters
  Desktop filter sidebar using Shopify native collection.filters
{% endcomment %}

{%- assign active_filter_count = 0 -%}

{%- for filter in collection.filters -%}
  {%- assign active_filter_count = active_filter_count | plus: filter.active_values.size -%}

  {%- if filter.type == 'price_range' -%}
    {%- if filter.min_value.value != blank or filter.max_value.value != blank -%}
      {%- assign active_filter_count = active_filter_count | plus: 1 -%}
    {%- endif -%}
  {%- endif -%}
{%- endfor -%}

<section
  class="hargx-collection-filters"
  id="HargxCollectionFilters-{{ section.id }}"
  style="
    --hargx-filter-text: {{ section.settings.text_color }};
    --hargx-filter-accent: {{ section.settings.accent_color }};
    --hargx-filter-border: {{ section.settings.border_color }};
    --hargx-filter-top: {{ section.settings.padding_top }}px;
    --hargx-filter-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="hargx-collection-filters__container page-width">

    <div class="hargx-collection-filters__layout">

      <!-- Sidebar -->

      <aside class="hargx-collection-filters__sidebar">

        <div class="hargx-collection-filters__heading">

          <div>
            <h2>
              {{ section.settings.heading }}
            </h2>

            {% if active_filter_count > 0 %}
              <span class="hargx-collection-filters__active">
                {{ active_filter_count }} active
              </span>
            {% endif %}
          </div>

          {% if active_filter_count > 0 %}
            <a
              href="{{ collection.url }}"
              class="hargx-collection-filters__clear"
            >
              Clear all
            </a>
          {% endif %}

        </div>

        {% if collection.filters.size > 0 %}

          <form
            class="hargx-desktop-filter-form"
            id="HargxDesktopFilterForm-{{ section.id }}"
          >

            {% for filter in collection.filters %}

              <details
                class="hargx-desktop-filter"
                {% if filter.active_values.size > 0 %}
                  open
                {% endif %}
              >

                <summary class="hargx-desktop-filter__summary">

                  <span>
                    {{ filter.label }}
                  </span>

                  <span class="hargx-desktop-filter__summary-right">

                    {% if filter.active_values.size > 0 %}
                      <span class="hargx-desktop-filter__count">
                        {{ filter.active_values.size }}
                      </span>
                    {% endif %}

                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      aria-hidden="true"
                    >
                      <path
                        d="M6 9L12 15L18 9"
                        stroke="currentColor"
                        stroke-width="1.7"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>

                  </span>

                </summary>

                <div class="hargx-desktop-filter__content">

                  {% case filter.type %}

                    {% when 'boolean' %}

                      <label class="hargx-desktop-checkbox">

                        <input
                          type="checkbox"
                          name="{{ filter.param_name }}"
                          value="{{ filter.true_value.value }}"
                          {% if filter.true_value.active %}
                            checked
                          {% endif %}
                          {% if filter.true_value.count == 0 and filter.true_value.active == false %}
                            disabled
                          {% endif %}
                        >

                        <span class="hargx-desktop-checkbox__box"></span>

                        <span class="hargx-desktop-checkbox__label">
                          {{ filter.true_value.label }}
                        </span>

                        <span class="hargx-desktop-checkbox__number">
                          {{ filter.true_value.count }}
                        </span>

                      </label>

                    {% when 'list' %}

                      <div class="hargx-desktop-options">

                        {% for value in filter.values %}

                          <label
                            class="hargx-desktop-checkbox{% if value.count == 0 and value.active == false %} is-disabled{% endif %}"
                          >

                            <input
                              type="checkbox"
                              name="{{ value.param_name }}"
                              value="{{ value.value }}"
                              {% if value.active %}
                                checked
                              {% endif %}
                              {% if value.count == 0 and value.active == false %}
                                disabled
                              {% endif %}
                            >

                            <span class="hargx-desktop-checkbox__box"></span>

                            <span class="hargx-desktop-checkbox__label">
                              {{ value.label }}
                            </span>

                            <span class="hargx-desktop-checkbox__number">
                              {{ value.count }}
                            </span>

                          </label>

                        {% endfor %}

                      </div>

                    {% when 'price_range' %}

                      <div class="hargx-desktop-price">

                        <div class="hargx-desktop-price__fields">

                          <div class="hargx-desktop-price__field">

                            <span>
                              {{ cart.currency.symbol }}
                            </span>

                            <input
                              type="number"
                              name="{{ filter.min_value.param_name }}"
                              value="{{ filter.min_value.value | money_without_currency | replace: ',', '' }}"
                              placeholder="0"
                              min="0"
                              inputmode="decimal"
                            >

                          </div>

                          <span class="hargx-desktop-price__dash">
                            –
                          </span>

                          <div class="hargx-desktop-price__field">

                            <span>
                              {{ cart.currency.symbol }}
                            </span>

                            <input
                              type="number"
                              name="{{ filter.max_value.param_name }}"
                              value="{{ filter.max_value.value | money_without_currency | replace: ',', '' }}"
                              placeholder="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                              min="0"
                              inputmode="decimal"
                            >

                          </div>

                        </div>

                      </div>

                  {% endcase %}

                </div>

              </details>

            {% endfor %}

            <button
              type="submit"
              class="hargx-desktop-filter__apply"
            >
              {{ section.settings.apply_label }}
            </button>

          </form>

        {% else %}

          <div class="hargx-desktop-filter__empty">
            <p>
              {{ section.settings.empty_text }}
            </p>
          </div>

        {% endif %}

      </aside>

      <!-- Spacer for product grid -->

      <div class="hargx-collection-filters__content">
        {{ section.settings.content_note }}
      </div>

    </div>

  </div>
</section>

<script>
  (function () {
    const form = document.getElementById(
      'HargxDesktopFilterForm-{{ section.id }}'
    );

    if (!form) return;

    form.addEventListener('submit', function (event) {
      event.preventDefault();

      const formData = new FormData(form);
      const params = new URLSearchParams();

      formData.forEach(function (value, key) {
        if (value !== '') {
          params.append(key, value);
        }
      });

      const url = new URL(window.location.href);

      url.search = params.toString();

      window.location.href = url.toString();
    });
  })();
</script>

<style>
  .hargx-collection-filters {
    color: var(--hargx-filter-text);
    padding-top: var(--hargx-filter-top);
    padding-bottom: var(--hargx-filter-bottom);
  }

  .hargx-collection-filters__layout {
    display: grid;
    grid-template-columns: 240px minmax(0, 1fr);
    gap: 48px;
  }

  .hargx-collection-filters__sidebar {
    position: sticky;
    top: 30px;
    align-self: start;
  }

  .hargx-collection-filters__heading {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 15px;
    margin-bottom: 8px;
    padding-bottom: 20px;
    border-bottom: 1px solid var(--hargx-filter-border);
  }

  .hargx-collection-filters__heading h2 {
    margin: 0;
    font-size: 17px;
    line-height: 1.2;
  }

  .hargx-collection-filters__active {
    display: block;
    margin-top: 5px;
    color: var(--hargx-filter-accent);
    font-size: 11px;
  }

  .hargx-collection-filters__clear {
    color: #666;
    font-size: 11px;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  /* Filter group */

  .hargx-desktop-filter {
    border-bottom: 1px solid var(--hargx-filter-border);
  }

  .hargx-desktop-filter__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
    padding: 18px 0;
    list-style: none;
    cursor: pointer;
    font-size: 13px;
    font-weight: 600;
  }

  .hargx-desktop-filter__summary::-webkit-details-marker {
    display: none;
  }

  .hargx-desktop-filter__summary-right {
    display: flex;
    align-items: center;
    gap: 7px;
  }

  .hargx-desktop-filter__summary-right svg {
    transition: transform 0.25s ease;
  }

  .hargx-desktop-filter[open]
    .hargx-desktop-filter__summary-right
    svg {
    transform: rotate(180deg);
  }

  .hargx-desktop-filter__count {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 19px;
    height: 19px;
    padding: 0 5px;
    border-radius: 50%;
    background: var(--hargx-filter-accent);
    color: #fff;
    font-size: 9px;
  }

  .hargx-desktop-filter__content {
    padding: 0 0 18px;
  }

  .hargx-desktop-options {
    display: grid;
    gap: 11px;
  }

  /* Checkbox */

  .hargx-desktop-checkbox {
    position: relative;
    display: grid;
    grid-template-columns: 18px minmax(0, 1fr) auto;
    align-items: center;
    gap: 9px;
    cursor: pointer;
    font-size: 12px;
    line-height: 1.4;
  }

  .hargx-desktop-checkbox input {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .hargx-desktop-checkbox__box {
    position: relative;
    display: block;
    width: 17px;
    height: 17px;
    border: 1px solid #bcb8b0;
    border-radius: 3px;
  }

  .hargx-desktop-checkbox input:checked
    + .hargx-desktop-checkbox__box {
    border-color: var(--hargx-filter-accent);
    background: var(--hargx-filter-accent);
  }

  .hargx-desktop-checkbox input:checked
    + .hargx-desktop-checkbox__box::after {
    position: absolute;
    left: 5px;
    top: 2px;
    width: 4px;
    height: 8px;
    border: solid #fff;
    border-width: 0 1.5px 1.5px 0;
    content: "";
    transform: rotate(45deg);
  }

  .hargx-desktop-checkbox__number {
    color: #999;
    font-size: 10px;
  }

  .hargx-desktop-checkbox.is-disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  /* Price */

  .hargx-desktop-price__fields {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 7px;
  }

  .hargx-desktop-price__field {
    position: relative;
  }

  .hargx-desktop-price__field > span {
    position: absolute;
    left: 9px;
    top: 50%;
    color: #777;
    font-size: 10px;
    transform: translateY(-50%);
  }

  .hargx-desktop-price__field input {
    width: 100%;
    min-height: 38px;
    padding: 8px 8px 8px 21px;
    border: 1px solid #d9d5cd;
    border-radius: 6px;
    background: #fff;
    color: #000;
    font: inherit;
    font-size: 11px;
  }

  .hargx-desktop-price__dash {
    color: #999;
  }

  /* Apply */

  .hargx-desktop-filter__apply {
    width: 100%;
    min-height: 44px;
    margin-top: 20px;
    border: 0;
    border-radius: 7px;
    background: #000;
    color: #fff;
    font: inherit;
    font-size: 12px;
    font-weight: 600;
    cursor: pointer;
    transition:
      background 0.25s ease,
      transform 0.25s ease;
  }

  .hargx-desktop-filter__apply:hover {
    background: var(--hargx-filter-accent);
    transform: translateY(-1px);
  }

  .hargx-desktop-filter__empty {
    padding-top: 20px;
    color: #777;
    font-size: 12px;
    line-height: 1.5;
  }

  .hargx-collection-filters__content {
    min-width: 0;
  }

  /*
    This section is only the desktop sidebar.
    Product grid stays in the HARGX Collection Grid section.
  */

  @media screen and (max-width: 989px) {
    .hargx-collection-filters {
      display: none;
    }
  }
</style>

{% schema %}
{
  "name": "HARGX Collection Filters",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Filters"
    },
    {
      "type": "text",
      "id": "apply_label",
      "label": "Apply button",
      "default": "Apply filters"
    },
    {
      "type": "textarea",
      "id": "empty_text",
      "label": "Empty filter text",
      "default": "No filters are available for this collection."
    },
    {
      "type": "textarea",
      "id": "content_note",
      "label": "Desktop content note",
      "default": ""
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#FE7442"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border",
      "default": "#E8E5DF"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "HARGX Collection Filters"
    }
  ]
}
{% endschema %}